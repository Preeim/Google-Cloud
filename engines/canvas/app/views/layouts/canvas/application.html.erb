<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Közösségi Rajzvászon | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <style>
    :root {
      --bg-canvas: #0a0f1d;
      --bg-surface: #11192e;
      --bg-elevated: #1a243b;
      --border-subtle: #23304d;
      --border-hover: #3b4b73;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --admin-accent: #a855f7;
      --admin-accent-hover: #9333ea;
      --success: #10b981;
      --danger: #f43f5e;
      --warning: #f59e0b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    body { background-color: var(--bg-canvas); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; }

    /* Rajzvászon Fejléc */
    header.canvas-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 10px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(8px);
    }
    .canvas-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; color: var(--text-main); text-decoration: none; }
    .badge-live { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: var(--success); font-size: 0.72rem; font-weight: 700; padding: 2px 7px; border-radius: 6px; }
    .badge-frozen { background: rgba(245, 158, 11, 0.2); border: 1px solid var(--warning); color: var(--warning); font-size: 0.72rem; font-weight: 700; padding: 2px 7px; border-radius: 6px; }
    .badge-admin { background: rgba(168, 85, 247, 0.2); border: 1px solid var(--admin-accent); color: var(--admin-accent); font-size: 0.72rem; font-weight: 700; padding: 2px 7px; border-radius: 6px; }

    .btn { padding: 7px 14px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: none; font-size: 0.86rem; transition: all 0.2s; }
    .btn-primary { background: var(--accent); color: #0a0f1d; }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-secondary { background: var(--bg-elevated); color: var(--text-main); border: 1px solid var(--border-subtle); }
    .btn-secondary:hover { border-color: var(--border-hover); background: #222f4c; }
    .btn-admin { background: rgba(168, 85, 247, 0.15); border: 1px solid var(--admin-accent); color: var(--admin-accent); }
    .btn-admin:hover { background: var(--admin-accent); color: white; }
    .btn-danger { background: rgba(244, 63, 94, 0.18); border: 1px solid var(--danger); color: #fb7185; }
    .btn-danger:hover { background: var(--danger); color: white; }

    .flash-container { max-width: 1400px; margin: 12px auto 0; padding: 0 16px; width: 100%; }
    .flash-notice { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 10px 16px; border-radius: 8px; margin-bottom: 8px; font-size: 0.9rem; }
    .flash-alert { background: rgba(244, 63, 94, 0.15); border: 1px solid var(--danger); color: #fb7185; padding: 10px 16px; border-radius: 8px; margin-bottom: 8px; font-size: 0.9rem; }

    .canvas-layout-container { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 1600px; margin: 0 auto; padding: 16px; }

    @media (max-width: 768px) {
      header.canvas-header { padding: 10px 14px; }
      .canvas-layout-container { padding: 8px; }
    }
  </style>
</head>
<body>
  <header class="canvas-header">
    <div style="display: flex; align-items: center; gap: 12px;">
      <a href="/canvas" class="canvas-brand">
        <span style="font-size: 1.35rem;">🎨</span>
        <span>Közösségi Rajzvászon</span>
      </a>
      <span class="badge-live" id="socket-status-badge">● Csatlakozva</span>
      <span class="badge-frozen" id="frozen-status-badge" style="display: none;">🔒 Zárolva (Csak nézők)</span>
    </div>

    <div style="display: flex; align-items: center; gap: 12px;">
      <% if logged_in? %>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; color: var(--text-muted);">
          <span style="width: 26px; height: 26px; border-radius: 50%; background: <%= current_user.custom_avatar_color rescue '#38bdf8' %>; color: #0a0f1d; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.75rem;">
            <%= current_user.avatar_initials rescue 'U' %>
          </span>
          <span style="color: var(--text-main); font-weight: 600;"><%= current_user.effective_name rescue current_user.username %></span>
          <% if current_user.admin? %>
            <span class="badge-admin">Admin</span>
          <% end %>
        </div>
      <% else %>
        <span style="font-size: 0.85rem; color: var(--text-muted); background: var(--bg-elevated); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border-subtle);">
          👁️ Néző mód (Jelentkezz be a rajzoláshoz!)
        </span>
        <%= link_to "Belépés", "/login", class: "btn btn-primary", style: "padding: 5px 12px; font-size: 0.82rem;" %>
      <% end %>
      <a href="/" class="btn btn-secondary" style="padding: 5px 12px; font-size: 0.82rem;">← Főoldal</a>
    </div>
  </header>

  <div class="flash-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
  </div>

  <main class="canvas-layout-container">
    <%= yield %>
  </main>
</body>
</html>
