<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %> | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <%= render "shared/design_system" %>
  <style>
    /* Rajzvászon Fejléc */
    header.canvas-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 10px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .canvas-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; color: var(--text-main); text-decoration: none; }
    .badge-frozen { background: var(--warning-subtle); border: 1px solid var(--warning-border); color: var(--warning); font-size: 0.72rem; font-weight: 700; padding: 2px 7px; border-radius: var(--radius-sm); }

    .flash-container { max-width: 1400px; margin: 12px auto 0; padding: 0 16px; width: 100%; }
    .flash-notice { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 10px 16px; border-radius: 8px; margin-bottom: 8px; font-size: 0.9rem; }
    .flash-alert { background: rgba(244, 63, 94, 0.15); border: 1px solid var(--danger); color: #fb7185; padding: 10px 16px; border-radius: 8px; margin-bottom: 8px; font-size: 0.9rem; }

    .canvas-layout-container { flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 1600px; margin: 0 auto; padding: 16px; }

    @media (max-width: 768px) {
      header.canvas-header { padding: 10px 14px; }
      .canvas-layout-container { padding: 8px; }
    }
  </style>
</head>
<body>
  <!-- Modul Státusz Jelvények Átadása a Felső Navbarba -->
  <% content_for :navbar_extra do %>
    <div style="display: flex; align-items: center; gap: 8px;">
      <span class="badge-live" id="socket-status-badge">● Csatlakozva</span>
      <span class="badge-frozen" id="frozen-status-badge" style="display: none;">🔒 Zárolva</span>
      <% unless logged_in? %>
        <span style="font-size: 0.8rem; color: var(--text-muted); background: var(--bg-elevated); padding: 3px 8px; border-radius: 6px; border: 1px solid var(--border-subtle); display: none;">
          👁️ Néző
        </span>
      <% end %>
    </div>
  <% end %>

  <!-- Globális Egységes Felső Navigációs Sáv (Navbar) -->
  <%= render "shared/navbar" %>

  <div class="flash-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
  </div>

  <main class="canvas-layout-container">
    <%= yield %>
  </main>

  <!-- Globális Chat Lebegő Rendszer -->
  <%= render "shared/global_chat" %>
</body>
</html>

