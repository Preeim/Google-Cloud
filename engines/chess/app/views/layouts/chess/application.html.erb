<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %> | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <%= render "shared/design_system" %>
  <style>
    /* Sakk Fejléc */
    header.chess-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .chess-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; color: var(--text-main); text-decoration: none; }
    .badge-gold { background: var(--accent-subtle); border: 1px solid var(--accent-border); color: var(--accent); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: var(--radius-sm); }

    .chess-container { max-width: 1200px; margin: 24px auto; width: 100%; padding: 0 20px; flex: 1; }

    @media (max-width: 640px) {
      header.chess-header {
        padding: 10px 14px;
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
      }
      .chess-header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
      }
      .chess-header-user {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding-top: 6px;
        border-top: 1px solid var(--border-subtle);
        font-size: 0.85rem;
      }
      .chess-container {
        padding: 0 6px;
        margin: 8px auto;
      }
    }
  </style>
</head>
<body>
  <!-- Sakk Speciális Navigáció / Admin Gomb Átadása a Felső Navbarba -->
  <% content_for :navbar_extra do %>
    <div style="display: flex; align-items: center; gap: 8px;">
      <% if admin? %>
        <a href="/chess/admin" class="btn btn-secondary" style="border-color: var(--chess-gold, #fbbf24); color: var(--chess-gold, #fbbf24); padding: 4px 8px; font-size: 0.82rem;">
          ⚙️ Sakk Admin
        </a>
      <% end %>
    </div>
  <% end %>

  <!-- Globális Egységes Felső Navigációs Sáv (Navbar) -->
  <%= render "shared/navbar" %>

  <main class="chess-container">
    <%= yield %>
  </main>

  <!-- Globális Chat Lebegő Rendszer -->
  <%= render "shared/global_chat" %>
</body>
</html>
