<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %> | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <style>
    :root {
      --bg-canvas: #0a0f1d;
      --bg-surface: #11192e;
      --bg-elevated: #1a243b;
      --border-subtle: #23304d;
      --border-hover: #3b4b73;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --admin-accent: #a855f7;
      --admin-accent-hover: #9333ea;
      --chess-gold: #fbbf24;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #f43f5e;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    body { background-color: var(--bg-canvas); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; width: 100%; }

    header.chess-admin-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .brand-group { display: flex; align-items: center; gap: 12px; }
    .chess-brand { font-size: 1.15rem; font-weight: 700; color: var(--text-main); text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .badge-admin { background: rgba(168, 85, 247, 0.2); border: 1px solid var(--admin-accent); color: var(--admin-accent); font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 6px; text-transform: uppercase; }

    .nav-links { display: flex; align-items: center; gap: 16px; }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.15s; }
    .nav-link:hover, .nav-link.active { color: var(--chess-gold); }
    .nav-btn-back { color: var(--accent); padding: 6px 12px; border: 1px solid var(--border-subtle); border-radius: 6px; text-decoration: none; font-size: 0.85rem; font-weight: 500; }
    .nav-btn-back:hover { border-color: var(--accent); }

    .flash-container { max-width: 1300px; margin: 16px auto 0; padding: 0 20px; width: 100%; }
    .flash-notice { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; font-size: 0.92rem; }
    .flash-alert { background: rgba(244, 63, 94, 0.15); border: 1px solid var(--danger); color: #fb7185; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; font-size: 0.92rem; }

    .admin-container { max-width: 1300px; margin: 24px auto; width: 100%; padding: 0 20px; flex: 1; }
    .card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 24px; margin-bottom: 24px; }

    .btn { padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: none; font-size: 0.88rem; transition: all 0.2s; }
    .btn-primary { background: var(--accent); color: #0a0f1d; }
    .btn-primary:hover { background: #0284c7; }
    .btn-admin { background: var(--admin-accent); color: white; }
    .btn-admin:hover { background: var(--admin-accent-hover); }
    .btn-secondary { background: var(--bg-elevated); color: var(--text-main); border: 1px solid var(--border-subtle); }
    .btn-secondary:hover { border-color: var(--border-hover); }
    .btn-danger { background: rgba(244, 63, 94, 0.2); border: 1px solid var(--danger); color: #fb7185; }
    .btn-danger:hover { background: var(--danger); color: white; }

    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th { text-align: left; padding: 12px 16px; background: var(--bg-elevated); color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-subtle); }
    td { padding: 14px 16px; border-bottom: 1px solid var(--border-subtle); font-size: 0.9rem; color: var(--text-main); vertical-align: middle; }
    tr:hover td { background: rgba(255, 255, 255, 0.02); }

    .tag { display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
    .tag-active { background: rgba(16, 185, 129, 0.2); color: var(--success); border: 1px solid var(--success); }
    .tag-pending { background: rgba(251, 191, 36, 0.2); color: var(--chess-gold); border: 1px solid var(--chess-gold); }
    .tag-completed { background: rgba(148, 163, 184, 0.2); color: var(--text-muted); border: 1px solid var(--border-subtle); }
    .tag-aborted { background: rgba(244, 63, 94, 0.2); color: var(--danger); border: 1px solid var(--danger); }

    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500; }
    .form-control { width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem; }
    .form-control:focus { outline: none; border-color: var(--chess-gold); }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 20px; }
    .stat-val { font-size: 2rem; font-weight: 700; color: var(--text-main); margin-top: 6px; }
    .stat-label { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }

    /* Mobil Reszponzív Töréspontok a Sakk Adminban */
    @media (max-width: 768px) {
      header.chess-admin-header {
        padding: 10px 14px;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }
      .nav-links {
        overflow-x: auto;
        white-space: nowrap;
        gap: 8px;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
      }
      .nav-link {
        font-size: 0.85rem;
        padding: 5px 10px;
        background: var(--bg-elevated);
        border-radius: 6px;
        border: 1px solid var(--border-subtle);
        flex-shrink: 0;
      }
      .nav-btn-back {
        font-size: 0.85rem;
        padding: 5px 10px;
        flex-shrink: 0;
      }
      .admin-container {
        padding: 0 12px;
        margin: 12px auto;
      }
      .card {
        padding: 16px;
        border-radius: 10px;
        margin-bottom: 16px;
      }
      .stats-grid {
        grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
        gap: 10px;
      }
      .stat-card {
        padding: 14px;
      }
      .stat-val {
        font-size: 1.5rem;
      }
      .stat-label {
        font-size: 0.75rem;
      }

      /* Stacked Cards for Chess Admin Tables */
      table.responsive-table,
      table.responsive-table thead,
      table.responsive-table tbody,
      table.responsive-table th,
      table.responsive-table td,
      table.responsive-table tr {
        display: block;
      }
      table.responsive-table thead tr {
        position: absolute;
        top: -9999px;
        left: -9999px;
      }
      table.responsive-table tr {
        background: var(--bg-canvas);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        margin-bottom: 14px;
        padding: 8px 14px;
        overflow: hidden;
      }
      table.responsive-table td {
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 9px 0;
        min-height: 38px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
      }
      table.responsive-table td:last-child {
        border-bottom: none;
        padding-top: 10px;
      }
      table.responsive-table td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.76rem;
        text-transform: uppercase;
        flex-shrink: 0;
        max-width: 40%;
        text-align: left;
        white-space: normal;
        word-break: break-word;
        letter-spacing: 0.03em;
      }
      table.responsive-table td > * {
        word-break: break-word;
        overflow-wrap: anywhere;
        min-width: 0;
        text-align: right;
      }
    }
  </style>
</head>
<body>
  <!-- 1. Globális Egységes Felső Navigációs Sáv (Navbar) -->
  <%= render "shared/navbar" %>

  <!-- Kontextuális Sakk Admin Al-menüsor -->
  <nav class="chess-subnav" style="background: var(--bg-surface); border-bottom: 1px solid var(--border-subtle); padding: 8px 20px;">
    <div style="max-width: 1300px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 8px; overflow-x: auto; white-space: nowrap;">
        <a href="<%= admin_root_path %>" class="btn btn-secondary <%= 'btn-primary' if current_page?(admin_root_path) %>" style="padding: 5px 12px; font-size: 0.84rem;">
          📊 Áttekintés
        </a>
        <a href="<%= admin_matches_path %>" class="btn btn-secondary <%= 'btn-primary' if request.path.include?('/matches') %>" style="padding: 5px 12px; font-size: 0.84rem;">
          ⚔️ Meccsek & Adatbázis
        </a>
        <a href="<%= admin_settings_path %>" class="btn btn-secondary <%= 'btn-primary' if request.path.include?('/settings') %>" style="padding: 5px 12px; font-size: 0.84rem;">
          ⚙️ Beállítások
        </a>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <a href="/chess" class="btn btn-secondary" style="padding: 5px 12px; font-size: 0.82rem;">
          ← Sakk Lobbi
        </a>
        <a href="/bank-admin" class="btn btn-admin" style="padding: 5px 12px; font-size: 0.82rem;">
          🛡️ Fő Admin Központ
        </a>
      </div>
    </div>
  </nav>

  <div class="flash-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
  </div>

  <main class="admin-container">
    <%= yield %>
  </main>

  <!-- Globális Chat Lebegő Rendszer -->
  <%= render "shared/global_chat" %>
</body>
</html>
