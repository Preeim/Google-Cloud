<style>
  .setting-toggle-card {
    background: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 12px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    transition: border-color 0.15s;
  }
  .setting-toggle-card:hover {
    border-color: var(--border-hover);
  }
  .setting-checkbox {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 2px;
    cursor: pointer;
    accent-color: var(--admin-accent);
  }
  .setting-label {
    display: block !important;
    font-size: 0.92rem !important;
    font-weight: 600 !important;
    color: var(--text-main) !important;
    margin-bottom: 3px !important;
    cursor: pointer;
    line-height: 1.35;
  }
  .setting-desc {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
    display: block;
  }
  .settings-btn-group {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }
  @media (max-width: 600px) {
    .settings-btn-group {
      flex-direction: column;
      gap: 10px;
    }
    .settings-btn-group .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
      padding: 11px;
    }
  }
</style>

<div style="max-width: 700px; margin: 0 auto; width: 100%;">
  <div style="margin-bottom: 20px;">
    <h1 style="font-size: clamp(1.3rem, 4vw, 1.6rem); font-weight: 700; color: var(--text-main);">Sakk Modul Beállításai</h1>
    <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 4px;">Időkorlátok, játékszabályok és modul-jogosultságok finomhangolása</p>
  </div>

  <div class="card">
    <%= form_with model: @settings, url: admin_settings_path, method: :patch, local: true do |f| %>
      
      <div class="form-group">
        <label for="setting_available_time_controls">Választható Játékidők (Másodpercben, vesszővel elválasztva)</label>
        <%= f.text_field :available_time_controls, class: "form-control" %>
        <small style="color: var(--text-muted); display: block; margin-top: 4px;">
          Például: <code>0,180,300,600,900,1800</code> &rarr; 0 = Végtelen, 180 = 3 perc Blitz, 300 = 5 perc Blitz, 600 = 10 perc Rapid, stb.
        </small>
      </div>

      <div class="form-group">
        <label for="setting_default_time_control">Alapértelmezett Játékidő (másodperc)</label>
        <%= f.number_field :default_time_control, class: "form-control", step: 60 %>
        <small style="color: var(--text-muted); display: block; margin-top: 4px;">
          Az új kihívás indításakor előre kiválasztott időtartam (pl. 600 = 10 perc).
        </small>
      </div>

      <div class="form-group">
        <label for="setting_auto_abort_minutes">Várakozó Szobák Automatikus Elévülési Ideje (perc)</label>
        <%= f.number_field :auto_abort_minutes, class: "form-control", min: 5 %>
        <small style="color: var(--text-muted); display: block; margin-top: 4px;">
          Ennyi idő után az elárvult várakozó kihívások törölhetővé válnak a takarítási művelet során.
        </small>
      </div>

      <div style="border-top: 1px solid var(--border-subtle); margin: 20px 0;"></div>

      <div class="setting-toggle-card">
        <%= f.check_box :single_challenge_limit, id: "single_challenge_limit", class: "setting-checkbox" %>
        <div style="flex: 1; min-width: 0;">
          <label for="single_challenge_limit" class="setting-label">
            Egyidejű nyitott kihívás korlát (1 játékos = max 1 nyitott szoba)
          </label>
          <span class="setting-desc">
            Megakadályozza, hogy egy játékos egyszerre több várakozó vagy aktív játszmát indítson.
          </span>
        </div>
      </div>

      <div class="setting-toggle-card">
        <%= f.check_box :allow_guests, id: "allow_guests", class: "setting-checkbox" %>
        <div style="flex: 1; min-width: 0;">
          <label for="allow_guests" class="setting-label">
            Vendég játékosok engedélyezése a Sakkban
          </label>
          <span class="setting-desc">
            Ha be van kapcsolva, a be nem jelentkezett látogatók is indíthatnak és csatlakozhatnak játékokhoz.
          </span>
        </div>
      </div>

      <div class="setting-toggle-card">
        <%= f.check_box :allow_takeback, id: "allow_takeback", class: "setting-checkbox" %>
        <div style="flex: 1; min-width: 0;">
          <label for="allow_takeback" class="setting-label">
            Visszalépési kérelem engedélyezése (Takeback)
          </label>
          <span class="setting-desc">
            Engedélyezi a játékosoknak, hogy az ellenfél jóváhagyásával visszavonják az elhibázott lépést.
          </span>
        </div>
      </div>

      <div class="setting-toggle-card">
        <%= f.check_box :allow_draw_offer, id: "allow_draw_offer", class: "setting-checkbox" %>
        <div style="flex: 1; min-width: 0;">
          <label for="allow_draw_offer" class="setting-label">
            Döntetlen ajánlat engedélyezése (Draw offer)
          </label>
          <span class="setting-desc">
            Engedélyezi a kölcsönös megegyezésen alapuló döntetlen felajánlását.
          </span>
        </div>
      </div>

      <div class="settings-btn-group">
        <%= f.submit "Beállítások Mentése", class: "btn btn-admin", style: "flex: 1;" %>
        <a href="<%= admin_root_path %>" class="btn btn-secondary">Mégse</a>
      </div>
    <% end %>
  </div>
</div>
