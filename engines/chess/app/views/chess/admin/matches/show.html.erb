<div style="margin-bottom: 20px;">
  <a href="<%= admin_matches_path %>" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">← Vissza a Meccslistához</a>
  <h1 style="font-size: 1.5rem; font-weight: 700; margin-top: 8px;">Játszma Diagnosztika: #<%= @match.uuid %></h1>
</div>

<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="font-size: 1.2rem; font-weight: 700;">Általános Információk</h2>
    <div>
      <span class="tag tag-<%= @match.status %>"><%= @match.status.upcase %></span>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 20px;">
    <div>
      <span style="color: var(--text-muted); font-size: 0.85rem;">Világos Játékos:</span>
      <div style="font-weight: 600; margin-top: 2px;">
        <%= @match.white_player_name %>
        <small style="color: var(--text-muted); display: block;">User ID: <%= @match.white_user_id || 'Nincs (Vendég)' %> / Guest: <%= @match.white_guest_id || '-' %></small>
      </div>
    </div>

    <div>
      <span style="color: var(--text-muted); font-size: 0.85rem;">Sötét Játékos:</span>
      <div style="font-weight: 600; margin-top: 2px;">
        <%= @match.black_player_name %>
        <small style="color: var(--text-muted); display: block;">User ID: <%= @match.black_user_id || 'Nincs (Vendég)' %> / Guest: <%= @match.black_guest_id || '-' %></small>
      </div>
    </div>

    <div>
      <span style="color: var(--text-muted); font-size: 0.85rem;">Győztes / Lezárás:</span>
      <div style="font-weight: 600; margin-top: 2px;">
        <%= @match.winner ? @match.winner.capitalize : 'Nincs nyertes' %>
        <small style="color: var(--text-muted); display: block;">Ok: <%= @match.termination_reason || 'N/A' %></small>
      </div>
    </div>

    <div>
      <span style="color: var(--text-muted); font-size: 0.85rem;">Időbeállítás:</span>
      <div style="font-weight: 600; margin-top: 2px;">
        <%= @match.time_control ? "#{@match.time_control / 60} perc" : 'Végtelen' %>
        <small style="color: var(--text-muted); display: block;">Fehér: <%= @match.white_time_left ? "#{@match.white_time_left / 1000}s" : '-' %> | Fekete: <%= @match.black_time_left ? "#{@match.black_time_left / 1000}s" : '-' %></small>
      </div>
    </div>
  </div>

  <div class="form-group">
    <label>Aktuális FEN Állás (Forsyth–Edwards Notation)</label>
    <input type="text" readonly value="<%= @match.fen %>" class="form-control" style="font-family: monospace; font-size: 0.88rem;">
  </div>

  <div class="form-group">
    <label>Rögzített PGN Jegyzőkönyv (Portable Game Notation)</label>
    <textarea readonly rows="6" class="form-control" style="font-family: monospace; font-size: 0.88rem;"><%= @match.pgn.presence || 'Még nem történt lépés ebben a játszmában.' %></textarea>
  </div>

  <div style="display: flex; gap: 10px; margin-top: 24px;">
    <%= link_to "Megnyitás Szobaként →", match_path(@match.uuid), class: "btn btn-primary", target: "_blank" %>
    <% if @match.active? || @match.pending? %>
      <%= button_to "Meccs Leállítása", abort_admin_match_path(@match.uuid), method: :post, class: "btn btn-danger", data: { turbo_confirm: "Biztosan azonnal leállítod a mérkőzést?" } %>
    <% end %>
    <%= button_to "Meccs Törlése", admin_match_path(@match.uuid), method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Biztosan véglegesen törlöd az adatbázisból?" } %>
  </div>
</div>
