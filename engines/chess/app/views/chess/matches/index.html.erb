<div class="chess-lobby-container">
  <% if @my_open_match %>
    <div class="open-match-banner">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 1.5rem;">⚠️</span>
        <div>
          <strong style="color: #f59e0b;">Már van egy nyitott <%= @my_open_match.pending? ? "várakozó kihívásod" : "aktív játszmád" %>!</strong>
          <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 2px;">
            Szoba azonosító: <code>#<%= @my_open_match.uuid.split('-').first %></code> &bull; Állapot: <strong style="color: #38bdf8;"><%= @my_open_match.status.upcase %></strong>
          </div>
        </div>
      </div>
      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
        <%= link_to "Belépés a Szobába →", match_path(@my_open_match.uuid), class: "btn-join" %>
        <% if @my_open_match.pending? %>
          <%= button_to "Kihívás Visszavonása", cancel_match_path(@my_open_match.uuid), method: :post, class: "btn-cancel", data: { turbo_confirm: "Biztosan vissza szeretnéd vonni ezt a kihívást?" } %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="header">
    <div>
      <h1>Sakk Lobbi</h1>
      <p style="color: #94a3b8; font-size: 0.9rem; margin-top: 4px;">Indíts új kihívást vagy csatlakozz egy várakozó ellenfélhez!</p>
    </div>

    <% if @my_open_match.nil? %>
      <%= form_with url: matches_path, method: :post, local: true, class: "new-match-form" do |f| %>
        <%= f.select :time_control, (@settings ? @settings.time_control_options : [["Végtelen", ""], ["5 perc", 300], ["10 perc", 600]]), {}, class: "time-select" %>
        <%= f.select :side, [["Véletlen oldal", "random"], ["Világos (Fehér)", "white"], ["Sötét (Fekete)", "black"]], {}, class: "side-select" %>
        <%= f.submit "Új Kihívás Indítása", class: "btn-primary" %>
      <% end %>
    <% else %>
      <div style="color: #f59e0b; font-size: 0.88rem; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); padding: 8px 14px; border-radius: 6px;">
        Új kihívás indítása előtt fejezd be vagy vond vissza a meglévő szobádat!
      </div>
    <% end %>
  </div>

  <div class="lobby-grid">
    <div class="column">
      <h2>Várakozó Kihívások</h2>
      <% if @pending_matches.any? %>
        <ul class="match-list">
          <% @pending_matches.each do |match| %>
            <li class="match-card">
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <span class="match-id">Match #<%= match.uuid.split('-').first %></span>
                <span class="match-time" style="font-size: 0.82rem; color: #94a3b8;">
                  ⏱ <%= match.time_control ? "#{match.time_control / 60} perc" : "Végtelen" %>
                  &bull; Oldal: <%= match.white_user_id || match.white_guest_id ? "Világos" : "Sötét" %>
                </span>
              </div>
              <div class="card-actions">
                <% if match.creator?(current_user, session[:guest_id]) %>
                  <%= button_to "Visszavonás", cancel_match_path(match.uuid), method: :post, class: "btn-cancel", data: { turbo_confirm: "Biztosan visszavonod a kihívást?" } %>
                  <%= link_to "Szobám", match_path(match.uuid), class: "btn-view" %>
                <% else %>
                  <%= link_to "Csatlakozás", match_path(match.uuid, join: true), class: "btn-join" %>
                  <%= link_to "Néző", match_path(match.uuid), class: "btn-spectate" %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Jelenleg nincs várakozó játékos.</p>
      <% end %>
    </div>

    <div class="column">
      <h2>Saját Játszmák</h2>
      <% if @user_matches.any? %>
        <ul class="match-list">
          <% @user_matches.each do |match| %>
            <li class="match-card <%= match.status %>">
              <span class="match-players">
                <%= match.white_player_name %> vs <%= match.black_player_name %>
              </span>
              <span class="match-status"><%= match.status %></span>
              <%= link_to match.completed? ? "Visszanézés" : "Folytatás", match_path(match.uuid), class: "btn-view" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">Még nem játszottál egyetlen meccset sem.</p>
      <% end %>
    </div>
  </div>
</div>

<style>
  /* Deep Dark Theme Styles for Lobby */
  .chess-lobby-container {
    color: #e2e8f0;
    padding: 2rem;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    border-bottom: 1px solid #1a243b;
    padding-bottom: 1rem;
  }
  .new-match-form select {
    background: #11192e;
    color: white;
    border: 1px solid #1a243b;
    padding: 0.5rem;
    border-radius: 4px;
    margin-right: 0.5rem;
  }
  .btn-primary {
    background: #38bdf8;
    color: #0a0f1d;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
  }
  .open-match-banner {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .btn-cancel {
    background: rgba(244, 63, 94, 0.2);
    color: #fb7185;
    border: 1px solid rgba(244, 63, 94, 0.4);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-cancel:hover {
    background: #f43f5e;
    color: white;
  }
  .btn-join, .btn-view {
    background: #1a243b;
    color: #38bdf8;
    padding: 0.25rem 0.75rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
  }
  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-spectate {
    background: transparent;
    color: #94a3b8;
    border: 1px solid #1a243b;
    padding: 0.25rem 0.6rem;
    text-decoration: none;
    border-radius: 4px;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .btn-spectate:hover {
    color: #f1f5f9;
    border-color: #38bdf8;
  }
  .lobby-grid {
    display: flex;
    gap: 2rem;
  }
  .column {
    flex: 1;
    background: #11192e;
    padding: 1.5rem;
    border-radius: 8px;
  }
  .match-list {
    list-style: none;
    padding: 0;
  }
  .match-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: #0a0f1d;
    margin-bottom: 0.5rem;
    border-radius: 4px;
    border: 1px solid #1a243b;
  }
  .empty-state {
    color: #94a3b8;
    font-style: italic;
  }
  @media (max-width: 768px) {
    .header {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
    .new-match-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      width: 100%;
    }
    .new-match-form select, .new-match-form input {
      flex: 1;
      min-width: 120px;
    }
    .lobby-grid {
      flex-direction: column;
      gap: 1.5rem;
    }
    .match-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .card-actions {
      width: 100%;
      justify-content: flex-end;
    }
  }
</style>

