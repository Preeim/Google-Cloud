<!-- Load chess libraries via CDN for this implementation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<link rel="stylesheet" href="https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/chessboard-1.0.0.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/chessboard-1.0.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const container = document.querySelector('.chess-game-container');
  if (!container) return;

  const matchId = container.dataset.matchId;
  let isCompleted = container.dataset.status === 'completed';
  const myColor = container.dataset.myColor || 'spectator';
  const isSpectator = myColor === 'spectator';
  const timeControlSeconds = parseInt(container.dataset.timeControl) || null;

  // Initialize Clocks State
  let whiteTimeMs = parseInt(container.dataset.whiteTime);
  let blackTimeMs = parseInt(container.dataset.blackTime);
  if (isNaN(whiteTimeMs)) whiteTimeMs = timeControlSeconds ? timeControlSeconds * 1000 : null;
  if (isNaN(blackTimeMs)) blackTimeMs = timeControlSeconds ? timeControlSeconds * 1000 : null;
  let lastMoveAtTimestamp = container.dataset.lastMoveAt ? parseInt(container.dataset.lastMoveAt) : null;
  let clockInterval = null;

  // Initialize chess logic & state
  var game = new Chess();
  var board = null;

  // Selection & Premove state
  let selectedSquare = null;
  let pendingPremove = null;
  let selectedPremoveSource = null;
  let currentBrowsedPlyIndex = null;

  // SVG Arrows & Highlights state
  let drawnArrows = [];
  let highlightedSquares = new Set();
  let rightClickStartSquare = null;
  let isRightClicking = false;

  // Board Resize state
  let isResizingBoard = false;
  let resizeStartX = 0;
  let resizeStartWidth = 450;
  
  var pgnText = document.getElementById('pgn-content').value;
  if (pgnText && pgnText.trim().length > 0) {
    game.load_pgn(pgnText);
  }

  // Safe ActionCable dispatcher
  function sendMatchAction(action, payload) {
    if (window.matchSubscription && typeof window.matchSubscription.perform === 'function') {
      window.matchSubscription.perform(action, payload || {});
      return true;
    }
    return false;
  }

  // Replay Data
  let replayFens = [];
  let currentReplayStep = 0;

  function buildReplayPositions() {
    replayFens = [];
    var tempGame = new Chess();
    replayFens.push(tempGame.fen());
    var moves = game.history();
    for (var i = 0; i < moves.length; i++) {
      tempGame.move(moves[i]);
      replayFens.push(tempGame.fen());
    }
    currentReplayStep = replayFens.length - 1;
    updateReplayUI();
  }

  function updateReplayUI() {
    if (replayFens.length <= 1) {
      $('#replay-step-info').text("Kezdőállás");
      $('#btn-replay-first, #btn-replay-prev, #btn-replay-next, #btn-replay-last').prop('disabled', true);
      return;
    }

    if (currentReplayStep === 0) {
      $('#replay-step-info').text("Kezdőállás");
    } else {
      $('#replay-step-info').text("Lépés: " + currentReplayStep + " / " + (replayFens.length - 1));
    }

    $('#btn-replay-first, #btn-replay-prev').prop('disabled', currentReplayStep <= 0);
    $('#btn-replay-next, #btn-replay-last').prop('disabled', currentReplayStep >= replayFens.length - 1);
  }

  function goToReplayStep(step) {
    if (step < 0) step = 0;
    if (step >= replayFens.length) step = replayFens.length - 1;
    currentReplayStep = step;
    board.position(replayFens[currentReplayStep], false);
    updateReplayUI();
  }

  $('#btn-replay-first').on('click', function() { goToReplayStep(0); });
  $('#btn-replay-prev').on('click', function() { goToReplayStep(currentReplayStep - 1); });
  $('#btn-replay-next').on('click', function() { goToReplayStep(currentReplayStep + 1); });
  $('#btn-replay-last').on('click', function() { goToReplayStep(replayFens.length - 1); });

  // Keyboard navigation for replay
  $(document).on('keydown', function(e) {
    if ($(e.target).is('input, textarea')) return;
    if (isCompleted || $('#replay-panel').is(':visible')) {
      if (e.key === 'ArrowLeft') {
        goToReplayStep(currentReplayStep - 1);
      } else if (e.key === 'ArrowRight') {
        goToReplayStep(currentReplayStep + 1);
      }
    }
  });

  // Clock Formatter (MM:SS)
  function formatClock(ms) {
    if (ms === null || isNaN(ms)) return "--:--";
    if (ms <= 0) return "00:00";
    var totalSeconds = Math.floor(ms / 1000);
    var minutes = Math.floor(totalSeconds / 60);
    var seconds = totalSeconds % 60;
    return (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
  }

  function renderClocks() {
    if (!timeControlSeconds) {
      $('#opponent-clock').text("∞");
      $('#user-clock').text("∞");
      return;
    }

    let topMs, bottomMs;
    if (isSpectator) {
      topMs = blackTimeMs;
      bottomMs = whiteTimeMs;
    } else if (myColor === 'white') {
      topMs = blackTimeMs;
      bottomMs = whiteTimeMs;
    } else {
      topMs = whiteTimeMs;
      bottomMs = blackTimeMs;
    }

    $('#opponent-clock').text(formatClock(topMs));
    $('#user-clock').text(formatClock(bottomMs));

    if (topMs !== null && topMs <= 10000 && container.dataset.status === 'active') {
      $('#opponent-clock').addClass('low-time');
    } else {
      $('#opponent-clock').removeClass('low-time');
    }

    if (bottomMs !== null && bottomMs <= 10000 && container.dataset.status === 'active') {
      $('#user-clock').addClass('low-time');
    } else {
      $('#user-clock').removeClass('low-time');
    }
  }

  function startClockTicker() {
    if (clockInterval) clearInterval(clockInterval);
    if (!timeControlSeconds || container.dataset.status !== 'active') {
      renderClocks();
      return;
    }

    let lastTick = Date.now();
    clockInterval = setInterval(function() {
      if (container.dataset.status !== 'active') {
        clearInterval(clockInterval);
        return;
      }

      const now = Date.now();
      const delta = now - lastTick;
      lastTick = now;

      const activeTurn = game.turn(); // 'w' or 'b'
      if (activeTurn === 'w') {
        if (whiteTimeMs !== null) {
          whiteTimeMs = Math.max(0, whiteTimeMs - delta);
          if (whiteTimeMs <= 0) {
            sendMatchAction("claim_timeout");
            clearInterval(clockInterval);
          }
        }
      } else {
        if (blackTimeMs !== null) {
          blackTimeMs = Math.max(0, blackTimeMs - delta);
          if (blackTimeMs <= 0) {
            sendMatchAction("claim_timeout");
            clearInterval(clockInterval);
          }
        }
      }

      renderClocks();
    }, 250);
  }

  // Tap-to-move, Selection & Premove Handling

  function removeHighlights() {
    $('#chess-board [data-square]').removeClass('square-selected square-target-hint');
  }

  function highlightSquare(square) {
    removeHighlights();
    $('#chess-board [data-square="' + square + '"]').addClass('square-selected');
    try {
      const legalMoves = game.moves({ square: square, verbose: true });
      legalMoves.forEach(function(m) {
        $('#chess-board [data-square="' + m.to + '"]').addClass('square-target-hint');
      });
    } catch (e) {}
  }

  function reapplyPremoveHighlight() {
    $('#chess-board [data-square]').removeClass('square-premove');
    if (pendingPremove) {
      $('#chess-board [data-square="' + pendingPremove.from + '"]').addClass('square-premove');
      $('#chess-board [data-square="' + pendingPremove.to + '"]').addClass('square-premove');
    }
  }

  function clearPremove() {
    pendingPremove = null;
    selectedPremoveSource = null;
    $('#chess-board [data-square]').removeClass('square-premove');
    reapplyPremoveHighlight();
  }

  function setPremove(from, to) {
    clearPremove();
    pendingPremove = { from: from, to: to, promotion: 'q' };
    $('#chess-board [data-square="' + from + '"]').addClass('square-premove');
    $('#chess-board [data-square="' + to + '"]').addClass('square-premove');
    reapplyPremoveHighlight();
    showChessToast({ title: "Premove beállítva", message: from.toUpperCase() + " ➔ " + to.toUpperCase(), type: "info", duration: 1800, icon: "⚡" });
  }

  function handlePremoveTap(square) {
    const myPiecePrefix = myColor === 'white' ? 'w' : 'b';
    const pieceOnSquare = game.get(square);

    if (selectedPremoveSource) {
      if (selectedPremoveSource === square) {
        clearPremove();
        removeHighlights();
        return;
      }
      if (pieceOnSquare && pieceOnSquare.color === myPiecePrefix) {
        selectedPremoveSource = square;
        highlightSquare(square);
        return;
      }
      setPremove(selectedPremoveSource, square);
      selectedPremoveSource = null;
      removeHighlights();
    } else {
      if (pieceOnSquare && pieceOnSquare.color === myPiecePrefix) {
        selectedPremoveSource = square;
        highlightSquare(square);
      }
    }
  }

  function handleSquareTap(square) {
    if (isCompleted || isSpectator || container.dataset.status !== 'active') return;
    if (game.game_over()) return;

    if (timeControlSeconds) {
      if (myColor === 'white' && whiteTimeMs !== null && whiteTimeMs <= 0) return;
      if (myColor === 'black' && blackTimeMs !== null && blackTimeMs <= 0) return;
    }

    // Ha épp korábbi lépést néz vissza a felhasználó, ugrunk vissza az élő állásra
    if (currentBrowsedPlyIndex !== null) {
      currentBrowsedPlyIndex = null;
      board.position(game.fen(), false);
      updateStructuredPgnList();
    }

    const currentTurn = game.turn();
    const myTurnKey = myColor === 'white' ? 'w' : (myColor === 'black' ? 'b' : null);
    const isMyTurn = currentTurn === myTurnKey;

    if (!isMyTurn) {
      handlePremoveTap(square);
      return;
    }

    const pieceOnSquare = game.get(square);

    if (selectedSquare) {
      if (selectedSquare === square) {
        selectedSquare = null;
        removeHighlights();
        return;
      }

      var move = game.move({
        from: selectedSquare,
        to: square,
        promotion: 'q'
      });

      if (move !== null) {
        selectedSquare = null;
        removeHighlights();
        clearPremove();
        board.position(game.fen());
        sendMatchAction("make_move", { 
          san_move: move.san,
          fen: game.fen(),
          pgn: game.pgn(),
          in_checkmate: (typeof game.in_checkmate === 'function' ? game.in_checkmate() : false),
          in_stalemate: (typeof game.in_stalemate === 'function' ? game.in_stalemate() : false),
          in_draw: (typeof game.in_draw === 'function' ? game.in_draw() : false)
        });
        updateStatus();
        return;
      }

      // Ha másik saját bábura kattintott
      if (pieceOnSquare && pieceOnSquare.color === currentTurn) {
        selectedSquare = square;
        highlightSquare(square);
        return;
      }

      selectedSquare = null;
      removeHighlights();
    } else {
      if (pieceOnSquare && pieceOnSquare.color === currentTurn) {
        selectedSquare = square;
        highlightSquare(square);
      }
    }
  }

  // Kattintás mezőre (tap-to-move és tap-to-premove)
  $('#chess-board').on('click', function(e) {
    if (e.button !== 0 || isRightClicking) return;
    var $target = $(e.target);
    var square = $target.closest('[data-square]').data('square') || getSquareFromEvent(e);
    if (square) {
      handleSquareTap(square);
    }
  });

  // Tábla Drag & Drop Eseménykezelők
  function onDragStart (source, piece, position, orientation) {
    if (isRightClicking) return false;

    removeHighlights();
    selectedSquare = null;

    if (isCompleted || isSpectator) return false;
    if (container.dataset.status !== 'active') return false;
    if (game.game_over()) return false;
    
    // Időellenőrzés
    if (timeControlSeconds) {
      if (myColor === 'white' && whiteTimeMs !== null && whiteTimeMs <= 0) return false;
      if (myColor === 'black' && blackTimeMs !== null && blackTimeMs <= 0) return false;
    }

    // Ha korábbi állást böngészett, visszaállunk az élő állásra
    if (currentBrowsedPlyIndex !== null) {
      currentBrowsedPlyIndex = null;
      board.position(game.fen(), false);
      updateStructuredPgnList();
    }

    const myPiecePrefix = myColor === 'white' ? 'w' : 'b';
    const isMyTurn = game.turn() === myPiecePrefix;

    if (!isMyTurn) {
      // Premove esetén csak saját bábut engedünk felvenni
      if (!piece.startsWith(myPiecePrefix)) {
        return false;
      }
      return true;
    }

    // Saját kör: ellenfél bábuját nem vehetjük fel
    if ((game.turn() === 'w' && piece.search(/^b/) !== -1) ||
        (game.turn() === 'b' && piece.search(/^w/) !== -1)) {
      return false;
    }

    return true;
  }

  function onDrop (source, target) {
    if (isRightClicking) return 'snapback';

    removeHighlights();
    selectedSquare = null;

    if (source === target) return 'snapback';

    const myPiecePrefix = myColor === 'white' ? 'w' : 'b';
    const isMyTurn = game.turn() === myPiecePrefix;

    if (!isMyTurn) {
      // Premove rögzítése és a bábu visszahúzása az eredeti helyére a táblán
      setPremove(source, target);
      return 'snapback';
    }

    var move = game.move({
      from: source,
      to: target,
      promotion: 'q'
    });

    if (move === null) return 'snapback';

    clearPremove();

    sendMatchAction("make_move", { 
      san_move: move.san,
      fen: game.fen(),
      pgn: game.pgn(),
      in_checkmate: (typeof game.in_checkmate === 'function' ? game.in_checkmate() : false),
      in_stalemate: (typeof game.in_stalemate === 'function' ? game.in_stalemate() : false),
      in_draw: (typeof game.in_draw === 'function' ? game.in_draw() : false)
    });
    
    updateStatus();
  }

  function onSnapEnd () {
    board.position(game.fen());
    reapplyPremoveHighlight();
  }

  function updateStatus () {
    var pgnVal = game.pgn() || '';
    $('#pgn-content').val(pgnVal);
    updateTurnIndicator();
    updateStructuredPgnList();
    updatePgnModalContent();
    renderArrowsAndHighlights();
    reapplyPremoveHighlight();
  }

  function updateStructuredPgnList() {
    var $list = $('#pgn-structured-list');
    if (!$list.length) return;

    var history = game.history({ verbose: true });
    if (!history || history.length === 0) {
      $list.html('<div class="pgn-empty-text">Még nem történt lépés.</div>');
      $('#btn-live-state').hide();
      return;
    }

    var html = '<table class="pgn-live-table"><tbody>';
    for (var i = 0; i < history.length; i += 2) {
      var moveNum = Math.floor(i / 2) + 1;
      var whitePly = history[i];
      var blackPly = history[i + 1];

      var isWhiteActive = (currentBrowsedPlyIndex === i) || (currentBrowsedPlyIndex === null && i === history.length - 1);
      var isBlackActive = (currentBrowsedPlyIndex === i + 1) || (currentBrowsedPlyIndex === null && (i + 1) === history.length - 1);

      html += '<tr class="pgn-live-row">';
      html += '<td class="pgn-live-num">' + moveNum + '.</td>';
      html += '<td class="pgn-live-cell pgn-live-white ' + (isWhiteActive ? 'active-ply' : '') + '" data-ply="' + i + '">' + (whitePly ? whitePly.san : '') + '</td>';
      html += '<td class="pgn-live-cell pgn-live-black ' + (isBlackActive ? 'active-ply' : '') + '" data-ply="' + (i + 1) + '">' + (blackPly ? blackPly.san : '') + '</td>';
      html += '</tr>';
    }
    html += '</tbody></table>';
    $list.html(html);

    if (currentBrowsedPlyIndex !== null) {
      $('#btn-live-state').show();
    } else {
      $('#btn-live-state').hide();
      var containerEl = document.getElementById('pgn-structured-container');
      if (containerEl) {
        containerEl.scrollTop = containerEl.scrollHeight;
      }
    }
  }

  $(document).on('click', '.pgn-live-cell', function() {
    var ply = parseInt($(this).data('ply'), 10);
    if (isNaN(ply)) return;
    browseToPly(ply);
  });

  $('#btn-live-state').on('click', function() {
    currentBrowsedPlyIndex = null;
    board.position(game.fen(), false);
    updateStructuredPgnList();
  });

  function browseToPly(plyIndex) {
    currentBrowsedPlyIndex = plyIndex;
    var tempGame = new Chess();
    var history = game.history();

    for (var i = 0; i <= plyIndex && i < history.length; i++) {
      tempGame.move(history[i]);
    }

    board.position(tempGame.fen(), false);
    updateStructuredPgnList();
  }

  function updateTurnIndicator() {
    if (container.dataset.status !== 'active') {
      $('.player-info').removeClass('active-turn');
      return;
    }

    const activeTurn = game.turn(); // 'w' or 'b'
    const isWhiteTurn = activeTurn === 'w';

    if (isSpectator) {
      $('.user-info').toggleClass('active-turn', isWhiteTurn);
      $('.opponent-info').toggleClass('active-turn', !isWhiteTurn);
      $('#status-display').text(isWhiteTurn ? "Világos köre" : "Sötét köre");
    } else if (myColor === 'white') {
      $('.user-info').toggleClass('active-turn', isWhiteTurn);
      $('.opponent-info').toggleClass('active-turn', !isWhiteTurn);
      $('#status-display').text(isWhiteTurn ? "Te lépsz (Világos)" : "Ellenfél gondolkodik (Sötét)...");
    } else {
      $('.user-info').toggleClass('active-turn', !isWhiteTurn);
      $('.opponent-info').toggleClass('active-turn', isWhiteTurn);
      $('#status-display').text(!isWhiteTurn ? "Te lépsz (Sötét)" : "Ellenfél gondolkodik (Világos)...");
    }
  }

  // PGN Jegyzőkönyv és Modal Előállítás
  function generateFullPgnText() {
    var oppLabel = ($('#opponent-role-label').text() || '');
    var whiteName = oppLabel.includes('Világos') ? $('#opponent-name').text().trim() : $('#user-name').text().trim();
    var blackName = oppLabel.includes('Sötét') ? $('#opponent-name').text().trim() : $('#user-name').text().trim();
    if (myColor === 'black') {
      whiteName = $('#opponent-name').text().trim();
      blackName = $('#user-name').text().trim();
    } else if (myColor === 'white') {
      whiteName = $('#user-name').text().trim();
      blackName = $('#opponent-name').text().trim();
    }

    var res = '*';
    if (isCompleted) {
      var winnerVal = container.dataset.winner;
      if (winnerVal === 'white') res = '1-0';
      else if (winnerVal === 'black') res = '0-1';
      else if (winnerVal === 'draw') res = '1/2-1/2';
    }

    var createdDate = container.dataset.date || new Date().toISOString().slice(0, 10).replace(/-/g, '.');
    var tags = [
      '[Event "Bánk\'s Repository Sakk"]',
      '[Site "bankrepo.hu"]',
      '[Date "' + createdDate + '"]',
      '[Round "1"]',
      '[White "' + (whiteName || 'Világos') + '"]',
      '[Black "' + (blackName || 'Sötét') + '"]',
      '[Result "' + res + '"]',
      timeControlSeconds ? '[TimeControl "' + timeControlSeconds + '"]' : '[TimeControl "-"]',
      '[FEN "' + game.fen() + '"]'
    ];

    var pgnMoves = game.pgn() || '';
    var cleanMoves = pgnMoves.replace(/\[.*?\]\s*/g, '').trim();
    return tags.join('\n') + '\n\n' + (cleanMoves.length > 0 ? cleanMoves + ' ' + res : res);
  }

  function updatePgnModalContent() {
    var pgnHistory = game.history({ verbose: true });
    var $tableWrap = $('#pgn-moves-table-wrap');
    var fullPgn = generateFullPgnText();
    $('#pgn-raw-textarea').val(fullPgn);

    if (!$tableWrap.length) return;

    if (!pgnHistory || pgnHistory.length === 0) {
      $tableWrap.html('<div style="color: #64748b; text-align: center; padding: 2.5rem 1rem; font-style: italic;">Még nincsenek rögzített lépések ebben a játszmában.</div>');
      return;
    }

    var html = '<table class="pgn-moves-table"><tbody>';
    for (var i = 0; i < pgnHistory.length; i += 2) {
      var moveNum = Math.floor(i / 2) + 1;
      var whiteMove = pgnHistory[i] ? pgnHistory[i].san : '';
      var blackMove = pgnHistory[i + 1] ? pgnHistory[i + 1].san : '';
      html += '<tr>';
      html += '<td class="pgn-move-num">' + moveNum + '.</td>';
      html += '<td class="pgn-move-white">' + whiteMove + '</td>';
      html += '<td class="pgn-move-black">' + (blackMove || '') + '</td>';
      html += '</tr>';
    }
    html += '</tbody></table>';
    $tableWrap.html(html);
  }

  // Tábla konfiguráció: ha a játékos sötéttel van, automatikusan forduljon meg (Board Flip)
  var targetOrientation = (myColor === 'black') ? 'black' : 'white';

  var config = {
    pieceTheme: 'https://chessboardjs.com/img/chesspieces/wikipedia/{piece}.png',
    draggable: !isCompleted && !isSpectator && (container.dataset.status === 'active'),
    position: game.fen(),
    orientation: targetOrientation,
    onDragStart: onDragStart,
    onDrop: onDrop,
    onSnapEnd: onSnapEnd
  };
  
  board = Chessboard('chess-board', config);
  updateStatus();
  renderClocks();
  if (container.dataset.status === 'active') {
    startClockTicker();
  }

  // Responsive Resize
  $(window).on('resize orientationchange', function() {
    if (board) board.resize();
    renderArrowsAndHighlights();
  });

  // Replay init if already completed
  if (isCompleted) {
    buildReplayPositions();
  }

  // ==========================================
  // SVG Nyilak és Mezőkijelölések Kezelése
  // ==========================================

  function getSquareFromEvent(e) {
    const boardEl = document.getElementById('chess-board');
    if (!boardEl) return null;
    const rect = boardEl.getBoundingClientRect();
    const clientX = e.clientX !== undefined ? e.clientX : (e.originalEvent?.touches?.[0]?.clientX || e.originalEvent?.changedTouches?.[0]?.clientX);
    const clientY = e.clientY !== undefined ? e.clientY : (e.originalEvent?.touches?.[0]?.clientY || e.originalEvent?.changedTouches?.[0]?.clientY);
    if (clientX === undefined || clientY === undefined) return null;

    const x = clientX - rect.left;
    const y = clientY - rect.top;

    if (x < 0 || x > rect.width || y < 0 || y > rect.height) return null;

    const col = Math.floor((x / rect.width) * 8);
    const row = Math.floor((y / rect.height) * 8);

    if (col < 0 || col > 7 || row < 0 || row > 7) return null;

    const orientation = board ? board.orientation() : (myColor === 'black' ? 'black' : 'white');
    if (orientation === 'white') {
      const file = 'abcdefgh'[col];
      const rank = 8 - row;
      return file + rank;
    } else {
      const file = 'abcdefgh'[7 - col];
      const rank = row + 1;
      return file + rank;
    }
  }

  function squareToCoords(square) {
    if (!square || square.length < 2) return null;
    const file = square[0];
    const rank = parseInt(square[1], 10);
    const fileIdx = 'abcdefgh'.indexOf(file);
    if (fileIdx === -1 || isNaN(rank)) return null;

    const orientation = board ? board.orientation() : (myColor === 'black' ? 'black' : 'white');
    let col, row;
    if (orientation === 'white') {
      col = fileIdx;
      row = 8 - rank;
    } else {
      col = 7 - fileIdx;
      row = rank - 1;
    }
    return {
      x: col * 100,
      y: row * 100,
      cx: col * 100 + 50,
      cy: row * 100 + 50
    };
  }

  function renderArrowsAndHighlights() {
    const $hl = $('#svg-highlights-group');
    const $ar = $('#svg-arrows-group');
    $hl.empty();
    $ar.empty();

    highlightedSquares.forEach(function(sq) {
      const coords = squareToCoords(sq);
      if (coords) {
        const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");
        rect.setAttribute("x", coords.x);
        rect.setAttribute("y", coords.y);
        rect.setAttribute("width", "100");
        rect.setAttribute("height", "100");
        rect.setAttribute("fill", "rgba(251, 191, 36, 0.4)");
        rect.setAttribute("rx", "6");
        rect.setAttribute("ry", "6");
        $hl.append(rect);
      }
    });

    drawnArrows.forEach(function(arr) {
      const c1 = squareToCoords(arr.from);
      const c2 = squareToCoords(arr.to);
      if (c1 && c2) {
        renderSingleArrow($ar, c1.cx, c1.cy, c2.cx, c2.cy);
      }
    });
  }

  function renderSingleArrow($container, x1, y1, x2, y2) {
    const angle = Math.atan2(y2 - y1, x2 - x1);
    const endX = x2 - Math.cos(angle) * 26;
    const endY = y2 - Math.sin(angle) * 26;
    const startX = x1 + Math.cos(angle) * 16;
    const startY = y1 + Math.sin(angle) * 16;

    const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
    line.setAttribute("x1", startX);
    line.setAttribute("y1", startY);
    line.setAttribute("x2", endX);
    line.setAttribute("y2", endY);
    line.setAttribute("stroke", "rgba(251, 191, 36, 0.9)");
    line.setAttribute("stroke-width", "16");
    line.setAttribute("stroke-linecap", "round");
    line.setAttribute("marker-end", "url(#arrowhead)");
    $container.append(line);
  }

  function renderPreviewArrow(fromSq, toSq) {
    const $prev = $('#svg-preview-group');
    $prev.empty();
    const c1 = squareToCoords(fromSq);
    const c2 = squareToCoords(toSq);
    if (c1 && c2) {
      renderSingleArrow($prev, c1.cx, c1.cy, c2.cx, c2.cy);
    }
  }

  function clearArrowsAndHighlights() {
    drawnArrows = [];
    highlightedSquares.clear();
    $('#svg-highlights-group').empty();
    $('#svg-arrows-group').empty();
    $('#svg-preview-group').empty();
  }

  // Jobb klikk és nyílrajzolás kezelése a tábla felületén
  const boardContainerEl = document.getElementById('board-relative-container');
  if (boardContainerEl) {
    // Esemény-elfogási (Capture) fázis: megakadályozza, hogy a chessboard.js jobb klikkre bábut kezdjen el húzni
    boardContainerEl.addEventListener('mousedown', function(e) {
      if (e.button === 2) {
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();

        // Kijelölt mező törlése bal klikkes állapotból
        selectedSquare = null;
        removeHighlights();

        if (pendingPremove) {
          clearPremove();
          showChessToast({ title: "Premove törölve", message: "Az előzetes lépés visszavonva.", type: "info", duration: 1500, icon: "↩️" });
        }
        const sq = getSquareFromEvent(e);
        if (sq) {
          isRightClicking = true;
          rightClickStartSquare = sq;
        }
      } else if (e.button === 0) {
        clearArrowsAndHighlights();
      }
    }, true);
  }

  // Globális kontextusmenü letiltás (megakadályozza a "Link másolása" / képmenü megjelenését a sakkfelületen)
  document.addEventListener('contextmenu', function(e) {
    if (isRightClicking ||
        (e.target && (
          e.target.closest('#board-wrapper') ||
          e.target.closest('#board-relative-container') ||
          e.target.closest('#chess-board') ||
          e.target.closest('.piece-417db') ||
          (e.target.tagName === 'IMG' && e.target.getAttribute('data-piece'))
        ))) {
      e.preventDefault();
      e.stopPropagation();
      return false;
    }
  }, true);

  $(window).on('mousemove', function(e) {
    if (!isRightClicking || !rightClickStartSquare) return;
    const currentSq = getSquareFromEvent(e);
    if (currentSq && currentSq !== rightClickStartSquare) {
      renderPreviewArrow(rightClickStartSquare, currentSq);
    } else {
      $('#svg-preview-group').empty();
    }
  });

  window.addEventListener('mouseup', function(e) {
    if (!isRightClicking) return;
    if (e.button === 2) {
      e.preventDefault();
      e.stopPropagation();
      isRightClicking = false;
      const endSquare = getSquareFromEvent(e);
      $('#svg-preview-group').empty();

      if (rightClickStartSquare && endSquare) {
        if (rightClickStartSquare === endSquare) {
          if (highlightedSquares.has(endSquare)) {
            highlightedSquares.delete(endSquare);
          } else {
            highlightedSquares.add(endSquare);
          }
        } else {
          const existingIdx = drawnArrows.findIndex(a => a.from === rightClickStartSquare && a.to === endSquare);
          if (existingIdx !== -1) {
            drawnArrows.splice(existingIdx, 1);
          } else {
            drawnArrows.push({ from: rightClickStartSquare, to: endSquare });
          }
        }
        renderArrowsAndHighlights();
      }
      rightClickStartSquare = null;
    }
  }, true);

  // ==========================================
  // PC Tábla Átméretezés (Board Resize)
  // ==========================================
  function applyBoardSize(size) {
    size = Math.max(320, Math.min(820, size));
    const container = document.querySelector('.chess-game-container');
    if (container) {
      container.style.setProperty('--board-size', size + 'px');
      container.style.setProperty('--game-board-width', (size + 30) + 'px');
    }
    if (board) {
      board.resize();
    }
    renderArrowsAndHighlights();
  }


  $('#board-resizer').on('mousedown touchstart', function(e) {
    e.preventDefault();
    e.stopPropagation();
    isResizingBoard = true;
    resizeStartX = e.type.startsWith('touch') ? e.originalEvent.touches[0].clientX : e.clientX;
    resizeStartWidth = $('#chess-board').width() || 450;
    $('body').css('cursor', 'nwse-resize').css('user-select', 'none');
  });

  $(window).on('mousemove touchmove', function(e) {
    if (!isResizingBoard) return;
    const clientX = e.type.startsWith('touch') ? e.originalEvent.touches[0].clientX : e.clientX;
    const delta = clientX - resizeStartX;
    const newWidth = Math.round(resizeStartWidth + delta);
    applyBoardSize(newWidth);
  });

  $(window).on('mouseup touchend', function(e) {
    if (isResizingBoard) {
      isResizingBoard = false;
      $('body').css('cursor', '').css('user-select', '');
      const finalWidth = $('#chess-board').width();
      if (finalWidth) {
        localStorage.setItem('chess_board_size', finalWidth);
      }
    }
  });

  // Korábban mentett méret betöltése PC nézetben
  if (window.innerWidth > 768) {
    const saved = localStorage.getItem('chess_board_size');
    if (saved) {
      const parsed = parseInt(saved, 10);
      if (!isNaN(parsed) && parsed >= 320 && parsed <= 820) {
        applyBoardSize(parsed);
      }
    }
  }

  // Ensure share link input uses current browser origin
  var shareInput = document.getElementById("share-link-input");
  if (shareInput) {
    shareInput.value = window.location.origin + "<%= match_path(@match.uuid, join: true) %>";
  }

  // PGN Modal Kezelők
  $('#btn-open-pgn-modal').on('click', function() {
    updatePgnModalContent();
    $('#pgn-modal-overlay').css('display', 'flex');
  });

  $('#btn-close-pgn-modal').on('click', function() {
    $('#pgn-modal-overlay').hide();
  });

  $(document).on('keydown', function(e) {
    if (e.key === 'Escape' && $('#pgn-modal-overlay').is(':visible')) {
      $('#pgn-modal-overlay').hide();
    }
  });

  $('#tab-btn-formatted').on('click', function() {
    $('.pgn-tab-btn').removeClass('active');
    $('.pgn-tab-content').removeClass('active');
    $(this).addClass('active');
    $('#pgn-panel-formatted').addClass('active');
  });

  $('#tab-btn-raw').on('click', function() {
    $('.pgn-tab-btn').removeClass('active');
    $('.pgn-tab-content').removeClass('active');
    $(this).addClass('active');
    $('#pgn-panel-raw').addClass('active');
  });

  function copyPgnToClipboard($btn) {
    var fullPgn = generateFullPgnText();
    var originalHtml = $btn ? $btn.html() : null;

    function onCopied() {
      showChessToast({ title: "Sikeres másolás", message: "A teljes PGN jegyzőkönyv a vágólapra másolva!", type: "success", icon: "📋" });
      if ($btn) {
        $btn.html('<span>✓</span> <span>Másolva!</span>').prop('disabled', true);
        setTimeout(function() {
          $btn.html(originalHtml).prop('disabled', false);
        }, 2200);
      }
    }

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(fullPgn).then(onCopied).catch(function() {
        fallbackCopyText(fullPgn, "A teljes PGN jegyzőkönyv a vágólapra másolva!");
      });
    } else {
      fallbackCopyText(fullPgn, "A teljes PGN jegyzőkönyv a vágólapra másolva!");
    }
  }

  $('#btn-copy-pgn, #btn-modal-copy-pgn').on('click', function() {
    copyPgnToClipboard($(this));
  });

  function downloadPgnFile() {
    var fullPgn = generateFullPgnText();
    var blob = new Blob([fullPgn], { type: 'application/x-chess-pgn;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    var filename = 'game-' + matchId.substring(0, 8) + '.pgn';
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    setTimeout(function() {
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
    }, 100);
    showChessToast({ title: "Fájl letöltve", message: filename + " sikeresen letöltve!", type: "success", icon: "💾" });
  }

  $('#btn-quick-download-pgn, #btn-modal-download-pgn').on('click', downloadPgnFile);

  // Copy Invitation Link with clipboard API & execCommand fallback
  $('#btn-copy-link').on('click', function() {
    var copyText = document.getElementById("share-link-input");
    if (!copyText) return;
    copyText.select();
    copyText.setSelectionRange(0, 99999);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(copyText.value).then(function() {
        showChessToast({ title: "Sikeres másolás", message: "Meccs linkje a vágólapra másolva!", type: "success", icon: "🔗" });
      }).catch(function() {
        fallbackCopyText(copyText.value, "Meccs linkje a vágólapra másolva!");
      });
    } else {
      fallbackCopyText(copyText.value, "Meccs linkje a vágólapra másolva!");
    }
  });

  function fallbackCopyText(text, successMsg) {
    var tempInput = document.createElement("textarea");
    tempInput.value = text;
    document.body.appendChild(tempInput);
    tempInput.select();
    try {
      document.execCommand("copy");
      showChessToast({ title: "Sikeres másolás", message: successMsg, type: "success", icon: "📋" });
    } catch (err) {
      showChessToast({ title: "Másolási hiba", message: "Másolás sikertelen, kérlek jelöld ki manuálisan.", type: "warning", icon: "⚠️" });
    }
    document.body.removeChild(tempInput);
  }

  // Chess in-game Toast Notification System
  function showChessToast(options) {
    var title = options.title || "Értesítés";
    var message = options.message || "";
    var type = options.type || "info";
    var duration = options.duration !== undefined ? options.duration : 4000;
    var icon = options.icon;
    if (!icon) {
      if (type === "warning") icon = "⚠️";
      else if (type === "danger") icon = "🛑";
      else if (type === "success") icon = "✅";
      else icon = "ℹ️";
    }

    var $container = $('#chess-toast-container');
    if (!$container.length) return;

    var $toast = $(`
      <div class="chess-toast toast-${type}">
        <div class="chess-toast-icon">${icon}</div>
        <div class="chess-toast-body">
          <div class="chess-toast-title">${title}</div>
          <div class="chess-toast-message">${message}</div>
        </div>
        <button type="button" class="chess-toast-close" title="Bezárás">&times;</button>
      </div>
    `);

    $toast.find('.chess-toast-close').on('click', function() {
      removeToast($toast);
    });

    $container.append($toast);

    var autoDismiss = setTimeout(function() {
      removeToast($toast);
    }, duration);

    function removeToast($el) {
      clearTimeout(autoDismiss);
      $el.addClass('toast-fade-out');
      setTimeout(function() {
        $el.remove();
      }, 300);
    }
  }

  // Chess in-game Modal Dialog
  var modalCountdownTimer = null;
  function showChessModal(options) {
    var title = options.title || "Értesítés";
    var message = options.message || "";
    var subtext = options.subtext || "";
    var icon = options.icon || "⚠️";
    var actionText = options.actionText || "Rendben";
    var actionBtnClass = options.actionBtnClass || "btn-primary";
    var onAction = options.onAction;
    var countdown = options.countdown;

    $('#chess-modal-icon').text(icon);
    $('#chess-modal-title').text(title);
    $('#chess-modal-message').text(message);
    if (subtext) {
      $('#chess-modal-subtext').text(subtext).show();
    } else {
      $('#chess-modal-subtext').hide();
    }

    $('#chess-modal-btn-cancel').hide();

    if (modalCountdownTimer) {
      clearInterval(modalCountdownTimer);
      modalCountdownTimer = null;
    }

    if (countdown && countdown > 0) {
      var remaining = countdown;
      $('#chess-modal-countdown-wrapper').show();
      $('#chess-modal-countdown-text').html(`Automatikus visszatérés: <strong style="color: #38bdf8;">${remaining}</strong> mp`);
      modalCountdownTimer = setInterval(function() {
        remaining--;
        if (remaining <= 0) {
          clearInterval(modalCountdownTimer);
          modalCountdownTimer = null;
          if (onAction) onAction();
        } else {
          $('#chess-modal-countdown-text').html(`Automatikus visszatérés: <strong style="color: #38bdf8;">${remaining}</strong> mp`);
        }
      }, 1000);
    } else {
      $('#chess-modal-countdown-wrapper').hide();
    }

    var $actionBtn = $('#chess-modal-btn-action');
    $actionBtn.attr('class', 'btn ' + actionBtnClass).text(actionText).off('click').on('click', function() {
      if (modalCountdownTimer) {
        clearInterval(modalCountdownTimer);
        modalCountdownTimer = null;
      }
      $('#chess-modal-overlay').hide();
      if (onAction) onAction();
    });

    $('#chess-modal-overlay').css('display', 'flex');
  }

  function showChessConfirm(options) {
    var title = options.title || "Megerősítés";
    var message = options.message || "";
    var subtext = options.subtext || "";
    var icon = options.icon || "❓";
    var confirmText = options.confirmText || "Igen";
    var cancelText = options.cancelText || "Mégse";
    var confirmBtnClass = options.confirmBtnClass || "btn-danger";
    var onConfirm = options.onConfirm;
    var onCancel = options.onCancel;

    $('#chess-modal-icon').text(icon);
    $('#chess-modal-title').text(title);
    $('#chess-modal-message').text(message);
    if (subtext) {
      $('#chess-modal-subtext').text(subtext).show();
    } else {
      $('#chess-modal-subtext').hide();
    }

    if (modalCountdownTimer) {
      clearInterval(modalCountdownTimer);
      modalCountdownTimer = null;
    }
    $('#chess-modal-countdown-wrapper').hide();

    var $cancelBtn = $('#chess-modal-btn-cancel');
    $cancelBtn.text(cancelText).show().off('click').on('click', function() {
      $('#chess-modal-overlay').hide();
      if (onCancel) onCancel();
    });

    var $actionBtn = $('#chess-modal-btn-action');
    $actionBtn.attr('class', 'btn ' + confirmBtnClass).text(confirmText).off('click').on('click', function() {
      $('#chess-modal-overlay').hide();
      if (onConfirm) onConfirm();
    });

    $('#chess-modal-overlay').css('display', 'flex');
  }

  // Prompt helper with auto-dismiss timeout
  var promptTimer = null;

  function hidePrompt() {
    if (promptTimer) {
      clearInterval(promptTimer);
      promptTimer = null;
    }
    $('#prompt-card').slideUp();
  }

  function showPrompt(message, onAccept, onDecline, timeoutSeconds) {
    hidePrompt();
    timeoutSeconds = timeoutSeconds || 20;

    var secondsLeft = timeoutSeconds;
    function updateMsg() {
      $('#prompt-message').html(message + "<br><small style='color: #94a3b8;'>Automatikus elutasítás: <strong style='color: #f59e0b;'>" + secondsLeft + "s</strong></small>");
    }
    updateMsg();
    $('#prompt-card').slideDown();

    promptTimer = setInterval(function() {
      secondsLeft--;
      if (secondsLeft <= 0) {
        hidePrompt();
        if (onDecline) onDecline();
      } else {
        updateMsg();
      }
    }, 1000);
    
    $('#btn-prompt-accept').off('click').on('click', function() {
      hidePrompt();
      if (onAccept) onAccept();
    });

    $('#btn-prompt-decline').off('click').on('click', function() {
      hidePrompt();
      if (onDecline) onDecline();
    });
  }

  // ActionCable Kapcsolat Vendég azonosító átadásával
  var guestId = container.dataset.guestId || '';
  var consumer = window.ActionCable ? window.ActionCable.createConsumer() : ActionCable.createConsumer();
  window.matchSubscription = consumer.subscriptions.create({ 
    channel: "Chess::MatchChannel", 
    match_id: matchId,
    guest_id: guestId 
  }, {
    received: function(data) {
      if (data.action === "move" || data.action === "takeback_accepted") {
        hidePrompt();
        removeHighlights();
        selectedSquare = null;
        resetButtonCooldown('#btn-draw', 'Döntetlen Ajánlat');
        resetButtonCooldown('#btn-takeback', 'Visszalépés Kérése');

        // PGN betöltése és játékállapot újraszámítása
        game.reset();
        if (data.pgn && data.pgn.trim().length > 0) {
          game.load_pgn(data.pgn);
        }

        // Visszalépés esetén a PGN-ből kiszámított pontos FEN-re állítjuk a bábukat (nem ugrik alapállásba!)
        var targetFen = game.fen();
        if (data.fen && data.action === "move") {
          targetFen = data.fen;
        } else if (data.fen && data.action === "takeback_accepted" && data.fen.indexOf("8/8/8/8") === -1) {
          targetFen = data.fen;
        }

        board.position(targetFen, true);
        updateStatus();

        if (data.white_time_left !== undefined) whiteTimeMs = data.white_time_left;
        if (data.black_time_left !== undefined) blackTimeMs = data.black_time_left;
        renderClocks();

        if (data.action === "takeback_accepted") {
          showChessToast({ title: "Visszalépés elfogadva", message: "A játszma sikeresen visszalépett az előző pozícióra.", type: "info", icon: "↩️" });
        }

        if (data.status === "completed") {
          isCompleted = true;
          container.dataset.status = "completed";
          if (clockInterval) clearInterval(clockInterval);
          clearPremove();
        } else {
          // Ha volt beállított premove, és most a mi körünk jön, azonnal végrehajtjuk
          const myPiecePrefix = myColor === 'white' ? 'w' : 'b';
          if (pendingPremove && game.turn() === myPiecePrefix && !isCompleted) {
            const premove = pendingPremove;
            clearPremove();

            const moveResult = game.move({
              from: premove.from,
              to: premove.to,
              promotion: premove.promotion || 'q'
            });

            if (moveResult !== null) {
              board.position(game.fen());
              sendMatchAction("make_move", {
                san_move: moveResult.san,
                fen: game.fen(),
                pgn: game.pgn(),
                in_checkmate: (typeof game.in_checkmate === 'function' ? game.in_checkmate() : false),
                in_stalemate: (typeof game.in_stalemate === 'function' ? game.in_stalemate() : false),
                in_draw: (typeof game.in_draw === 'function' ? game.in_draw() : false)
              });
              updateStatus();
            } else {
              showChessToast({
                title: "Premove törölve",
                message: "A tervezett lépés a megváltozott állásban nem szabályos.",
                type: "warning",
                duration: 2500,
                icon: "⚠️"
              });
            }
          }
        }
      } else if (data.action === "error") {
        showChessToast({ title: "Szabálytalan lépés", message: data.message, type: "danger", icon: "⚠️" });
        game.undo();
        board.position(game.fen());
      } else if (data.action === "takeback_requested") {
        if (isSpectator || data.color === myColor) return;
        showPrompt("Az ellenfél visszalépést kért. Elfogadod?", function() {
          sendMatchAction("answer_takeback", { accepted: true });
        }, function() {
          sendMatchAction("answer_takeback", { accepted: false });
        }, 20);
      } else if (data.action === "takeback_rejected") {
        if (isSpectator || data.color === myColor) return;
        resetButtonCooldown('#btn-takeback', 'Visszalépés Kérése');
        showChessToast({ title: "Visszalépés elutasítva", message: "Az ellenfél elutasította a visszalépési kérést.", type: "warning", icon: "↩️" });
      } else if (data.action === "draw_offered") {
        if (isSpectator || data.color === myColor) return;
        showPrompt("Az ellenfél döntetlent ajánlott fel. Elfogadod?", function() {
          sendMatchAction("accept_draw");
        }, function() {
          sendMatchAction("decline_draw");
        }, 20);
      } else if (data.action === "draw_declined") {
        if (isSpectator || data.color === myColor) return;
        resetButtonCooldown('#btn-draw', 'Döntetlen Ajánlat');
        showChessToast({ title: "Döntetlen elutasítva", message: "Az ellenfél elutasította a döntetlen ajánlatot.", type: "warning", icon: "🤝" });
      } else if (data.action === "challenge_cancelled") {
        showChessModal({
          title: "Kihívás Visszavonva",
          message: "A szoba készítője visszavonta a kihívást.",
          subtext: "A kihívás törlésre került a szerveren. Átirányítás a sakk lobbiba...",
          icon: "♟️❌",
          countdown: 5,
          actionText: "⬅️ Vissza a Sakk Lobbiba",
          onAction: function() {
            window.location.href = "/chess";
          }
        });
      } else if (data.action === "game_over") {
        isCompleted = true;
        container.dataset.status = "completed";
        if (clockInterval) clearInterval(clockInterval);
        hidePrompt();
        clearPremove();
        clearArrowsAndHighlights();

        config.draggable = false;
        board.position(game.fen());

        $('#status-display').text("BEFEJEZŐDÖTT").removeClass('status-active status-pending').addClass('status-completed');
        $('#active-actions-container').hide();
        $('#prompt-card').hide();

        $('#banner-title').text("Játszma véget ért");
        $('#banner-reason').text(data.reason);
        $('#game-over-banner').slideDown();

        $('#replay-panel').slideDown();
        buildReplayPositions();
      } else if (data.action === "match_started") {
        location.reload();
      }
    }
  });

  // Helper for button cooldown
  var buttonIntervals = {};

  function applyButtonCooldown(btnSelector, originalText, seconds) {
    resetButtonCooldown(btnSelector, originalText);
    var $btn = $(btnSelector);
    $btn.prop('disabled', true).addClass('disabled');
    var remaining = seconds;
    $btn.text(originalText + " (" + remaining + "s)");

    buttonIntervals[btnSelector] = setInterval(function() {
      remaining--;
      if (remaining <= 0) {
        resetButtonCooldown(btnSelector, originalText);
      } else {
        $btn.text(originalText + " (" + remaining + "s)");
      }
    }, 1000);
  }

  function resetButtonCooldown(btnSelector, originalText) {
    if (buttonIntervals[btnSelector]) {
      clearInterval(buttonIntervals[btnSelector]);
      delete buttonIntervals[btnSelector];
    }
    var $btn = $(btnSelector);
    $btn.prop('disabled', false).removeClass('disabled').text(originalText);
  }

  // Action buttons
  $('#btn-resign').on('click', function() {
    showChessConfirm({
      title: "Játszma Feladása",
      message: "Biztosan feladod a játszmát?",
      subtext: "A feladással a játszma azonnal véget ér, és az ellenfél nyer.",
      icon: "🏳️",
      confirmText: "Igen, feladom",
      cancelText: "Mégse",
      confirmBtnClass: "btn-danger",
      onConfirm: function() {
        sendMatchAction("resign");
      }
    });
  });

  $('#btn-draw').on('click', function() {
    sendMatchAction("offer_draw");
    showChessToast({ title: "Ajánlat Elküldve", message: "Döntetlen ajánlat elküldve az ellenfélnek.", type: "info", icon: "🤝" });
    applyButtonCooldown('#btn-draw', 'Döntetlen Ajánlat', 20);
  });

  $('#btn-takeback').on('click', function() {
    sendMatchAction("request_takeback");
    showChessToast({ title: "Kérelem Elküldve", message: "Visszalépési kérelem elküldve az ellenfélnek.", type: "info", icon: "↩️" });
    applyButtonCooldown('#btn-takeback', 'Visszalépés Kérése', 20);
  });
});
</script>
