<%
  current_guest = session[:guest_id]

  is_white = (@match.white_user_id.present? && current_user.present? && @match.white_user_id == current_user.id) ||
             (@match.white_guest_id.present? && current_guest.present? && @match.white_guest_id.to_s == current_guest.to_s)

  is_black = (@match.black_user_id.present? && current_user.present? && @match.black_user_id == current_user.id) ||
             (@match.black_guest_id.present? && current_guest.present? && @match.black_guest_id.to_s == current_guest.to_s)

  is_spectator = !is_white && !is_black
  my_color = is_white ? "white" : (is_black ? "black" : "spectator")

  white_open = @match.white_user_id.nil? && @match.white_guest_id.nil?
  black_open = @match.black_user_id.nil? && @match.black_guest_id.nil?
  can_join = @match.pending? && is_spectator && (white_open || black_open)
  is_creator = !is_spectator

  if is_spectator
    top_role_label = "Sötét:"
    top_name = @match.black_player_name
    bottom_role_label = "Világos:"
    bottom_name = @match.white_player_name
  elsif is_white
    top_role_label = "Ellenfél (Sötét):"
    top_name = @match.black_player_name
    bottom_role_label = "Te (Világos):"
    bottom_name = @match.white_player_name
  else
    top_role_label = "Ellenfél (Világos):"
    top_name = @match.white_player_name
    bottom_role_label = "Te (Sötét):"
    bottom_name = @match.black_player_name
  end

  status_badge_text = case @match.status
                      when "pending" then "Várakozás ellenfélre"
                      when "active" then "Játékban"
                      when "completed" then "Befejeződött"
                      when "aborted" then "Megszakítva"
                      else @match.status
                      end

  # Real-time remaining clock deduction for initial page load
  server_now = Time.current
  elapsed_since_last_move = (@match.active? && @match.time_control.present? && @match.last_move_at.present?) ? ((server_now - @match.last_move_at) * 1000).to_i : 0

  turn = @match.current_turn
  white_time_now = @match.white_time_left
  black_time_now = @match.black_time_left
  if @match.active? && @match.time_control.present?
    if turn == "white" && white_time_now.present?
      white_time_now = [white_time_now - elapsed_since_last_move, 0].max
    elsif turn == "black" && black_time_now.present?
      black_time_now = [black_time_now - elapsed_since_last_move, 0].max
    end
  end
%>

<div class="chess-game-container"
     data-match-id="<%= @match.uuid %>"
     data-status="<%= @match.status %>"
     data-time-control="<%= @match.time_control %>"
     data-white-time="<%= white_time_now %>"
     data-black-time="<%= black_time_now %>"
     data-last-move-at="<%= @match.last_move_at ? (@match.last_move_at.to_f * 1000).to_i : '' %>"
     data-my-color="<%= my_color %>">

  <!-- Main Game Layout -->
  <div class="game-layout">
    <!-- Notifications & Game Over Banner -->
    <div id="game-over-banner" class="game-banner <%= @match.completed? ? 'active' : '' %>" style="<%= @match.completed? ? '' : 'display: none;' %>">
      <h3 id="banner-title"><%= @match.completed? ? "Játszma véget ért" : "" %></h3>
      <p id="banner-reason">
        <% if @match.completed? %>
          <% case @match.termination_reason %>
          <% when "checkmate" %>
            Sakk-matt! Nyertes: <%= @match.winner == "white" ? @match.white_player_name : @match.black_player_name %>
          <% when "resign" %>
            Feladás. Nyertes: <%= @match.winner == "white" ? @match.white_player_name : @match.black_player_name %>
          <% when "timeout" %>
            Időtúllépés! Nyertes: <%= @match.winner == "white" ? @match.white_player_name : @match.black_player_name %>
          <% when "draw_agreed" %>
            Döntetlen közös megegyezéssel.
          <% when "stalemate" %>
            Patt! A játszma döntetlen.
          <% else %>
            A játszma lezárult.
          <% end %>
        <% end %>
      </p>
    </div>

    <% if can_join %>
      <div class="join-banner">
        <div>
          <strong>Nyitott kihívás!</strong> Csatlakozz a mérkőzéshez mint 
          <span class="badge-role"><%= white_open ? "Világos" : "Sötét" %></span> játékos!
        </div>
        <%= link_to "Csatlakozás Játékosként", match_path(@match.uuid, join: true), class: "btn btn-primary btn-sm" %>
      </div>
    <% elsif @match.pending? && is_creator %>
      <div class="pending-creator-banner">
        <div style="margin-bottom: 0.5rem;">
          <strong>Várakozás az ellenfélre...</strong> Oszd meg ezt a linket a barátoddal:
        </div>
        <div class="share-link-group">
          <input type="text" id="share-link-input" readonly value="<%= match_url(@match.uuid, join: true) %>" class="share-input">
          <button type="button" id="btn-copy-link" class="btn btn-primary btn-sm">Link Másolása</button>
        </div>
      </div>
    <% end %>

    <!-- Opponent / Top Player Info -->
    <div class="player-info opponent-info">
      <div class="player-name">
        <span class="role-label" id="opponent-role-label"><%= top_role_label %></span>
        <span id="opponent-name" class="name-highlight"><%= top_name %></span>
      </div>
      <div class="player-clock" id="opponent-clock">--:--</div>
    </div>

    <!-- Center: Board -->
    <div class="board-wrapper">
      <div id="chess-board"></div>
    </div>

    <!-- Replay Controls (Visible for completed games or upon game over) -->
    <div id="replay-panel" class="replay-panel" style="<%= @match.completed? ? '' : 'display: none;' %>">
      <div class="replay-controls">
        <button type="button" id="btn-replay-first" class="btn btn-secondary btn-replay" title="Kezdőállás">⏮ Első</button>
        <button type="button" id="btn-replay-prev" class="btn btn-secondary btn-replay" title="Előző lépés">◀ Előző</button>
        <span id="replay-step-info" class="replay-step-info">Kezdőállás</span>
        <button type="button" id="btn-replay-next" class="btn btn-secondary btn-replay" title="Következő lépés">Következő ▶</button>
        <button type="button" id="btn-replay-last" class="btn btn-secondary btn-replay" title="Utolsó lépés">Utolsó ⏭</button>
      </div>
      <small class="replay-hint">Tipp: A billentyűzet ← és → gombjaival is lépegethetsz.</small>
    </div>

    <!-- User / Bottom Player Info -->
    <div class="player-info user-info">
      <div class="player-name">
        <span class="role-label" id="user-role-label"><%= bottom_role_label %></span>
        <span id="user-name" class="name-highlight"><%= bottom_name %></span>
      </div>
      <div class="player-clock" id="user-clock">--:--</div>
    </div>
  </div>

  <!-- Sidebar Controls -->
  <div class="sidebar-controls">
    <h3>Játszma Állapota</h3>
    <div id="status-display" class="status-box status-<%= @match.status %>">
      <%= status_badge_text %>
    </div>
    
    <div id="active-actions-container" style="<%= @match.active? && !is_spectator ? '' : 'display: none;' %>">
      <div class="actions">
        <button type="button" id="btn-resign" class="btn btn-danger">Feladás</button>
        <button type="button" id="btn-draw" class="btn btn-warning">Döntetlen Ajánlat</button>
        <button type="button" id="btn-takeback" class="btn btn-info">Visszalépés Kérése</button>
      </div>
    </div>

    <!-- Pending interactive prompt for draw / takeback -->
    <div id="prompt-card" class="prompt-card" style="display: none;">
      <p id="prompt-message"></p>
      <div class="prompt-buttons">
        <button type="button" id="btn-prompt-accept" class="btn btn-success btn-sm">Elfogadás</button>
        <button type="button" id="btn-prompt-decline" class="btn btn-danger btn-sm">Elutasítás</button>
      </div>
    </div>

    <div class="pgn-box">
      <h4>Lépések (PGN)</h4>
      <textarea id="pgn-content" readonly><%= @match.pgn %></textarea>
      <button type="button" id="btn-copy-pgn" class="btn btn-secondary">PGN Másolása</button>
    </div>

    <div class="match-meta-box">
      <div><strong>Időkorlát:</strong> <%= @match.time_control.present? ? "#{@match.time_control / 60} perc" : "Nincs (Végtelen)" %></div>
      <div><strong>Azonosító:</strong> <span style="font-family: monospace; font-size: 0.82rem;"><%= @match.uuid[0..7] %></span></div>
    </div>
  </div>

</div>

