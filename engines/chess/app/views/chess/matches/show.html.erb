<%
  current_guest = session[:guest_id]

  is_white = (@match.white_user_id.present? && current_user.present? && @match.white_user_id == current_user.id) ||
             (@match.white_guest_id.present? && current_guest.present? && @match.white_guest_id.to_s == current_guest.to_s)

  is_black = (@match.black_user_id.present? && current_user.present? && @match.black_user_id == current_user.id) ||
             (@match.black_guest_id.present? && current_guest.present? && @match.black_guest_id.to_s == current_guest.to_s)

  is_spectator = !is_white && !is_black
  my_color = is_white ? "white" : (is_black ? "black" : "spectator")

  white_open = @match.white_user_id.nil? && @match.white_guest_id.nil?
  black_open = @match.black_user_id.nil? && @match.black_guest_id.nil?
  can_join = @match.pending? && is_spectator && (white_open || black_open)
  is_creator = !is_spectator
  is_creator = @match.creator?(current_user, current_guest)

  if is_spectator
    top_role_label = "Sötét:"
    top_name = @match.black_player_name
    bottom_role_label = "Világos:"
    bottom_name = @match.white_player_name
  elsif is_white
    top_role_label = "Ellenfél (Sötét):"
    top_name = @match.black_player_name
    bottom_role_label = "Te (Világos):"
    bottom_name = @match.white_player_name
  else
    top_role_label = "Ellenfél (Világos):"
    top_name = @match.white_player_name
    bottom_role_label = "Te (Sötét):"
    bottom_name = @match.black_player_name
  end

  status_badge_text = case @match.status
                      when "pending" then "Várakozás ellenfélre"
                      when "active" then "Játékban"
                      when "completed" then "Befejeződött"
                      when "aborted" then "Megszakítva"
                      else @match.status
                      end

  # Real-time remaining clock deduction for initial page load
  server_now = Time.current
  elapsed_since_last_move = (@match.active? && @match.time_control.present? && @match.last_move_at.present?) ? ((server_now - @match.last_move_at) * 1000).to_i : 0

  turn = @match.current_turn
  white_time_now = @match.white_time_left
  black_time_now = @match.black_time_left
  if @match.active? && @match.time_control.present?
    if turn == "white" && white_time_now.present?
      white_time_now = [white_time_now - elapsed_since_last_move, 0].max
    elsif turn == "black" && black_time_now.present?
      black_time_now = [black_time_now - elapsed_since_last_move, 0].max
    end
  end
%>

<div class="chess-game-container"
     data-match-id="<%= @match.uuid %>"
     data-status="<%= @match.status %>"
     data-time-control="<%= @match.time_control %>"
     data-white-time="<%= white_time_now %>"
     data-black-time="<%= black_time_now %>"
     data-last-move-at="<%= @match.last_move_at ? (@match.last_move_at.to_f * 1000).to_i : '' %>"
     data-my-color="<%= my_color %>"
     data-guest-id="<%= session[:guest_id] %>">

  <!-- Floating Toast Notification Container -->
  <div id="chess-toast-container" class="chess-toast-container"></div>

  <!-- In-Game Modal Overlay for Events (e.g. Challenge Cancelled) -->
  <div id="chess-modal-overlay" class="chess-modal-overlay" style="display: none;">
    <div class="chess-modal-card">
      <div class="chess-modal-icon" id="chess-modal-icon">⚠️</div>
      <h3 class="chess-modal-title" id="chess-modal-title">Értesítés</h3>
      <p class="chess-modal-message" id="chess-modal-message"></p>
      <p class="chess-modal-subtext" id="chess-modal-subtext"></p>
      <div class="chess-modal-countdown-wrapper" id="chess-modal-countdown-wrapper" style="display: none;">
        <span id="chess-modal-countdown-text"></span>
      </div>
      <div class="chess-modal-actions" id="chess-modal-actions">
        <button type="button" class="btn btn-secondary" id="chess-modal-btn-cancel" style="display: none;">Mégse</button>
        <button type="button" class="btn btn-primary" id="chess-modal-btn-action">Rendben</button>
      </div>
    </div>
  </div>

  <!-- Formázott PGN Modal Ablak (Dialog) -->
  <div id="pgn-modal-overlay" class="chess-modal-overlay" style="display: none;">
    <div class="pgn-modal-card">
      <div class="pgn-modal-header">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 1.35rem;">📜</span>
          <h3 style="margin: 0; font-size: 1.15rem; color: #f8fafc;">Játszma PGN Jegyzőkönyv</h3>
        </div>
        <button type="button" class="chess-toast-close" id="btn-close-pgn-modal" style="font-size: 1.4rem; cursor: pointer;" title="Bezárás">&times;</button>
      </div>

      <!-- PGN Metaadat Kártya -->
      <div class="pgn-meta-grid">
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Esemény:</span>
          <span class="pgn-meta-val">Bánk's Repository Sakk</span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Helyszín:</span>
          <span class="pgn-meta-val">bankrepo.hu</span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Dátum:</span>
          <span class="pgn-meta-val"><%= @match.created_at.strftime("%Y.%m.%d") %></span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Időkorlát:</span>
          <span class="pgn-meta-val"><%= @match.time_control.present? ? "#{@match.time_control / 60} perc" : "Nincs korlát" %></span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Világos:</span>
          <span class="pgn-meta-val" id="pgn-meta-white" style="color: #38bdf8;"><%= @match.white_player_name %></span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Sötét:</span>
          <span class="pgn-meta-val" id="pgn-meta-black" style="color: #a855f7;"><%= @match.black_player_name %></span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Eredmény:</span>
          <span class="pgn-meta-val" id="pgn-meta-result" style="font-weight: 800; color: #fbbf24;">
            <%= @match.completed? ? (@match.winner == 'white' ? '1-0' : (@match.winner == 'black' ? '0-1' : '1/2-1/2')) : '*' %>
          </span>
        </div>
        <div class="pgn-meta-item">
          <span class="pgn-meta-label">Azonosító:</span>
          <span class="pgn-meta-val" style="font-family: monospace; font-size: 0.8rem;"><%= @match.uuid[0..7] %></span>
        </div>
      </div>

      <!-- Tab Váltó -->
      <div class="pgn-tabs">
        <button type="button" class="pgn-tab-btn active" id="tab-btn-formatted">📋 Formázott Lépések</button>
        <button type="button" class="pgn-tab-btn" id="tab-btn-raw">📝 Nyers PGN Szöveg</button>
      </div>

      <!-- 1. Formázott Lépéslista Panel -->
      <div id="pgn-panel-formatted" class="pgn-tab-content active">
        <div id="pgn-moves-table-wrap" class="pgn-moves-table-wrap"></div>
      </div>

      <!-- 2. Nyers PGN Szöveg Panel -->
      <div id="pgn-panel-raw" class="pgn-tab-content">
        <textarea id="pgn-raw-textarea" class="pgn-raw-textarea" readonly></textarea>
      </div>

      <!-- Akciógombok -->
      <div class="pgn-modal-actions">
        <button type="button" id="btn-modal-copy-pgn" class="btn btn-secondary">
          <span id="copy-btn-icon">📋</span>
          <span id="copy-btn-label">Másolás Vágólapra</span>
        </button>
        <button type="button" id="btn-modal-download-pgn" class="btn btn-primary">
          <span>💾</span>
          <span>Letöltés (.pgn)</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Game Layout -->
  <div class="game-layout">
    <!-- Notifications & Game Over Banner -->
    <div id="game-over-banner" class="game-banner <%= @match.completed? ? 'active' : '' %>" style="<%= @match.completed? ? '' : 'display: none;' %>">
      <h3 id="banner-title"><%= @match.completed? ? "Játszma véget ért" : "" %></h3>
      <p id="banner-reason">
        <% if @match.completed? %>
          <% case @match.termination_reason %>
          <% when "checkmate" %>
            Sakk-matt! Nyertes: <%= @match.winner == "white" ? @match.white_player_name : @match.black_player_name %>
          <% when "resign" %>
            Feladás. Nyertes: <%= @match.winner == "white" ? @match.white_player_name : @match.black_player_name %>
          <% when "timeout" %>
            Időtúllépés! Nyertes: <%= @match.winner == "white" ? @match.white_player_name : @match.black_player_name %>
          <% when "draw_agreed" %>
            Döntetlen közös megegyezéssel.
          <% when "stalemate" %>
            Patt! A játszma döntetlen.
          <% else %>
            A játszma lezárult.
          <% end %>
        <% end %>
      </p>
    </div>

    <% if can_join %>
      <div class="join-banner">
        <div>
          <strong>Nyitott kihívás!</strong> Csatlakozz a mérkőzéshez mint 
          <span class="badge-role"><%= white_open ? "Világos" : "Sötét" %></span> játékos!
        </div>
        <%= link_to "Csatlakozás Játékosként", match_path(@match.uuid, join: true), class: "btn btn-primary btn-sm" %>
      </div>
    <% elsif @match.pending? && is_creator %>
      <div class="pending-creator-banner">
        <div style="margin-bottom: 0.5rem;">
          <strong>Várakozás az ellenfélre...</strong> Oszd meg ezt a linket a barátoddal:
        </div>
        <div class="share-link-group">
          <input type="text" id="share-link-input" readonly value="<%= match_url(@match.uuid, join: true) %>" class="share-input">
          <button type="button" id="btn-copy-link" class="btn btn-primary btn-sm">Link Másolása</button>
        </div>
        <div style="margin-top: 10px; display: flex; justify-content: flex-end;">
          <%= button_to "❌ Kihívás Visszavonása", cancel_match_path(@match.uuid), method: :post, class: "btn btn-danger btn-sm", data: { turbo_confirm: "Biztosan vissza szeretnéd vonni a kihívást?" } %>
        </div>
      </div>
    <% end %>

    <!-- Opponent / Top Player Info -->
    <div class="player-info opponent-info">
      <div class="player-name">
        <span class="role-label" id="opponent-role-label"><%= top_role_label %></span>
        <span id="opponent-name" class="name-highlight"><%= top_name %></span>
      </div>
      <div class="player-clock" id="opponent-clock">--:--</div>
    </div>

    <!-- Center: Board with SVG arrows layer and resize handle -->
    <div class="board-wrapper" id="board-wrapper">
      <div class="board-relative-container" id="board-relative-container">
        <div id="chess-board"></div>
        <svg id="chess-arrows-svg" class="chess-arrows-svg" viewBox="0 0 800 800" preserveAspectRatio="none">
          <defs>
            <marker id="arrowhead" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M 0 1 L 10 5 L 0 9 z" fill="rgba(251, 191, 36, 0.9)" />
            </marker>
          </defs>
          <g id="svg-highlights-group"></g>
          <g id="svg-arrows-group"></g>
          <g id="svg-preview-group"></g>
        </svg>
        <div id="board-resizer" class="board-resizer" title="Tábla átméretezése (húzd a saroknál)">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M22 22H20V20H22V22ZM22 18H20V16H22V18ZM18 22H16V20H18V22ZM18 18H16V16H18V18ZM14 22H12V20H14V22ZM22 14H20V12H22V14Z" opacity="0.8"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Replay Controls (Visible for completed games or upon game over) -->
    <div id="replay-panel" class="replay-panel" style="<%= @match.completed? ? '' : 'display: none;' %>">
      <div class="replay-controls">
        <button type="button" id="btn-replay-first" class="btn btn-secondary btn-replay" title="Kezdőállás">⏮ Első</button>
        <button type="button" id="btn-replay-prev" class="btn btn-secondary btn-replay" title="Előző lépés">◀ Előző</button>
        <span id="replay-step-info" class="replay-step-info">Kezdőállás</span>
        <button type="button" id="btn-replay-next" class="btn btn-secondary btn-replay" title="Következő lépés">Következő ▶</button>
        <button type="button" id="btn-replay-last" class="btn btn-secondary btn-replay" title="Utolsó lépés">Utolsó ⏭</button>
      </div>
      <small class="replay-hint">Tipp: A billentyűzet ← és → gombjaival is lépegethetsz.</small>
    </div>

    <!-- User / Bottom Player Info -->
    <div class="player-info user-info">
      <div class="player-name">
        <span class="role-label" id="user-role-label"><%= bottom_role_label %></span>
        <span id="user-name" class="name-highlight"><%= bottom_name %></span>
      </div>
      <div class="player-clock" id="user-clock">--:--</div>
    </div>
  </div>

  <!-- Sidebar Controls -->
  <div class="sidebar-controls">
    <h3>Játszma Állapota</h3>
    <div id="status-display" class="status-box status-<%= @match.status %>">
      <%= status_badge_text %>
    </div>
    
    <% chess_settings = Chess::Setting.current rescue nil %>
    <div id="active-actions-container" style="<%= @match.active? && !is_spectator ? '' : 'display: none;' %>">
      <div class="actions">
        <button type="button" id="btn-resign" class="btn btn-danger">Feladás</button>
        <% if chess_settings.nil? || chess_settings.allow_draw_offer? %>
          <button type="button" id="btn-draw" class="btn btn-warning">Döntetlen Ajánlat</button>
        <% end %>
        <% if chess_settings.nil? || chess_settings.allow_takeback? %>
          <button type="button" id="btn-takeback" class="btn btn-info">Visszalépés Kérése</button>
        <% end %>
      </div>
    </div>

    <!-- Pending interactive prompt for draw / takeback -->
    <div id="prompt-card" class="prompt-card" style="display: none;">
      <p id="prompt-message"></p>
      <div class="prompt-buttons">
        <button type="button" id="btn-prompt-accept" class="btn btn-success btn-sm">Elfogadás</button>
        <button type="button" id="btn-prompt-decline" class="btn btn-danger btn-sm">Elutasítás</button>
      </div>
    </div>

    <div class="pgn-box">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <h4 style="margin: 0; display: flex; align-items: center; gap: 8px;">
          <span>📜</span> Lépések
          <button type="button" id="btn-live-state" class="btn-live-state" style="display: none;" title="Visszaugrás az élő állásra">⚡ Élő állás</button>
        </h4>
        <button type="button" id="btn-open-pgn-modal" class="btn btn-secondary btn-sm" style="border-color: #38bdf8; color: #38bdf8; padding: 3px 8px; font-size: 0.78rem;">
          📜 Export & PGN
        </button>
      </div>
      <textarea id="pgn-content" readonly style="display: none;"><%= @match.pgn %></textarea>

      <!-- Strukturált Kétoszlopos Lépéslista -->
      <div id="pgn-structured-container" class="pgn-structured-container">
        <div id="pgn-structured-list" class="pgn-structured-list">
          <div class="pgn-empty-text">Még nem történt lépés.</div>
        </div>
      </div>

      <div style="display: flex; gap: 6px; margin-top: 8px;">
        <button type="button" id="btn-copy-pgn" class="btn btn-secondary btn-sm" style="flex: 1; font-size: 0.8rem;">
          📋 Másolás
        </button>
        <button type="button" id="btn-quick-download-pgn" class="btn btn-secondary btn-sm" style="flex: 1; font-size: 0.8rem;">
          💾 Letöltés
        </button>
      </div>
    </div>

    <div class="match-meta-box">
      <div><strong>Időkorlát:</strong> <%= @match.time_control.present? ? "#{@match.time_control / 60} perc" : "Nincs (Végtelen)" %></div>
      <div><strong>Azonosító:</strong> <span style="font-family: monospace; font-size: 0.82rem;"><%= @match.uuid[0..7] %></span></div>
    </div>
  </div>

</div>

<!-- CSS Styles for Deep Dark Theme & Responsive Design -->
<style>
  .chess-game-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding: 1.5rem 1rem;
    color: #e2e8f0;
    max-width: 1400px;
    margin: 0 auto;
    box-sizing: border-box;
    --board-size: 450px;
    --game-board-width: 480px;
  }
  .game-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #11192e;
    padding: 1.25rem;
    border-radius: 10px;
    border: 1px solid #1a243b;
    width: 100%;
    max-width: var(--game-board-width, 480px);
    box-sizing: border-box;
    transition: max-width 0.05s ease;
  }
  .player-info {
    width: 100%;
    max-width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0.85rem;
    background: #0a0f1d;
    margin: 0.4rem 0;
    border-radius: 6px;
    border: 1px solid #1a243b;
    box-sizing: border-box;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .player-info.active-turn {
    border-color: #38bdf8;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.25);
  }
  .player-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    min-width: 0;
    overflow: hidden;
  }
  .role-label {
    color: #94a3b8;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .name-highlight {
    font-weight: 600;
    color: #f1f5f9;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .player-clock {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.2rem;
    font-weight: 700;
    color: #38bdf8;
    background: #11192e;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #1a243b;
    min-width: 60px;
    text-align: center;
  }
  .player-clock.low-time {
    color: #ef4444;
    border-color: #ef4444;
    animation: pulse 1s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }
  .board-wrapper {
    width: 100%;
    max-width: var(--board-size, 450px);
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }
  .board-relative-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1 / 1;
  }
  .chess-arrows-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 20;
  }
  .board-resizer {
    position: absolute;
    bottom: -6px;
    right: -6px;
    width: 22px;
    height: 22px;
    background: #11192e;
    border: 1px solid #23304d;
    border-radius: 4px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: nwse-resize;
    z-index: 35;
    user-select: none;
    touch-action: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .board-resizer:hover {
    background: #1a243b;
    color: #38bdf8;
    border-color: #38bdf8;
  }
  #chess-board {
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    touch-action: none; /* Prevents accidental screen scrolling while dragging pieces */
    user-select: none;
    -webkit-user-select: none;
  }
  #chess-board img,
  .board-relative-container img,
  .piece-417db {
    -webkit-user-drag: none;
    user-drag: none;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    pointer-events: auto;
  }
  .square-selected {
    background-color: rgba(56, 189, 248, 0.45) !important;
    box-shadow: inset 0 0 6px 2px #38bdf8 !important;
  }
  .square-premove {
    background-color: rgba(6, 182, 212, 0.45) !important;
    box-shadow: inset 0 0 0 3px #06b6d4, inset 0 0 10px rgba(6, 182, 212, 0.6) !important;
  }
  .square-target-hint {
    position: relative;
  }
  .square-target-hint::after {
    content: '';
    position: absolute;
    width: 32%;
    height: 32%;
    background: rgba(56, 189, 248, 0.55);
    border-radius: 50%;
    top: 34%;
    left: 34%;
    pointer-events: none;
    z-index: 10;
  }
  .pgn-structured-container {
    width: 100%;
    height: 165px;
    overflow-y: auto;
    background: #0a0f1d;
    border: 1px solid #1a243b;
    border-radius: 6px;
    box-sizing: border-box;
    scroll-behavior: smooth;
  }
  .pgn-structured-container::-webkit-scrollbar { width: 5px; }
  .pgn-structured-container::-webkit-scrollbar-thumb { background: #23304d; border-radius: 3px; }
  .pgn-structured-list {
    width: 100%;
  }
  .pgn-empty-text {
    color: #64748b;
    font-style: italic;
    font-size: 0.85rem;
    text-align: center;
    padding: 2.5rem 1rem;
  }
  .pgn-live-table {
    width: 100%;
    border-collapse: collapse;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
  }
  .pgn-live-row:nth-child(even) {
    background: rgba(255, 255, 255, 0.02);
  }
  .pgn-live-row:hover {
    background: rgba(56, 189, 248, 0.05);
  }
  .pgn-live-num {
