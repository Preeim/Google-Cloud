<style>
  .chess-dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    gap: 16px;
  }
  .chess-dash-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
  }
  @media (max-width: 768px) {
    .chess-dash-header {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 16px;
    }
    .chess-dash-header .btn {
      width: 100%;
    }
    .chess-dash-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>

<div class="chess-dash-header">
  <div>
    <h1 style="font-size: clamp(1.4rem, 4vw, 1.8rem); font-weight: 800; color: var(--text-main);">Sakk Előszoba & Partik</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Indíts új partit, vagy csatlakozz egy létező asztalhoz.</p>
  </div>
  <div>
    <a href="/chess/matches" class="btn btn-primary">
      <span>+</span> Nyitott Partik Megtekintése
    </a>
  </div>
</div>

<div class="chess-dash-grid">
  <!-- Bal oldal: Sakktábla Előnézet és Lobby -->
  <div class="card">
    <h2 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 16px;">Nyitott Partik & Várakozó Játékosok</h2>
    <div style="background: var(--bg-elevated); border: 1px dashed var(--border-subtle); border-radius: 8px; padding: 48px 20px; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 12px;">♟️</div>
      <p style="font-size: 1.05rem; font-weight: 600; color: var(--text-main); margin-bottom: 6px;">Nincs aktív nyitott kihívás</p>
      <p style="font-size: 0.9rem;">Kattints a fenti "Új Parti Indítása" gombra egy új játszma indításához!</p>
    </div>
  </div>

  <!-- Jobb oldal: Játékos Profil vagy Vendég Tájékoztató -->
  <div class="card">
    <h2 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 16px;">Játékos Profilod</h2>
    
    <% if logged_in? %>
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 18px;">
        <div style="width: 44px; height: 44px; background: var(--accent); color: #0a0f1d; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem;">
          <%= current_user.username[0].upcase %>
        </div>
        <div>
          <div style="font-weight: 700; font-size: 1rem;"><%= current_user.username %></div>
          <div style="color: var(--text-muted); font-size: 0.85rem;">Értékszám: 1200 (Alap)</div>
        </div>
      </div>
      <div style="border-top: 1px solid var(--border-subtle); padding-top: 14px; font-size: 0.88rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between;">
          <span>Játszott meccsek:</span>
          <strong style="color: var(--text-main);">0</strong>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <span>Győzelmek / Vereségek:</span>
          <strong style="color: var(--text-main);">0 / 0</strong>
        </div>
      </div>
    <% else %>
      <div style="background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 16px; margin-bottom: 16px; text-align: center;">
        <div style="font-size: 2rem; margin-bottom: 8px;">👤</div>
        <div style="font-weight: 700; font-size: 1rem; color: var(--text-main); margin-bottom: 4px;">Vendégként játszol</div>
        <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.4; margin-bottom: 14px;">
          A meccseid statisztikáinak és értékszámod mentéséhez jelentkezz be fiókodba!
        </p>
        <div style="display: flex; gap: 8px; justify-content: center;">
          <a href="/login" class="btn btn-primary" style="padding: 6px 14px; font-size: 0.85rem;">Bejelentkezés</a>
          <a href="/register" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem;">Regisztráció</a>
        </div>
      </div>
    <% end %>
  </div>
</div>
