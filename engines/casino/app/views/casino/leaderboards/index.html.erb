<div style="margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px;">
        <a href="<%= root_path %>" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">← Lobbi</a>
        <span style="color: var(--border-hover);">/</span>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin: 0;">
          🏆 Grand Casino Ranglista
        </h1>
      </div>
      <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 6px;">
        A platform leggazdagabb játékosai és legaktívabb kaszinó mesterei.
      </p>
    </div>

    <%# Saját Helyezés Kártya %>
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 10px; padding: 10px 18px; display: flex; align-items: center; gap: 14px;">
      <div>
        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Helyezésed</div>
        <div style="font-size: 1.3rem; font-weight: 800; color: var(--casino-gold);">#<%= @my_rank %></div>
      </div>
      <div style="border-left: 1px solid var(--border-subtle); height: 32px;"></div>
      <div>
        <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Zsetonjaid</div>
        <div style="font-size: 1.2rem; font-weight: 800; color: #fef08a;">🪙 <%= number_with_delimiter(@my_profile.chips) %></div>
      </div>
    </div>
  </div>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <table style="margin-top: 0;">
    <thead>
      <tr>
        <th style="width: 80px; text-align: center;">Helyezés</th>
        <th>Játékos</th>
        <th style="text-align: right;">Zsetonegyenleg</th>
        <th style="text-align: center;">Játszott Körök</th>
        <th style="text-align: center;">Nyert Körök</th>
      </tr>
    </thead>
    <tbody>
      <% @profiles.each_with_index do |profile, idx| %>
        <% 
          is_me = profile.user_id == current_user.id
          rank_color = case idx
                       when 0 then '#fbbf24'
                       when 1 then '#94a3b8'
                       when 2 then '#d97706'
                       else 'var(--text-muted)'
                       end
          rank_icon = case idx
                      when 0 then '🥇'
                      when 1 then '🥈'
                      when 2 then '🥉'
                      else "##{idx + 1}"
                      end
        %>
        <tr style="<%= 'background: rgba(56, 189, 248, 0.08);' if is_me %>">
          <td style="text-align: center; font-weight: 800; font-size: 1.1rem; color: <%= rank_color %>;">
            <%= rank_icon %>
          </td>
          <td>
            <div style="display: flex; align-items: center; gap: 8px;">
              <strong style="color: <%= is_me ? 'var(--accent)' : 'var(--text-main)' %>; font-size: 0.95rem;">
                <%= profile.user.username %>
              </strong>
              <% if is_me %>
                <span style="font-size: 0.7rem; background: var(--accent); color: #000; padding: 1px 6px; border-radius: 10px; font-weight: 700;">Te</span>
              <% end %>
            </div>
          </td>
          <td style="text-align: right; font-weight: 800; font-size: 1.05rem; color: #fef08a;">
            🪙 <%= number_with_delimiter(profile.chips) %>
          </td>
          <td style="text-align: center; color: var(--text-muted); font-weight: 600;">
            <%= profile.total_rounds_played %>
          </td>
          <td style="text-align: center; color: var(--success); font-weight: 700;">
            <%= profile.total_won_rounds %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

