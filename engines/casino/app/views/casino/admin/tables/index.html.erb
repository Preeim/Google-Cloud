<div style="margin-bottom: 24px;">
  <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main);">
    🎮 Kaszinó Élő Asztalok Felügyelete
  </h1>
  <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 4px;">
    Asztalok azonnali leállítása, karbantartási módba helyezése vagy beragadt körök újraindítása.
  </p>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <table style="margin-top: 0;">
    <thead>
      <tr>
        <th>Asztal Neve</th>
        <th>Játéktípus</th>
        <th>Állapot</th>
        <th>Aktuális Kör</th>
        <th>Téthatárok</th>
        <th style="text-align: right;">Műveletek</th>
      </tr>
    </thead>
    <tbody>
      <% @tables.each do |table| %>
        <tr>
          <td>
            <strong style="color: var(--text-main);"><%= table.name %></strong>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Slug: /casino/tables/<%= table.slug %></div>
          </td>
          <td>
            <span style="font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: var(--accent);">
              <%= table.game_type %>
            </span>
          </td>
          <td>
            <% if table.state == "maintenance" %>
              <span class="tag tag-maintenance">Karbantartás (Leállítva)</span>
            <% else %>
              <span class="tag tag-active">Aktív (<%= table.state %>)</span>
            <% end %>
          </td>
          <td>
            <strong style="color: var(--casino-gold);">#<%= table.round_number %></strong>
          </td>
          <td style="color: var(--text-muted); font-size: 0.85rem;">
            <%= table.min_bet %> - <%= number_with_delimiter(table.max_bet) %> zseton
          </td>
          <td style="text-align: right;">
            <div style="display: inline-flex; gap: 8px;">
              <%= button_to toggle_admin_table_path(table), method: :post, class: "btn #{table.state == 'maintenance' ? 'btn-primary' : 'btn-danger'}", style: "padding: 5px 12px; font-size: 0.8rem;" do %>
                <%= table.state == 'maintenance' ? 'Asztal Megnyitása' : 'Karbantartás' %>
              <% end %>

              <%= button_to reset_round_admin_table_path(table), method: :post, data: { confirm: "Biztosan újraindítod ezt a kört és törlöd a függő téteket?" }, class: "btn btn-secondary", style: "padding: 5px 12px; font-size: 0.8rem;" do %>
                Kör Újraindítása
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

