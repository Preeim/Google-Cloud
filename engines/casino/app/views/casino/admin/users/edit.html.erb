<div style="margin-bottom: 20px;">
  <div style="display: flex; align-items: center; gap: 10px;">
    <a href="<%= admin_users_path %>" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">← Vissza a Játékosokhoz</a>
    <span style="color: var(--border-hover);">/</span>
    <h1 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main); margin: 0;">
      <%= @profile.user.username %> Zsetonszámlája
    </h1>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start;">
  <!-- Bal oldal: Egyenleg módosító űrlapok -->
  <div style="display: flex; flex-direction: column; gap: 20px;">
    <!-- Jelenlegi Állapot -->
    <div class="card" style="border-color: rgba(251, 191, 36, 0.3);">
      <div style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Jelenlegi Egyenleg</div>
      <div style="font-size: 2.2rem; font-weight: 900; color: #fef08a; margin: 8px 0;">
        🪙 <%= number_with_delimiter(@profile.chips) %> <span style="font-size: 1rem; color: var(--text-muted); font-weight: 400;">zseton</span>
      </div>
      <div style="font-size: 0.85rem; color: var(--text-muted);">
        Játszott körök: <strong><%= @profile.total_rounds_played %></strong> | 
        Nyert körök: <strong style="color: var(--success);"><%= @profile.total_won_rounds %></strong>
      </div>
    </div>

    <!-- 1. Művelet: Zseton Hozzáadása (+) -->
    <div class="card">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--success); margin-bottom: 12px;">
        ➕ Zseton Jóváírása (Hozzáadás)
      </h3>
      <%= form_with url: admin_user_path(@profile), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :action_type, "add" %>
        <div class="form-group">
          <label>Jóváírandó Összeg</label>
          <%= number_field_tag :amount, 1000, min: 1, step: 100, class: "form-control" %>
        </div>
        <%= f.submit "+ Zseton Hozzáadása", class: "btn btn-primary", style: "background: var(--success); color: #000; font-weight: 700;" %>
      <% end %>
    </div>

    <!-- 2. Művelet: Zseton Levonása (-) -->
    <div class="card">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--danger); margin-bottom: 12px;">
        ➖ Zseton Levonása (Csökkentés)
      </h3>
      <%= form_with url: admin_user_path(@profile), method: :patch, local: true do |f| %>
        <%= hidden_field_tag :action_type, "deduct" %>
        <div class="form-group">
          <label>Levonandó Összeg</label>
          <%= number_field_tag :amount, 500, min: 1, max: @profile.chips, step: 100, class: "form-control" %>
        </div>
        <%= f.submit "- Zseton Levonása", class: "btn btn-danger", style: "font-weight: 700;" %>
      <% end %>
    </div>

    <!-- 3. Művelet: Fix összeg beállítása / 10k Reset -->
    <div class="card">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--casino-gold); margin-bottom: 12px;">
        ⚙️ Egyenleg Felülírása vagy Visszaállítása
      </h3>
      <%= form_with url: admin_user_path(@profile), method: :patch, local: true, style: "margin-bottom: 14px;" do |f| %>
        <%= hidden_field_tag :action_type, "set" %>
        <div class="form-group">
          <label>Pontos Új Egyenleg (fix érték)</label>
          <%= number_field_tag :new_amount, @profile.chips, min: 0, class: "form-control" %>
        </div>
        <%= f.submit "Egyenleg Fix Rögzítése", class: "btn btn-secondary", style: "font-weight: 700;" %>
      <% end %>

      <div style="border-top: 1px solid var(--border-subtle); padding-top: 14px;">
        <%= button_to reset_admin_user_path(@profile), method: :post, data: { confirm: "Biztosan visszaállítod 10 000 zsetonra?" }, class: "btn btn-gold", style: "width: 100%;" do %>
          ↺ Visszaállítás a Kezdő 10 000 Zsetonra
        <% end %>
      </div>
    </div>
  </div>

  <!-- Jobb oldal: Játékos Tranzakciós Előzményei -->
  <div class="card">
    <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 14px;">
      📜 Játékos Legutóbbi Tranzakciói
    </h3>

    <% if @recent_transactions.any? %>
      <table style="margin-top: 0;">
        <thead>
          <tr>
            <th>Időpont</th>
            <th>Típus</th>
            <th style="text-align: right;">Összeg</th>
            <th style="text-align: right;">Egyenleg</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_transactions.each do |t| %>
            <tr>
              <td style="color: var(--text-muted); font-size: 0.8rem;"><%= t.created_at.strftime("%m.%d %H:%M") %></td>
              <td style="text-transform: uppercase; font-size: 0.75rem; color: var(--accent);"><%= t.transaction_type %></td>
              <td style="text-align: right; font-weight: 700; color: <%= t.amount > 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <%= t.amount > 0 ? "+#{number_with_delimiter(t.amount)}" : number_with_delimiter(t.amount) %>
              </td>
              <td style="text-align: right; color: #fef08a; font-weight: 700;">
                <%= number_with_delimiter(t.balance_after) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Még nincs rögzített tranzakció ehhez a profilhoz.</p>
    <% end %>
  </div>
</div>

