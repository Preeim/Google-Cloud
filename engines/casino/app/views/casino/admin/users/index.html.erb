<div style="margin-bottom: 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
    <div>
      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main);">
        👥 Kaszinó Játékosok & Zsetonszámlák
      </h1>
      <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 4px;">
        Zsetonok jóváírása, levonása, egyenleg felülírása vagy visszaállítása a kezdő 10 000-re.
      </p>
    </div>

    <!-- Kereső űrlap -->
    <div>
      <%= form_with url: admin_users_path, method: :get, local: true, style: "display: flex; gap: 8px;" do |f| %>
        <%= f.text_field :search, value: params[:search], placeholder: "Keresés felhasználónévre...", class: "form-control", style: "width: 240px; padding: 8px 12px;" %>
        <%= f.submit "Keresés", class: "btn btn-secondary", style: "padding: 8px 14px;" %>
      <% end %>
    </div>
  </div>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <table style="margin-top: 0;">
    <thead>
      <tr>
        <th>Felhasználónév</th>
        <th>E-mail cím</th>
        <th style="text-align: right;">Zsetonegyenleg</th>
        <th style="text-align: center;">Játszott Körök</th>
        <th style="text-align: center;">Nyert Körök</th>
        <th style="text-align: right;">Műveletek</th>
      </tr>
    </thead>
    <tbody>
      <% @profiles.each do |p| %>
        <tr>
          <td>
            <strong style="color: var(--text-main);"><%= p.user.username %></strong>
            <% if p.user.admin? %>
              <span class="tag tag-maintenance" style="font-size: 0.68rem; margin-left: 6px;">ADMIN</span>
            <% end %>
          </td>
          <td style="color: var(--text-muted); font-size: 0.85rem;"><%= p.user.email %></td>
          <td style="text-align: right; font-weight: 800; color: #fef08a; font-size: 1.05rem;">
            🪙 <%= number_with_delimiter(p.chips) %>
          </td>
          <td style="text-align: center; color: var(--text-muted); font-weight: 600;"><%= p.total_rounds_played %></td>
          <td style="text-align: center; color: var(--success); font-weight: 600;"><%= p.total_won_rounds %></td>
          <td style="text-align: right;">
            <div style="display: inline-flex; gap: 8px;">
              <%= link_to "Kezelés / Módosítás", edit_admin_user_path(p), class: "btn btn-secondary", style: "padding: 4px 10px; font-size: 0.8rem;" %>
              <%= button_to "10k Reset", reset_admin_user_path(p), method: :post, data: { confirm: "Biztosan visszaállítod #{p.user.username} zsetonjait 10 000-re?" }, class: "btn btn-gold", style: "padding: 4px 10px; font-size: 0.8rem;" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

