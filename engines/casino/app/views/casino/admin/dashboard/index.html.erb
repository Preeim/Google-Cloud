<div style="margin-bottom: 24px;">
  <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-main);">
    🎰 Kaszinó Rendszergazdai Műszerfal
  </h1>
  <p style="color: var(--text-muted); font-size: 0.92rem; margin-top: 4px;">
    Gazdasági mutatók, forgalomban lévő zsetonok és asztali aktivitás áttekintése.
  </p>
</div>

<%# Statisztikai Kártyák %>
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Összes Forgalomban Lévő Zseton</div>
    <div class="stat-val" style="color: #fef08a;">🪙 <%= number_with_delimiter(@total_chips) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Regisztrált Kaszinó Játékosok</div>
    <div class="stat-val" style="color: var(--accent);"><%= @total_profiles %> fő</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Összes Leadott Fogadás</div>
    <div class="stat-val" style="color: var(--success);"><%= number_with_delimiter(@total_bets) %> db</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Aktív Asztalok</div>
    <div class="stat-val" style="color: var(--casino-gold);"><%= @tables.count %> db</div>
  </div>
</div>

<%# Élő Asztalok Állapota %>
<div class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin: 0;">
      🎮 Asztalok Állapota és Gyorsműveletek
    </h2>
    <%= link_to "Összes Asztal Kezelése →", admin_tables_path, class: "btn btn-secondary", style: "font-size: 0.82rem;" %>
  </div>

  <table class="responsive-table">
    <thead>
      <tr>
        <th>Asztal Neve</th>
        <th>Játéktípus</th>
        <th>Állapot</th>
        <th>Kör</th>
        <th>Téthatár</th>
        <th style="text-align: right;">Művelet</th>
      </tr>
    </thead>
    <tbody>
      <% @tables.each do |table| %>
        <tr>
          <td><strong><%= table.name %></strong></td>
          <td style="text-transform: uppercase; font-size: 0.8rem; color: var(--text-muted);"><%= table.game_type %></td>
          <td>
            <% if table.state == "maintenance" %>
              <span class="tag tag-maintenance">Karbantartás</span>
            <% else %>
              <span class="tag tag-active">Aktív (<%= table.state %>)</span>
            <% end %>
          </td>
          <td>#<%= table.round_number %></td>
          <td><%= table.min_bet %> - <%= number_with_delimiter(table.max_bet) %></td>
          <td style="text-align: right;">
            <%= button_to toggle_admin_table_path(table), method: :post, class: "btn #{table.state == 'maintenance' ? 'btn-primary' : 'btn-danger'}", style: "padding: 4px 10px; font-size: 0.78rem;" do %>
              <%= table.state == 'maintenance' ? 'Engedélyezés' : 'Karbantartás' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%# Legutóbbi Pénzügyi és Audit Tranzakciók %>
<div class="card">
  <h2 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin-bottom: 16px;">
    📜 Legutóbbi Zseton Tranzakciók & Audit Napló
  </h2>

  <table class="responsive-table">
    <thead>
      <tr>
        <th>Időpont</th>
        <th>Felhasználó</th>
        <th>Típus</th>
        <th>Játék</th>
        <th style="text-align: right;">Összeg</th>
        <th style="text-align: right;">Új Egyenleg</th>
      </tr>
    </thead>
    <tbody>
      <% @recent_transactions.each do |t| %>
        <tr>
          <td style="color: var(--text-muted); font-size: 0.82rem;"><%= t.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
          <td><strong><%= t.profile.user.username %></strong></td>
          <td>
            <span style="font-size: 0.78rem; text-transform: uppercase; color: var(--accent); font-weight: 600;">
              <%= t.transaction_type %>
            </span>
          </td>
          <td style="text-transform: uppercase; font-size: 0.78rem; color: var(--text-muted);"><%= t.game_type %></td>
          <td style="text-align: right; font-weight: 700; color: <%= t.amount > 0 ? 'var(--success)' : 'var(--danger)' %>;">
            <%= t.amount > 0 ? "+#{number_with_delimiter(t.amount)}" : number_with_delimiter(t.amount) %>
          </td>
          <td style="text-align: right; font-weight: 700; color: #fef08a;">
            🪙 <%= number_with_delimiter(t.balance_after) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

