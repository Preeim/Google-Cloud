<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %> | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <%= render "shared/design_system" %>
  <style>
    header.casino-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .casino-brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.15rem; color: var(--text-main); text-decoration: none; }
    .badge-gold { background: var(--accent-subtle); border: 1px solid var(--accent-border); color: var(--accent); font-size: 0.75rem; font-weight: 700; padding: 2px 7px; border-radius: var(--radius-sm); }

    .chip-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--accent-subtle);
      border: 1px solid var(--accent-border);
      color: var(--accent);
      padding: 5px 12px;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.9rem;
      font-family: var(--font-mono);
    }

    .btn-gold { background: var(--accent); color: var(--accent-text); font-weight: 700; }
    .btn-gold:hover { background: var(--accent-hover); }

    .casino-container { max-width: 1280px; margin: 24px auto; width: 100%; padding: 0 20px; flex: 1; }

    .flash-notice { background: var(--success-subtle); border: 1px solid var(--success-border); color: #34d399; padding: 10px 16px; border-radius: var(--radius-md); margin-bottom: 16px; font-size: 0.9rem; }
    .flash-alert { background: var(--danger-subtle); border: 1px solid var(--danger-border); color: #fca5a5; padding: 10px 16px; border-radius: var(--radius-md); margin-bottom: 16px; font-size: 0.9rem; }

    @media (max-width: 768px) {
      header.casino-header {
        padding: 10px 14px;
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
      }
      .casino-header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
      }
      .casino-header-user {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding-top: 8px;
        border-top: 1px solid var(--border-subtle);
        font-size: 0.85rem;
      }
      .casino-container {
        padding: 0 10px;
        margin: 12px auto;
      }
    }
  </style>
</head>
<body>
  <!-- Kaszinó Zsetonszámláló és Navigációs Elemek Átadása a Felső Navbarba -->
  <% content_for :navbar_extra do %>
    <div style="display: flex; align-items: center; gap: 8px;">
      <a href="/casino/leaderboards" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.82rem; font-weight: 600;">
        🏆 Ranglista
      </a>
      <div class="chip-badge" id="header-chip-counter" style="padding: 4px 10px; font-size: 0.84rem;">
        <span>🪙</span>
        <span id="player-chips-display"><%= number_with_delimiter(current_casino_profile&.chips || 0) %></span>
        <span style="font-size: 0.76rem; opacity: 0.85;">zseton</span>
      </div>
      <% if admin? %>
        <a href="/casino/admin" class="btn btn-secondary" style="border-color: rgba(168, 85, 247, 0.4); color: #c084fc; padding: 4px 8px; font-size: 0.82rem;">
          🛡️ Admin
        </a>
      <% end %>
    </div>
  <% end %>

  <!-- Globális Egységes Felső Navigációs Sáv (Navbar) -->
  <%= render "shared/navbar" %>

  <main class="casino-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>

    <%= yield %>
  </main>

  <!-- Globális Chat Lebegő Rendszer -->
  <%= render "shared/global_chat" %>
</body>
</html>

