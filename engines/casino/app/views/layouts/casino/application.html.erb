<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %> | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <style>
    :root {
      --bg-canvas: #0a0f1d;
      --bg-surface: #11192e;
      --bg-elevated: #1a243b;
      --border-subtle: #23304d;
      --border-hover: #3b4b73;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      
      --accent: #38bdf8;
      --casino-gold: #fbbf24;
      --casino-gold-hover: #f59e0b;
      --casino-red: #ef4444;
      --casino-green: #10b981;
      --success: #10b981;
      --danger: #f43f5e;
    }
    
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    body { background-color: var(--bg-canvas); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }

    header.casino-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
    }
    .casino-brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; color: var(--text-main); text-decoration: none; }
    .badge-gold { background: rgba(251, 191, 36, 0.15); border: 1px solid var(--casino-gold); color: var(--casino-gold); font-size: 0.78rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; }

    .chip-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.2) 0%, rgba(217, 119, 6, 0.2) 100%);
      border: 1px solid var(--casino-gold);
      color: #fef08a;
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 700;
      font-size: 0.95rem;
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.15);
    }

    .btn { padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; border: none; font-size: 0.88rem; transition: all 0.2s; }
    .btn-gold { background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%); color: #0a0f1d; font-weight: 800; }
    .btn-gold:hover { background: #f59e0b; color: #000; }
    .btn-primary { background: var(--accent); color: #0a0f1d; }
    .btn-secondary { background: var(--bg-elevated); color: var(--text-main); border: 1px solid var(--border-subtle); }
    .btn-secondary:hover { border-color: var(--border-hover); background: #222f4c; }
    .btn-danger { background: rgba(239, 68, 68, 0.2); border: 1px solid var(--casino-red); color: #fca5a5; }

    .casino-container { max-width: 1280px; margin: 24px auto; width: 100%; padding: 0 20px; flex: 1; }
    .card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 22px; margin-bottom: 20px; }

    .flash-notice { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 12px 18px; border-radius: 8px; margin-bottom: 16px; }
    .flash-alert { background: rgba(244, 63, 94, 0.15); border: 1px solid var(--danger); color: #fb7185; padding: 12px 18px; border-radius: 8px; margin-bottom: 16px; }

    @media (max-width: 768px) {
      header.casino-header {
        padding: 10px 14px;
        flex-direction: column;
        gap: 10px;
        align-items: stretch;
      }
      .casino-header-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
      }
      .casino-header-user {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding-top: 8px;
        border-top: 1px solid var(--border-subtle);
        font-size: 0.85rem;
      }
      .casino-container {
        padding: 0 10px;
        margin: 12px auto;
      }
    }
  </style>
</head>
<body>
  <!-- Kaszinó Zsetonszámláló és Navigációs Elemek Átadása a Felső Navbarba -->
  <% content_for :navbar_extra do %>
    <div style="display: flex; align-items: center; gap: 8px;">
      <a href="/casino/leaderboards" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.82rem; font-weight: 600;">
        🏆 Ranglista
      </a>
      <div class="chip-badge" id="header-chip-counter" style="padding: 4px 10px; font-size: 0.84rem;">
        <span>🪙</span>
        <span id="player-chips-display"><%= number_with_delimiter(current_casino_profile&.chips || 0) %></span>
        <span style="font-size: 0.76rem; opacity: 0.85;">zseton</span>
      </div>
      <% if admin? %>
        <a href="/casino/admin" class="btn btn-secondary" style="border-color: rgba(168, 85, 247, 0.4); color: #c084fc; padding: 4px 8px; font-size: 0.82rem;">
          🛡️ Admin
        </a>
      <% end %>
    </div>
  <% end %>

  <!-- Globális Egységes Felső Navigációs Sáv (Navbar) -->
  <%= render "shared/navbar" %>

  <main class="casino-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>

    <%= yield %>
  </main>

  <!-- Globális Chat Lebegő Rendszer -->
  <%= render "shared/global_chat" %>
</body>
</html>

