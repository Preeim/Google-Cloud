<%# ============================================================================== %>
<%# Bánk's Repository - Központi Dizájnrendszer & Tokenek (_design_system.html.erb)  %>
<%# ============================================================================== %>

<!-- 1. Modern Tipográfia: Geist és Geist Mono -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

<style id="bankrepo-design-system">
  :root {
    /* Természetes, meleg sötétszürke színpaletta (steril és kékesfekete helyett) */
    --bg-canvas: #121212;
    --bg-surface: #18181b;
    --bg-elevated: #27272a;
    --bg-subtle: #202024;
    --bg-hover: #2e2e33;

    /* Border-First Finom Kontúrok */
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-medium: rgba(255, 255, 255, 0.14);
    --border-hover: rgba(255, 255, 255, 0.22);
    --border-active: rgba(255, 255, 255, 0.35);

    /* Tipográfiai Színek */
    --text-main: #f4f4f5;
    --text-muted: #a1a1aa;
    --text-dim: #71717a;

    /* Egyetlen Célzott Funkcionális Akcentszín: Meleg Borostyán / Amber */
    --accent: #f59e0b;
    --accent-hover: #d97706;
    --accent-subtle: rgba(245, 158, 11, 0.12);
    --accent-border: rgba(245, 158, 11, 0.35);
    --accent-text: #09090b;

    /* Státusz és Funkcionális Állapotok */
    --success: #10b981;
    --success-subtle: rgba(16, 185, 129, 0.12);
    --success-border: rgba(16, 185, 129, 0.3);

    --danger: #ef4444;
    --danger-subtle: rgba(239, 68, 68, 0.12);
    --danger-border: rgba(239, 68, 68, 0.3);

    --warning: #f59e0b;
    --warning-subtle: rgba(245, 158, 11, 0.12);
    --warning-border: rgba(245, 158, 11, 0.3);

    --info: #0ea5e9;
    --info-subtle: rgba(14, 165, 233, 0.12);
    --info-border: rgba(14, 165, 233, 0.3);

    /* Rendszergazdai tónus (visszafogott, szoftverszerű) */
    --admin-accent: #c084fc;
    --admin-subtle: rgba(192, 132, 252, 0.12);
    --admin-border: rgba(192, 132, 252, 0.3);

    /* Betűkészletek és Méretskála */
    --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    --font-mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    --line-height: 1.55;

    /* Szoftverszerű Kerekítési Skála (4px - 8px) */
    --radius-xs: 3px;
    --radius-sm: 5px;
    --radius-md: 6px;
    --radius-lg: 8px;

    /* Mikro-interakciók (100 - 150ms gyors és precíz átmenetek) */
    --transition-fast: 120ms cubic-bezier(0.16, 1, 0.3, 1);
    --transition-normal: 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Előkészített Világos Téma Tokenek */
  [data-theme="light"] {
    --bg-canvas: #fafaf9;
    --bg-surface: #ffffff;
    --bg-elevated: #f4f4f5;
    --bg-subtle: #f1f1f3;
    --bg-hover: #e4e4e7;

    --border-subtle: rgba(0, 0, 0, 0.08);
    --border-medium: rgba(0, 0, 0, 0.14);
    --border-hover: rgba(0, 0, 0, 0.22);
    --border-active: rgba(0, 0, 0, 0.35);

    --text-main: #18181b;
    --text-muted: #52525b;
    --text-dim: #a1a1aa;

    --accent: #d97706;
    --accent-hover: #b45309;
    --accent-subtle: rgba(217, 119, 6, 0.12);
    --accent-border: rgba(217, 119, 6, 0.35);
    --accent-text: #ffffff;
  }

  /* Globális Alapok */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
  }

  body {
    background-color: var(--bg-canvas);
    color: var(--text-main);
    font-size: 15px;
    line-height: var(--line-height);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    width: 100%;
  }

  /* Monospace segédosztály */
  .font-mono {
    font-family: var(--font-mono) !important;
  }

  /* -------------------------------------------------------------------------- */
  /* Gombok (Button-First, Precíz 120ms állapotváltás)                          */
  /* -------------------------------------------------------------------------- */
  .btn {
    padding: 7px 14px;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    border: 1px solid transparent;
    font-size: 0.88rem;
    line-height: 1.25;
    transition: all var(--transition-fast);
    user-select: none;
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg-canvas), 0 0 0 4px var(--accent);
  }

  /* Elsődleges Funkcionális Gomb (Amber CTA) */
  .btn-primary {
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--accent);
    font-weight: 700;
  }
  .btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  /* Másodlagos Border-first Gomb */
  .btn-secondary {
    background: var(--bg-surface);
    color: var(--text-main);
    border: 1px solid var(--border-subtle);
  }
  .btn-secondary:hover {
    background: var(--bg-elevated);
    border-color: var(--border-hover);
    color: var(--text-main);
  }

  /* Ghost / Minimalista Gomb */
  .btn-ghost {
    background: transparent;
    color: var(--text-muted);
    border-color: transparent;
  }
  .btn-ghost:hover {
    background: var(--bg-elevated);
    color: var(--text-main);
  }

  /* Veszély / Destruktív Gomb */
  .btn-danger {
    background: var(--danger-subtle);
    border: 1px solid var(--danger-border);
    color: #fca5a5;
  }
  .btn-danger:hover {
    background: var(--danger);
    color: #ffffff;
    border-color: var(--danger);
  }

  /* Admin Gomb */
  .btn-admin {
    background: var(--admin-subtle);
    border: 1px solid var(--admin-border);
    color: var(--admin-accent);
  }
  .btn-admin:hover {
    background: var(--admin-accent);
    color: #09090b;
  }

  /* -------------------------------------------------------------------------- */
  /* Kártyák & Panelek (Border-First, Letisztult)                                */
  /* -------------------------------------------------------------------------- */
  .card, .panel {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 20px;
    transition: border-color var(--transition-fast);
  }
  .card-hover:hover {
    border-color: var(--border-hover);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }

  /* -------------------------------------------------------------------------- */
  /* Jelvények & Státuszok (Badges)                                             */
  /* -------------------------------------------------------------------------- */
  .badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
  }
  .badge-live, .badge-active {
    background: var(--success-subtle);
    color: #34d399;
    border-color: var(--success-border);
  }
  .badge-amber, .badge-accent {
    background: var(--accent-subtle);
    color: var(--accent);
    border-color: var(--accent-border);
  }
  .badge-muted, .badge-soon {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    border-color: var(--border-subtle);
  }
  .badge-danger {
    background: var(--danger-subtle);
    color: #f87171;
    border-color: var(--danger-border);
  }
  .badge-admin {
    background: var(--admin-subtle);
    color: var(--admin-accent);
    border-color: var(--admin-border);
  }

  /* -------------------------------------------------------------------------- */
  /* Űrlapok & Beviteli Mezők (Border-First & Finom Fókusz)                    */
  /* -------------------------------------------------------------------------- */
  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .form-control {
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 9px 12px;
    color: var(--text-main);
    font-size: 0.92rem;
    font-family: var(--font-sans);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .form-control:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
  }
  .form-control::placeholder {
    color: var(--text-dim);
  }

  /* -------------------------------------------------------------------------- */
  /* Görgetősáv (Minimalista és Letisztult)                                      */
  /* -------------------------------------------------------------------------- */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.22);
  }
</style>
