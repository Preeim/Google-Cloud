<%# ========================================================================== %>
<%# Bánk's Repository - Központi Kezdőlap & Műszerfal (dashboard/index.html.erb) %>
<%# ========================================================================== %>

<style>
  /* Kezdőlap Jelenlét és Aktivitás Stílusok */
  @keyframes presence-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(16, 185, 129, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
    }
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    display: inline-block;
    animation: presence-pulse 2s infinite ease-out;
  }

  /* Aszimmetrikus Bento-Grid Elrendezés */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }
  .bento-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast);
  }
  .bento-card:hover {
    border-color: var(--border-hover);
  }
  .bento-col-8 { grid-column: span 8; }
  .bento-col-4 { grid-column: span 4; }
  .bento-col-6 { grid-column: span 6; }
  .bento-col-12 { grid-column: span 12; }

  .bento-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .bento-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: -0.01em;
  }

  /* Alkalmazás kártyák listája a Bento Hero panelen */
  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    flex: 1;
  }
  .app-item {
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--transition-fast);
  }
  .app-item:hover {
    border-color: var(--border-hover);
    background: var(--bg-elevated);
  }
  .app-item-icon {
    font-size: 1.6rem;
    line-height: 1;
    margin-bottom: 10px;
  }
  .app-item-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .app-item-desc {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 14px;
    flex: 1;
  }

  /* Online felhasználók kártyái */
  .online-user-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
    position: relative;
  }
  .online-user-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-elevated);
  }
  .online-user-card .avatar-box {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.82rem;
    color: #09090b;
    position: relative;
    flex-shrink: 0;
  }
  .online-user-card .avatar-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--bg-surface);
    background: var(--success);
  }
  .online-user-card .user-info {
    flex: 1;
    min-width: 0;
  }
  .online-user-card .user-name {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .online-user-card .user-status {
    font-size: 0.74rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
  }

  .online-grid-compact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 290px;
    overflow-y: auto;
    padding-right: 2px;
  }

  /* Telemetria mutató sor */
  .telemetry-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 8px;
    font-size: 0.86rem;
  }
  .telemetry-row:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 960px) {
    .bento-col-8, .bento-col-4, .bento-col-6 {
      grid-column: span 12;
    }
  }
</style>

<!-- 1. Fő Üdvözlő Fejléc (Szoftverszerű, Border-first) -->
<div style="margin-bottom: 20px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <div>
      <h1 style="font-size: clamp(1.3rem, 3vw, 1.65rem); font-weight: 700; color: var(--text-main); letter-spacing: -0.02em;">
        Bánk's Repository Hub
      </h1>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 4px; line-height: 1.5;">
        Valós idejű közösségi munkatér, moduláris webalkalmazások és WebSocket telemetria.
      </p>
    </div>
    <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
      <span style="display: inline-flex; align-items: center; gap: 7px; background: var(--bg-surface); border: 1px solid var(--border-subtle); color: var(--text-main); padding: 5px 12px; border-radius: var(--radius-md); font-size: 0.82rem; font-weight: 500;">
        <span class="pulse-indicator"></span>
        <span>Platform: <strong style="color: #34d399;">Online</strong></span>
      </span>
      <% if logged_in? %>
        <a href="<%= app_my_profile_path %>" class="btn btn-secondary" style="font-size: 0.82rem; padding: 5px 12px;">
          <span>👤 Profil</span>
        </a>
      <% end %>
    </div>
  </div>
</div>

<!-- 2. Aszimmetrikus Bento-Grid -->
<div class="bento-grid">

  <!-- A) Kiemelt Modulok Bento Panel (Span 8) -->
  <div class="bento-card bento-col-8">
    <div class="bento-header">
      <div class="bento-title">
        <span>📦</span>
        <span>Elérhető Alkalmazások & Eszközök</span>
      </div>
      <span class="badge badge-amber font-mono">Moduláris Monolit</span>
    </div>

    <div class="apps-grid">
      <% 
        dashboard_apps = (admin? rescue false) ? AppDefinition.order(:name) : AppDefinition.available_to_users.order(:name)
      %>
      <% dashboard_apps.each do |app| %>
        <% 
          app_icon = case app.slug
                     when "chess" then "♟️"
                     when "casino" then "🎰"
                     when "canvas" then "🎨"
                     when "test" then "🛠️"
                     else "📦"
                     end
        %>
        <div class="app-item">
          <div>
            <div class="app-item-icon"><%= app_icon %></div>
            <div class="app-item-title">
              <span><%= app.name %></span>
              <% if app.state_active? %>
                <span class="badge badge-live">Live</span>
              <% else %>
                <span class="badge badge-soon"><%= app.state.upcase %></span>
              <% end %>
            </div>
            <p class="app-item-desc">
              <%= app.description.presence || "Önálló in-app modul valós idejű ActionCable integrációval." %>
            </p>
          </div>
          <div>
            <a href="<%= app.mount_path %>" class="btn btn-primary" style="width: 100%; font-size: 0.86rem; padding: 7px 10px;">
              Megnyitás →
            </a>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- B) Valós Idejű Jelenlét Bento Widget (Span 4) -->
  <div class="bento-card bento-col-4">
    <div class="bento-header">
      <div class="bento-title">
        <span>👥</span>
        <span>Élő Jelenlét</span>
      </div>
      <span id="online-counter-badge" class="badge badge-live font-mono">
        <span id="online-counter"><%= @online_count %></span> online
      </span>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 0.8rem; color: var(--text-muted);">
      <span>Összes tag: <strong style="color: var(--text-main);" class="font-mono"><%= @total_users_count %></strong></span>
      <span id="ws-presence-indicator" style="color: #34d399; display: inline-flex; align-items: center; gap: 5px; font-weight: 500;">
        <span style="width: 5px; height: 5px; border-radius: 50%; background: #34d399;"></span>
        WebSocket Élő
      </span>
    </div>

    <!-- Online Felhasználók Kompakt Rácsa -->
    <div id="online-users-grid" class="online-grid-compact">
      <% if @online_users.any? %>
        <% @online_users.each do |user| %>
          <%= link_to app_user_profile_path(user.id), class: "online-user-card", id: "presence-user-#{user.id}", title: "#{user.effective_name} profilja" do %>
            <div class="avatar-box" style="background: <%= user.custom_avatar_color %>;">
              <%= user.avatar_initials %>
              <span class="avatar-dot"></span>
            </div>
            <div class="user-info">
              <div class="user-name">
                <span><%= user.effective_name %></span>
                <% if user.admin? %>
                  <span class="badge badge-admin" style="font-size: 0.65rem; padding: 1px 4px;">Admin</span>
                <% end %>
              </div>
              <div class="user-status">
                <%= user.custom_status.present? ? "\"#{user.custom_status}\"" : "Épp most aktív" %>
              </div>
            </div>
            <div style="color: var(--accent); font-size: 0.82rem; opacity: 0.7;">→</div>
          <% end %>
        <% end %>
      <% else %>
        <div id="no-online-placeholder" style="padding: 14px; background: var(--bg-subtle); border: 1px dashed var(--border-subtle); border-radius: var(--radius-md); text-align: center; color: var(--text-muted); font-size: 0.84rem;">
          Jelenleg nincs aktív látogató.
          <% if @recent_active_users.any? %>
            <div style="margin-top: 8px; font-size: 0.78rem; color: var(--text-main);">
              Legutóbb aktív:
              <div style="display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; margin-top: 6px;">
                <% @recent_active_users.limit(3).each do |u| %>
                  <%= link_to app_user_profile_path(u.id), style: "color: var(--accent); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; background: var(--bg-elevated); padding: 3px 8px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle);" do %>
                    <span><%= u.effective_name %></span>
                    <span style="color: var(--text-muted); font-size: 0.7rem;">(<%= time_ago_in_words(u.last_seen_at) %>)</span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- C) Telemetria & Teszt Konzol Bento Panel (Span 6) -->
  <div class="bento-card bento-col-6">
    <div class="bento-header">
      <div class="bento-title">
        <span>🛠️</span>
        <span>Action Cable Teszt Konzol</span>
      </div>
      <a href="/test" class="btn btn-secondary" style="font-size: 0.78rem; padding: 4px 8px;">
        Konzol Megnyitása →
      </a>
    </div>
    <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin-bottom: 14px;">
      Valós idejű WebSocket késleltetés mérés, kétirányú ping-pong tesztek és Redis közvetítés ellenőrzése.
    </p>
    <div class="telemetry-row">
      <span style="color: var(--text-muted);">Protokoll:</span>
      <span class="font-mono" style="color: var(--text-main); font-size: 0.82rem;">WSS (Action Cable 7.1)</span>
    </div>
    <div class="telemetry-row">
      <span style="color: var(--text-muted);">Pub/Sub közvetítő:</span>
      <span class="font-mono" style="color: var(--text-main); font-size: 0.82rem;">Redis Production Adapter</span>
    </div>
    <div class="telemetry-row">
      <span style="color: var(--text-muted);">Csatorna feliratkozás:</span>
      <span class="badge badge-live font-mono">PresenceChannel OK</span>
    </div>
  </div>

  <!-- D) Rendszer Architektúra & Biztonság Bento Panel (Span 6) -->
  <div class="bento-card bento-col-6">
    <div class="bento-header">
      <div class="bento-title">
        <span>🛡️</span>
        <span>Rendszer & Biztonsági Központ</span>
      </div>
      <% if admin? %>
        <a href="/bank-admin" class="btn btn-admin" style="font-size: 0.78rem; padding: 4px 8px;">
          Adminisztráció →
        </a>
      <% else %>
        <span class="badge badge-muted font-mono">Monolit v<%= File.read(Rails.root.join("VERSION")).strip rescue "1.9.0" %></span>
      <% end %>
    </div>
    <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin-bottom: 14px;">
      Ubuntu 22.04 LTS VM környezet, Nginx SSL terminálás és Puma alkalmazásszerver automatizált deploy folyamattal.
    </p>
    <div class="telemetry-row">
      <span style="color: var(--text-muted);">Alkalmazás-keretrendszer:</span>
      <span class="font-mono" style="color: var(--text-main); font-size: 0.82rem;">Ruby on Rails 7.1.4</span>
    </div>
    <div class="telemetry-row">
      <span style="color: var(--text-muted);">Adatbázis motor:</span>
      <span class="font-mono" style="color: var(--text-main); font-size: 0.82rem;">MySQL 8.0 Active Record</span>
    </div>
    <div class="telemetry-row">
      <span style="color: var(--text-muted);">Dizájnrendszer:</span>
      <span class="badge badge-amber font-mono">Geist Border-First v2</span>
    </div>
  </div>

</div>

<!-- 3. Valós Idejű WebSocket Jelenlét Kliens (ActionCable PresenceChannel) -->
<script>
  (function() {
    const wsProtocol = window.location.protocol === "https:" ? "wss://" : "ws://";
    const cableUrl = wsProtocol + window.location.host + "/cable";

    const grid = document.getElementById("online-users-grid");
    const counter = document.getElementById("online-counter");
    const wsIndicator = document.getElementById("ws-presence-indicator");

    let socket = null;
    let heartbeatTimer = null;

    function renderUserCard(u) {
      const card = document.createElement("a");
      card.href = u.profile_path || ("/profile/" + u.id);
      card.className = "online-user-card";
      card.id = "presence-user-" + u.id;
      card.title = (u.display_name || u.username) + " profilja";

      const adminBadge = u.role === "admin" ? '<span class="badge badge-admin" style="font-size: 0.65rem; padding: 1px 4px;">Admin</span>' : '';
      const statusText = u.custom_status ? ('"' + escapeHtml(u.custom_status) + '"') : 'Épp most aktív';

      card.innerHTML = `
        <div class="avatar-box" style="background: ${escapeHtml(u.avatar_color || '#f59e0b')};">
          ${escapeHtml(u.avatar_initials || 'U')}
          <span class="avatar-dot"></span>
        </div>
        <div class="user-info">
          <div class="user-name">
            <span>${escapeHtml(u.display_name || u.username)}</span>
            ${adminBadge}
          </div>
          <div class="user-status">${statusText}</div>
        </div>
        <div style="color: var(--accent); font-size: 0.82rem; opacity: 0.7;">→</div>
      `;
      return card;
    }


    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function connectPresence() {
      try {
        socket = new WebSocket(cableUrl);

        socket.onopen = function() {
          const subscribeMsg = JSON.stringify({
            command: "subscribe",
            identifier: JSON.stringify({ channel: "PresenceChannel" })
          });
          socket.send(subscribeMsg);

          if (wsIndicator) {
            wsIndicator.innerHTML = '<span style="width: 6px; height: 6px; border-radius: 50%; background: #34d399;"></span> Élő kapcsolat';
            wsIndicator.style.color = '#34d399';
          }

          // Időzített szívverés küldése (45 másodpercenként)
          if (heartbeatTimer) clearInterval(heartbeatTimer);
          heartbeatTimer = setInterval(function() {
            if (socket && socket.readyState === WebSocket.OPEN) {
              socket.send(JSON.stringify({
                command: "message",
                identifier: JSON.stringify({ channel: "PresenceChannel" }),
                data: JSON.stringify({ action: "appear" })
              }));
            }
          }, 45000);
        };

        socket.onmessage = function(event) {
          try {
            const data = JSON.parse(event.data);

            if (data.type === "ping" || data.type === "welcome" || data.type === "confirm_subscription") {
              return;
            }

            if (data.message) {
              const msg = data.message;

              // 1. Kezdeti állapot átadása
              if (msg.action === "initial_state" && Array.isArray(msg.online_users)) {
                if (counter) counter.innerText = msg.online_count || msg.online_users.length;

                if (msg.online_users.length > 0) {
                  const placeholder = document.getElementById("no-online-placeholder");
                  if (placeholder) placeholder.remove();

                  // Rács frissítése a valós adatokkal
                  grid.innerHTML = "";
                  msg.online_users.forEach(function(u) {
                    grid.appendChild(renderUserCard(u));
                  });
                }
              }

              // 2. Új felhasználó belépése vagy státuszfrissítése
              else if (msg.action === "user_online" || msg.action === "user_updated") {
                if (counter && msg.online_count !== undefined) {
                  counter.innerText = msg.online_count;
                }

                if (msg.user) {
                  const placeholder = document.getElementById("no-online-placeholder");
                  if (placeholder) placeholder.remove();

                  const existing = document.getElementById("presence-user-" + msg.user.id);
                  if (existing) {
                    existing.replaceWith(renderUserCard(msg.user));
                  } else {
                    grid.prepend(renderUserCard(msg.user));
                  }
                }
              }

              // 3. Felhasználó kilépése
              else if (msg.action === "user_offline") {
                if (counter && msg.online_count !== undefined) {
                  counter.innerText = msg.online_count;
                }

                const card = document.getElementById("presence-user-" + msg.user_id);
                if (card) {
                  card.style.opacity = "0.5";
                  setTimeout(function() {
                    card.remove();
                    if (grid.children.length === 0) {
                      grid.innerHTML = '<div id="no-online-placeholder" style="grid-column: 1 / -1; padding: 12px; text-align: center; color: var(--text-muted); font-size: 0.9rem;">Jelenleg nincs aktív látogató a szerveren.</div>';
                    }
                  }, 2000);
                }
              }
            }
          } catch (err) {
            console.warn("Presence message parsing error:", err);
          }
        };

        socket.onclose = function() {
          if (wsIndicator) {
            wsIndicator.innerHTML = '<span style="width: 6px; height: 6px; border-radius: 50%; background: var(--warning);"></span> Újracsatlakozás...';
            wsIndicator.style.color = 'var(--warning)';
          }
          if (heartbeatTimer) clearInterval(heartbeatTimer);
          setTimeout(connectPresence, 4000);
        };

        socket.onerror = function() {
          if (wsIndicator) {
            wsIndicator.innerHTML = '<span style="width: 6px; height: 6px; border-radius: 50%; background: var(--danger);"></span> Hálózati hiba';
            wsIndicator.style.color = 'var(--danger)';
          }
        };
      } catch (err) {
        console.error("Presence connection failed:", err);
      }
    }

    connectPresence();

    document.addEventListener('turbo:before-cache', function() {
      if (heartbeatTimer) clearInterval(heartbeatTimer);
      if (socket) {
        try { socket.close(); } catch(e) {}
      }
    }, { once: true });
  })();
</script>
