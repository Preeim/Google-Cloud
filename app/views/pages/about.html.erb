<div style="max-width: 900px; margin: 0 auto; width: 100%;">
  
  <!-- Fejléc és Breadcrumb -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
    <div>
      <div style="font-size: 0.85rem; color: var(--accent); font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
        <a href="/" style="color: var(--text-muted); text-decoration: none;">Kezdőlap</a>
        <span>/</span>
        <span>Információ</span>
      </div>
      <h1 style="font-size: clamp(1.5rem, 3.5vw, 2rem); font-weight: 800; color: var(--text-main); margin: 0;">
        Impresszum & Kapcsolat
      </h1>
    </div>
    <span style="font-size: 0.8rem; background: var(--bg-elevated); border: 1px solid var(--border-subtle); padding: 4px 10px; border-radius: 6px; color: var(--text-muted);">
      Bánk's Repository • v1.8.0
    </span>
  </div>

  <!-- Fejlesztői Kártya -->
  <div class="card" style="border-color: rgba(56, 189, 248, 0.3); background: linear-gradient(180deg, var(--bg-surface) 0%, rgba(56, 189, 248, 0.03) 100%);">
    <div style="display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap;">
      <div style="width: 64px; height: 64px; border-radius: 50%; background: var(--bg-elevated); border: 2px solid var(--accent); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0;">
        👨‍💻
      </div>
      <div style="flex: 1; min-width: 260px;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 6px;">
          <h2 style="font-size: 1.35rem; font-weight: 800; color: var(--text-main); margin: 0;">Hevesi Bánk</h2>
          <span style="font-size: 0.75rem; background: rgba(56, 189, 248, 0.15); color: var(--accent); border: 1px solid rgba(56, 189, 248, 0.3); padding: 2px 8px; border-radius: 12px; font-weight: 600;">Projekt Készítő & Fejlesztő</span>
        </div>
        <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.5; margin-bottom: 14px;">
          Szoftverfejlesztő, a platform egyéni tervezője és készítője. A Bánk's Repository célja a full-stack Rails ökoszisztéma, az elosztott motorok (Rails Engines) és a valós idejű WebSocket architektúrák bemutatása egy modern felületen.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          <a href="mailto:admin@bankrepo.hu" class="btn btn-primary" style="font-size: 0.86rem;">
            <span>✉️</span> admin@bankrepo.hu
          </a>
          <a href="https://github.com/Preeim/Google-Cloud" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="font-size: 0.86rem;">
            <span>💻</span> GitHub Repository ↗
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Kapcsolat & Elérhetőségek -->
  <div class="card">
    <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 14px; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
      <span>📬</span> Hivatalos Kapcsolattartási Információk
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
      <div style="background: var(--bg-elevated); padding: 14px; border-radius: 8px; border: 1px solid var(--border-subtle);">
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Elsődleges E-mail</div>
        <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main);">
          <a href="mailto:admin@bankrepo.hu" style="color: var(--accent); text-decoration: none;">admin@bankrepo.hu</a>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Általános megkeresések, észrevételek, adattörlés</div>
      </div>

      <div style="background: var(--bg-elevated); padding: 14px; border-radius: 8px; border: 1px solid var(--border-subtle);">
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Webcím (Domain)</div>
        <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main);">
          <a href="https://bankrepo.hu" style="color: var(--accent); text-decoration: none;">bankrepo.hu</a>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Hivatalos production elérhetőség</div>
      </div>

      <div style="background: var(--bg-elevated); padding: 14px; border-radius: 8px; border: 1px solid var(--border-subtle);">
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 4px;">Licencelés</div>
        <div style="font-weight: 600; font-size: 0.95rem; color: var(--text-main);">
          <a href="https://github.com/Preeim/Google-Cloud/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">MIT Licenc</a>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Szabadon felhasználható nyílt forráskód</div>
      </div>
    </div>
  </div>

  <!-- Infrastruktúra & Architektúra -->
  <div class="card">
    <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
      <span>⚙️</span> Rendszerarchitektúra & Infrastruktúra
    </h2>
    <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 14px;">
      A projekt felhőalapú infrastruktúrán, gondosan optimalizált környezetben fut a maximális hatékonyság és stabilitás érdekében:
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;">
      <div style="background: var(--bg-elevated); padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-subtle); font-size: 0.9rem;">
        <strong style="color: var(--text-main);">☁️ Felhő Szolgáltató:</strong>
        <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Google Cloud Platform (Compute Engine)</div>
      </div>
      <div style="background: var(--bg-elevated); padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-subtle); font-size: 0.9rem;">
        <strong style="color: var(--text-main);">🌍 Szerver Régió:</strong>
        <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Nyugat-Európa (Belgium, europe-west1)</div>
      </div>
      <div style="background: var(--bg-elevated); padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-subtle); font-size: 0.9rem;">
        <strong style="color: var(--text-main);">🔒 Biztonság & SSL:</strong>
        <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Nginx Reverse Proxy + Let's Encrypt TLS 1.3</div>
      </div>
      <div style="background: var(--bg-elevated); padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-subtle); font-size: 0.9rem;">
        <strong style="color: var(--text-main);">⚡ Szoftveres Stack:</strong>
        <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Ruby 3.3, Rails 7.1.4, Action Cable, MySQL 8</div>
      </div>
    </div>
  </div>

  <!-- Kapcsolati és Visszanavigálási Blokkoló -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; flex-wrap: wrap; gap: 12px;">
    <a href="/" class="btn btn-secondary">
      <span>⬅</span> Vissza a Főoldalra
    </a>
    <div style="display: flex; gap: 10px;">
      <%= link_to "Feltételek & Felelősségkizárás ➔", terms_path, class: "btn btn-secondary" %>
      <%= link_to "Adatkezelési Tájékoztató ➔", privacy_path, class: "btn btn-primary" %>
    </div>
  </div>

</div>
