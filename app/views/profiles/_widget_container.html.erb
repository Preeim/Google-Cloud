<%# Widget Külső Keret Konténer (Dinamikus Kártya) %>
<div class="card profile-widget-card" style="<%= 'grid-column: span 2;' if widget.column_span > 1 %>">
  <div class="widget-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 1.4rem;"><%= widget.icon %></span>
      <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin: 0;">
        <%= widget.title %>
      </h3>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;">
      <% if widget.owner_only? %>
        <span class="badge" style="background: rgba(168, 85, 247, 0.15); border: 1px solid var(--admin-accent); color: var(--admin-accent);">
          🔒 Privát panel
        </span>
      <% else %>
        <span class="badge" style="background: rgba(56, 189, 248, 0.15); border: 1px solid var(--accent); color: var(--accent);">
          🌐 Publikus
        </span>
      <% end %>
    </div>
  </div>

  <div class="widget-content">
    <%= yield %>
  </div>
</div>

