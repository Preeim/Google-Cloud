<%# Profil Szerkesztése Modal / Panel %>
<div id="profile-edit-modal" class="drawer-backdrop" style="display: none; justify-content: center; align-items: center; padding: 20px; z-index: 10000; opacity: 1; pointer-events: auto;">
  <div class="card" style="max-width: 520px; width: 100%; background: var(--bg-surface); border: 1px solid var(--border-hover); border-radius: 12px; box-shadow: 0 16px 36px rgba(0,0,0,0.7); position: relative; max-height: 90vh; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px;">
      <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 8px;">
        <span>✏️</span> Profil Adatok Szerkesztése
      </h3>
      <button type="button" id="btn-close-profile-modal" style="background: transparent; border: none; color: var(--text-muted); font-size: 1.6rem; cursor: pointer; line-height: 1;">&times;</button>
    </div>

    <%= form_with model: user, url: user == current_user ? update_my_profile_path : update_user_profile_path(user.id), method: :patch, local: true do |f| %>
      <div class="form-group" style="margin-bottom: 16px;">
        <%= f.label :display_name, "Megjelenített Név (Display Name)", style: "display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 600;" %>
        <%= f.text_field :display_name, value: user.display_name, class: "form-control", placeholder: "pl. Bánk Vezér", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
        <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px; display: block;">Ha kitöltöd, a felhasználónév helyett ez a név fog megjelenni a felületen.</span>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <%= f.label :custom_status, "Egyéni Állapotüzenet (Status Quote)", style: "display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 600;" %>
        <%= f.text_field :custom_status, value: user.custom_status, class: "form-control", placeholder: "pl. Sakkpartit keresek | 10k chips a cél!", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <%= f.label :avatar_color, "Avatar Színkód (Hex)", style: "display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 600;" %>
        <div style="display: flex; gap: 10px; align-items: center;">
          <%= f.color_field :avatar_color, value: user.custom_avatar_color, style: "width: 48px; height: 42px; border: 1px solid var(--border-subtle); border-radius: 6px; background: transparent; cursor: pointer;" %>
          <%= f.text_field :avatar_color, value: user.custom_avatar_color, id: "avatar-color-input", class: "form-control", style: "flex: 1; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <%= f.label :bio, "Rövid Bemutatkozás (Bio)", style: "display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 600;" %>
        <%= f.text_area :bio, value: user.bio, rows: 4, class: "form-control", placeholder: "Írj pár sort magadról, stratégiádról vagy játékaidról...", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem; resize: vertical;" %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" id="btn-cancel-profile-modal" class="btn btn-secondary">Mégse</button>
        <%= f.submit "Módosítások Mentése", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    const modal = document.getElementById('profile-edit-modal');
    const openBtn = document.getElementById('btn-open-profile-edit');
    const closeBtn = document.getElementById('btn-close-profile-modal');
    const cancelBtn = document.getElementById('btn-cancel-profile-modal');
    const colorPicker = document.querySelector('input[type="color"][name="user[avatar_color]"]');
    const colorInput = document.getElementById('avatar-color-input');

    if (colorPicker && colorInput) {
      colorPicker.addEventListener('input', function(e) {
        colorInput.value = e.target.value;
      });
      colorInput.addEventListener('input', function(e) {
        if (/^#[0-9A-Fa-f]{6}$/.test(e.target.value)) {
          colorPicker.value = e.target.value;
        }
      });
    }

    function openModal() {
      if (!modal) return;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) closeModal();
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
        closeModal();
      }
    });
  })();
</script>

