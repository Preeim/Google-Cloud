<%# ========================================================================== %>
<%# Bánk's Repository - Profil Szerkesztése Modal (profiles/_edit_modal.html.erb) %>
<%# ========================================================================== %>

<style>
  .profile-modal-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(10, 15, 29, 0.85) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 100000 !important;
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out;
  }
  .profile-modal-overlay.open {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
  }
  .profile-modal-card {
    max-width: 520px;
    width: 100%;
    background: var(--bg-surface, #11192e);
    border: 1px solid var(--border-hover, #38bdf8);
    border-radius: 14px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 25px rgba(56, 189, 248, 0.15);
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px;
    transform: scale(0.95);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .profile-modal-overlay.open .profile-modal-card {
    transform: scale(1);
  }
</style>

<div id="profile-edit-modal" class="profile-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="profile-modal-title">
  <div class="profile-modal-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-subtle, rgba(255,255,255,0.08)); padding-bottom: 12px;">
      <h3 id="profile-modal-title" style="font-size: 1.25rem; font-weight: 700; color: var(--text-main, #f8fafc); margin: 0; display: flex; align-items: center; gap: 8px;">
        <span>✏️</span> Profil Adatok Szerkesztése
      </h3>
      <button type="button" id="btn-close-profile-modal" style="background: transparent; border: none; color: var(--text-muted, #94a3b8); font-size: 1.6rem; cursor: pointer; line-height: 1;" title="Bezárás">&times;</button>
    </div>

    <%= form_with model: user, url: user == current_user ? update_my_profile_path : update_user_profile_path(user.id), method: :patch, local: true do |f| %>
      <div class="form-group" style="margin-bottom: 16px;">
        <%= f.label :display_name, "Megjelenített Név (Display Name)", style: "display: block; font-size: 0.88rem; color: var(--text-muted, #94a3b8); margin-bottom: 6px; font-weight: 600;" %>
        <%= f.text_field :display_name, value: user.display_name, class: "form-control", placeholder: "pl. Bánk Vezér", style: "width: 100%; box-sizing: border-box; background: var(--bg-elevated, #16223e); border: 1px solid var(--border-subtle, rgba(255,255,255,0.1)); border-radius: 8px; padding: 10px 14px; color: var(--text-main, #f8fafc); font-size: 0.95rem;" %>
        <span style="font-size: 0.78rem; color: var(--text-muted, #94a3b8); margin-top: 4px; display: block;">Ha kitöltöd, a felhasználónév helyett ez a név fog megjelenni a felületen.</span>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <%= f.label :custom_status, "Egyéni Állapotüzenet (Status Quote)", style: "display: block; font-size: 0.88rem; color: var(--text-muted, #94a3b8); margin-bottom: 6px; font-weight: 600;" %>
        <%= f.text_field :custom_status, value: user.custom_status, class: "form-control", placeholder: "pl. Sakkpartit keresek | 10k chips a cél!", style: "width: 100%; box-sizing: border-box; background: var(--bg-elevated, #16223e); border: 1px solid var(--border-subtle, rgba(255,255,255,0.1)); border-radius: 8px; padding: 10px 14px; color: var(--text-main, #f8fafc); font-size: 0.95rem;" %>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <%= f.label :avatar_color, "Avatar Színkód (Hex)", style: "display: block; font-size: 0.88rem; color: var(--text-muted, #94a3b8); margin-bottom: 6px; font-weight: 600;" %>
        <div style="display: flex; gap: 10px; align-items: center;">
          <%= f.color_field :avatar_color, value: user.custom_avatar_color, id: "avatar-color-picker", style: "width: 48px; height: 42px; border: 1px solid var(--border-subtle, rgba(255,255,255,0.1)); border-radius: 8px; background: transparent; cursor: pointer; padding: 2px;" %>
          <%= f.text_field :avatar_color, value: user.custom_avatar_color, id: "avatar-color-input", class: "form-control", style: "flex: 1; box-sizing: border-box; background: var(--bg-elevated, #16223e); border: 1px solid var(--border-subtle, rgba(255,255,255,0.1)); border-radius: 8px; padding: 10px 14px; color: var(--text-main, #f8fafc); font-size: 0.95rem;" %>
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 20px;">
        <%= f.label :bio, "Rövid Bemutatkozás (Bio)", style: "display: block; font-size: 0.88rem; color: var(--text-muted, #94a3b8); margin-bottom: 6px; font-weight: 600;" %>
        <%= f.text_area :bio, value: user.bio, rows: 4, class: "form-control", placeholder: "Írj pár sort magadról, stratégiádról vagy játékaidról...", style: "width: 100%; box-sizing: border-box; background: var(--bg-elevated, #16223e); border: 1px solid var(--border-subtle, rgba(255,255,255,0.1)); border-radius: 8px; padding: 10px 14px; color: var(--text-main, #f8fafc); font-size: 0.95rem; resize: vertical;" %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <button type="button" id="btn-cancel-profile-modal" class="btn btn-secondary">Mégse</button>
        <%= f.submit "Módosítások Mentése", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function() {
    function initProfileModal() {
      const modal = document.getElementById('profile-edit-modal');
      const openBtn = document.getElementById('btn-open-profile-edit');
      const closeBtn = document.getElementById('btn-close-profile-modal');
      const cancelBtn = document.getElementById('btn-cancel-profile-modal');
      const colorPicker = document.getElementById('avatar-color-picker');
      const colorInput = document.getElementById('avatar-color-input');

      if (!modal) return;

      if (colorPicker && colorInput) {
        colorPicker.oninput = function(e) {
          colorInput.value = e.target.value;
        };
        colorInput.oninput = function(e) {
          if (/^#[0-9A-Fa-f]{6}$/.test(e.target.value)) {
            colorPicker.value = e.target.value;
          }
        };
      }

      function openModal() {
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
        const firstInput = modal.querySelector('input[name="user[display_name]"]');
        if (firstInput) setTimeout(() => firstInput.focus(), 50);
      }

      function closeModal() {
        modal.classList.remove('open');
        document.body.style.overflow = '';
      }

      if (openBtn) {
        openBtn.onclick = openModal;
      }
      // Globális delegáció a biztonságos Turbo és dinamikus kattintáskezeléshez
      document.addEventListener('click', function(e) {
        const trigger = e.target.closest('#btn-open-profile-edit');
        if (trigger) {
          e.preventDefault();
          openModal();
        }
      });
      if (closeBtn) {
        closeBtn.onclick = closeModal;
      }
      if (cancelBtn) {
        cancelBtn.onclick = closeModal;
      }

      modal.onclick = function(e) {
        if (e.target === modal) closeModal();
      };

      document.onkeydown = function(e) {
        if (e.key === 'Escape' && modal.classList.contains('open')) {
          closeModal();
        }
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProfileModal);
    } else {
      initProfileModal();
    }
    document.addEventListener('turbo:load', initProfileModal);
    document.addEventListener('turbo:render', initProfileModal);
  })();
</script>

