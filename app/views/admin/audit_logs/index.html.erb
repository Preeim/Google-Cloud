<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--text-main);">Biztonsági Audit Napló</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Változtathatatlan eseménynapló adminisztrátori döntésekről és zárolásokról</p>
  </div>
</div>

<div class="card">
  <table class="responsive-table">
    <thead>
      <tr>
        <th>Időpont</th>
        <th>Esemény / Művelet</th>
        <th>Aktor (Kezdeményező)</th>
        <th>Célpont Felhasználó</th>
        <th>IP Cím</th>
        <th>Részletek (Metadata)</th>
      </tr>
    </thead>
    <tbody>
      <% if @audit_logs.empty? %>
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 32px;">Még nincs rögzített esemény az audit naplóban.</td>
        </tr>
      <% else %>
        <% @audit_logs.each do |log| %>
          <tr>
            <td data-label="Időpont" style="color: var(--text-muted); font-size: 0.85rem;">
              <%= log.created_at.strftime("%Y.%m.%d %H:%M:%S") %>
            </td>
            <td data-label="Művelet"><code><%= log.action %></code></td>
            <td data-label="Aktor">
              <% if log.actor %>
                <strong><%= log.actor.username %></strong>
              <% else %>
                <span style="color: var(--text-muted);">Rendszer / Automata</span>
              <% end %>
            </td>
            <td data-label="Célpont">
              <% if log.target_user %>
                <%= log.target_user.username %>
              <% else %>
                <span style="color: var(--text-muted);">-</span>
              <% end %>
            </td>
            <td data-label="IP Cím"><code><%= log.ip_address || "-" %></code></td>
            <td data-label="Metadata">
              <% if log.metadata_payload.present? %>
                <pre style="margin: 0; font-size: 0.78rem; background: var(--bg-elevated); padding: 4px 8px; border-radius: 4px; max-width: 100%; overflow-x: auto; color: var(--text-muted);"><%= log.metadata_payload.to_json %></pre>
              <% else %>
                <span style="color: var(--text-muted);">-</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>

