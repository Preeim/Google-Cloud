<div style="max-width: 600px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="/bank-admin/apps" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">← Vissza az Alkalmazásokhoz</a>
    <h1 style="font-size: 1.5rem; font-weight: 700; margin-top: 8px;">Modul Beállításai: <%= @app.name %></h1>
  </div>

  <div class="card">
    <%= form_with model: [:admin, @app], local: true do |f| %>
      <div class="form-group">
        <label for="app_definition_name">Alkalmazás Megjelenített Neve</label>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <div class="form-group">
        <label for="app_definition_description">Rövid Leírás</label>
        <%= f.text_area :description, rows: 3, class: "form-control" %>
      </div>

      <div class="form-group">
        <label for="app_definition_state">Elérhetőségi Státusz</label>
        <%= f.select :state, [
          ["Aktív - Minden jogosult felhasználó elérheti", "active"],
          ["Karbantartás alatt - Csak adminisztrátorok érhetik el", "maintenance"],
          ["Letiltva - Teljesen kikapcsolva", "disabled"],
          ["Csak Adminisztrátoroknak", "admin_only"]
        ], {}, class: "form-control" %>
      </div>

      <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-top: 14px;">
        <%= f.check_box :requires_login, id: "requires_login", style: "width: 18px; height: 18px;" %>
        <label for="requires_login" style="margin-bottom: 0; cursor: pointer;">
          <strong>Bejelentkezés kötelező</strong> (Ha nincs bepipálva, vendégek is használhatják kidobás nélkül)
        </label>
      </div>

      <div class="form-group" style="display: flex; align-items: center; gap: 10px; margin-top: 10px;">
        <%= f.check_box :is_default_accessible, id: "is_default_accessible", style: "width: 18px; height: 18px;" %>
        <label for="is_default_accessible" style="margin-bottom: 0; cursor: pointer;">Minden regisztrált felhasználó alapértelmezetten elérheti</label>
      </div>

      <div style="display: flex; gap: 12px; margin-top: 24px;">
        <%= f.submit "Beállítások Mentése", class: "btn btn-admin", style: "flex: 1;" %>
        <a href="/bank-admin/apps" class="btn btn-secondary">Mégse</a>
      </div>
    <% end %>
  </div>
</div>

