<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--text-main);">Beépülő Modulok & Alkalmazások</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Modulok státusza (pl. Sakk karbantartási mód), hozzáférési beállítások</p>
  </div>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Modul Neve</th>
        <th>Azonosító (Slug)</th>
        <th>Csatolási Útvonal</th>
        <th>Elérhetőségi Státusz</th>
        <th>Alapértelmezett Elérés</th>
        <th style="text-align: right;">Műveletek</th>
      </tr>
    </thead>
    <tbody>
      <% @apps.each do |app| %>
        <tr>
          <td><strong><%= app.name %></strong></td>
          <td><code><%= app.slug %></code></td>
          <td><code><%= app.mount_path %></code></td>
          <td>
            <span class="tag <%= app.state == 'active' ? 'tag-active' : (app.state == 'maintenance' ? 'tag-locked' : 'tag-user') %>">
              <%= app.state.upcase %>
            </span>
          </td>
          <td>
            <%= app.is_default_accessible? ? "✓ Minden tagnak engedélyezett" : "🔒 Egyéni engedélyhez kötött" %>
          </td>
          <td style="text-align: right;">
            <a href="/bank-admin/apps/<%= app.id %>/edit" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.8rem;">Státusz Módosítása</a>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

