<div style="max-width: 600px; margin: 0 auto;">
  <div style="margin-bottom: 20px;">
    <a href="/bank-admin/users" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">← Vissza a Felhasználókhoz</a>
    <h1 style="font-size: 1.5rem; font-weight: 700; margin-top: 8px;">Felhasználó Szerkesztése: <%= @user.username %></h1>
  </div>

  <div class="card">
    <%= form_with model: [:admin, @user], local: true do |f| %>
      <div class="form-group">
        <label>Felhasználónév</label>
        <input type="text" value="<%= @user.username %>" class="form-control" disabled style="opacity: 0.7;">
      </div>

      <div class="form-group">
        <label>E-mail Cím</label>
        <input type="text" value="<%= @user.email %>" class="form-control" disabled style="opacity: 0.7;">
      </div>

      <div class="form-group">
        <label for="user_role">Szerepkör (RBAC)</label>
        <%= f.select :role, [["Felhasználó (user)", "user"], ["Moderátor (moderator)", "moderator"], ["Adminisztrátor (admin)", "admin"]], {}, class: "form-control" %>
      </div>

      <div class="form-group">
        <label for="user_status">Fiók Státusza</label>
        <%= f.select :status, [["Aktív (active)", "active"], ["Felfüggesztett / Tiltott (suspended)", "suspended"], ["Függőben (pending)", "pending"]], {}, class: "form-control" %>
      </div>

      <div style="display: flex; gap: 12px; margin-top: 24px;">
        <%= f.submit "Módosítások Mentése", class: "btn btn-admin", style: "flex: 1;" %>
        <a href="/bank-admin/users" class="btn btn-secondary">Mégse</a>
      </div>
    <% end %>
  </div>
</div>

