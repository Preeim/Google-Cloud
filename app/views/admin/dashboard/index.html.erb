<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--text-main);">Rendszeráttekintés & Állapot</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Platform telemetria és gyors statisztikák (bankrepo.hu)</p>
  </div>
  <div>
    <a href="/bank-admin/server_metrics" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; transition: transform 0.15s;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='none'">
      <span style="width: 8px; height: 8px; background: var(--success); border-radius: 50%;"></span>
      Szerver Telemetria & Monitorozás (Élő) →
    </a>
  </div>
</div>

<%# Statisztikai Kártyák Rács %>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 28px;">
  <div class="card" style="margin-bottom: 0;">
    <div style="color: var(--text-muted); font-size: 0.82rem; text-transform: uppercase; font-weight: 700;">Regisztrált Tagok</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--text-main); margin-top: 8px;"><%= @total_users_count %></div>
    <div style="font-size: 0.85rem; color: var(--success); margin-top: 4px;">✓ <%= @active_users_count %> aktív állapotú</div>
  </div>

  <div class="card" style="margin-bottom: 0;">
    <div style="color: var(--text-muted); font-size: 0.82rem; text-transform: uppercase; font-weight: 700;">Zárolt Fiókok</div>
    <div style="font-size: 2rem; font-weight: 800; color: <%= @locked_users_count > 0 ? 'var(--danger)' : 'var(--text-main)' %>; margin-top: 8px;"><%= @locked_users_count %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Brute-force védelem által</div>
  </div>

  <div class="card" style="margin-bottom: 0;">
    <div style="color: var(--text-muted); font-size: 0.82rem; text-transform: uppercase; font-weight: 700;">Aktív Munkamenetek</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-blue); margin-top: 8px;"><%= @active_sessions_count %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Eszközök online</div>
  </div>

  <div class="card" style="margin-bottom: 0;">
    <div style="color: var(--text-muted); font-size: 0.82rem; text-transform: uppercase; font-weight: 700;">Beépülő Modulok</div>
    <div style="font-size: 2rem; font-weight: 800; color: var(--admin-accent); margin-top: 8px;"><%= @apps.count %></div>
    <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Sakk és további eszközök</div>
  </div>
</div>

<%# Modulok Gyorsnézet és Legutóbbi Audit %>
<%# Modulok Gyorsnézet és Legutóbbi Audit %>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 20px;">
  <div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 1.1rem; font-weight: 700;">Regisztrált Alkalmazások</h2>
      <a href="/bank-admin/apps" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 10px;">Kezelés</a>
    </div>
    <table class="responsive-table">
      <thead>
        <tr>
          <th>Modul Neve</th>
          <th>Csatolási Útvonal</th>
          <th>Státusz</th>
        </tr>
      </thead>
      <tbody>
        <% @apps.each do |app| %>
          <tr>
            <td data-label="Modul"><strong><%= app.name %></strong></td>
            <td data-label="Útvonal"><code><%= app.mount_path %></code></td>
            <td data-label="Státusz">
              <span class="tag <%= app.state == 'active' ? 'tag-active' : 'tag-locked' %>">
                <%= app.state.upcase %>
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 1.1rem; font-weight: 700;">Legutóbbi Biztonsági Események</h2>
      <a href="/bank-admin/audit_logs" class="btn btn-secondary" style="font-size: 0.8rem; padding: 4px 10px;">Összes Napló</a>
    </div>
    <table class="responsive-table">
      <thead>
        <tr>
          <th>Idő</th>
          <th>Esemény</th>
          <th>Aktor / Célpont</th>
        </tr>
      </thead>
      <tbody>
        <% if @recent_audit_logs.empty? %>
          <tr>
            <td colspan="3" style="text-align: center; color: var(--text-muted);">Még nincs rögzített audit esemény.</td>
          </tr>
        <% else %>
          <% @recent_audit_logs.each do |log| %>
            <tr>
              <td data-label="Idő" style="color: var(--text-muted); font-size: 0.85rem;"><%= log.created_at.strftime("%H:%M:%S") %></td>
              <td data-label="Esemény"><code><%= log.action %></code></td>
              <td data-label="Aktor"><%= log.actor&.username || "Rendszer" %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

