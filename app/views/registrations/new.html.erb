<div style="max-width: 440px; margin: 40px auto; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 28px;">
  <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 8px;">Új Fiók Regisztrációja</h2>
  <p style="color: var(--text-muted); font-size: 0.92rem; margin-bottom: 24px;">Hozz létre egy fiókot a Bánk's Repository modulok használatához.</p>

  <%= form_with model: @user, url: register_path, local: true do |f| %>
    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px; color: var(--text-muted);">Felhasználónév</label>
      <%= f.text_field :username, required: true, autofocus: true, placeholder: "pl. sakk_mester", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px; color: var(--text-muted);">E-mail Cím</label>
      <%= f.email_field :email, required: true, placeholder: "pelda@domain.hu", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px; color: var(--text-muted);">Jelszó (legalább 8 karakter)</label>
      <%= f.password_field :password, required: true, placeholder: "••••••••", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 22px;">
      <label style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px; color: var(--text-muted);">Jelszó Megerősítése</label>
      <%= f.password_field :password_confirmation, required: true, placeholder: "••••••••", style: "width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem;" %>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 11px; font-size: 0.95rem;">Fiók Létrehozása</button>
  <% end %>

  <div style="margin-top: 20px; text-align: center; font-size: 0.88rem; color: var(--text-muted);">
    Már van fiókod? <%= link_to "Jelentkezz be itt", login_path, style: "color: var(--accent); font-weight: 600; text-decoration: none;" %>
  </div>
</div>
