<div style="max-width: 440px; margin: 40px auto; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 28px;">
  <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 8px;">Create an Account</h2>
  <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 24px;">Register a new user in the MySQL database.</p>

  <%= form_with model: @user, url: register_path, local: true do |f| %>
    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; color: var(--text-main);">Username</label>
      <%= f.text_field :username, required: true, autofocus: true, placeholder: "e.g. h_gaborbank", style: "width: 100%; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 10px 14px; color: white; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; color: var(--text-main);">Email Address</label>
      <%= f.email_field :email, required: true, placeholder: "you@example.com", style: "width: 100%; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 10px 14px; color: white; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; color: var(--text-main);">Password (min. 6 characters)</label>
      <%= f.password_field :password, required: true, placeholder: "••••••••", style: "width: 100%; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 10px 14px; color: white; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 22px;">
      <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; color: var(--text-main);">Confirm Password</label>
      <%= f.password_field :password_confirmation, required: true, placeholder: "••••••••", style: "width: 100%; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 10px 14px; color: white; font-size: 0.95rem;" %>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1rem;">Create Account</button>
  <% end %>

  <div style="margin-top: 20px; text-align: center; font-size: 0.9rem; color: var(--text-muted);">
    Already have an account? <%= link_to "Sign in here", login_path, style: "color: var(--accent); font-weight: 600; text-decoration: none;" %>
  </div>
</div>
