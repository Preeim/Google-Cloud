<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Google Cloud App Hub</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    :root {
      --bg-dark: #0f172a;
      --card-bg: #1e293b;
      --card-border: #334155;
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --success: #10b981;
      --danger: #ef4444;
      --warning: #f59e0b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    body { background-color: var(--bg-dark); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; }
    
    /* Top Header */
    header { background: #111827; border-bottom: 1px solid var(--card-border); padding: 14px 28px; display: flex; justify-content: space-between; align-items: center; }
    .brand { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 1.25rem; color: var(--text-main); text-decoration: none; }
    .brand span { color: var(--accent); }
    .user-nav { display: flex; align-items: center; gap: 16px; font-size: 0.95rem; }
    .btn { padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; cursor: pointer; border: none; font-size: 0.9rem; transition: all 0.2s; }
    .btn-primary { background: var(--accent); color: #0f172a; }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-secondary { background: #334155; color: var(--text-main); }
    .btn-secondary:hover { background: #475569; }
    .btn-danger { background: var(--danger); color: white; }
    .btn-danger:hover { opacity: 0.9; }

    /* Flash Messages */
    .flash-container { max-width: 1200px; margin: 16px auto 0; padding: 0 20px; width: 100%; }
    .flash-notice { background: rgba(16, 185, 129, 0.2); border: 1px solid var(--success); color: #34d399; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; }
    .flash-alert { background: rgba(239, 68, 68, 0.2); border: 1px solid var(--danger); color: #f87171; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; }

    /* Main App Layout */
    .app-container { display: flex; flex: 1; max-width: 1300px; margin: 20px auto; width: 100%; padding: 0 20px; gap: 24px; }
    
    /* Sidebar */
    aside { width: 250px; flex-shrink: 0; }
    .sidebar-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 20px; }
    .sidebar-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 14px; font-weight: 700; }
    .nav-list { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .nav-item a { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 8px; color: var(--text-main); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: background 0.15s; }
    .nav-item a:hover, .nav-item.active a { background: #334155; color: var(--accent); }
    .badge { font-size: 0.75rem; padding: 2px 8px; border-radius: 12px; font-weight: 600; margin-left: auto; }
    .badge-live { background: rgba(16, 185, 129, 0.2); color: var(--success); border: 1px solid var(--success); }
    .badge-soon { background: rgba(148, 163, 184, 0.2); color: var(--text-muted); }

    /* Main Content Frame */
    main { flex: 1; min-width: 0; }
  </style>
</head>
<body>
  <header>
    <a href="/" class="brand">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Google Cloud <span>App Hub</span>
    </a>
    <div class="user-nav">
      <% if logged_in? %>
        <span>Logged in as <strong><%= current_user.username %></strong></span>
        <%= link_to "Sign Out", logout_path, class: "btn btn-secondary", method: :delete %>
      <% else %>
        <%= link_to "Sign In", login_path, class: "btn btn-secondary" %>
        <%= link_to "Register", register_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </header>

  <div class="flash-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
  </div>

  <div class="app-container">
    <aside>
      <div class="sidebar-card">
        <div class="sidebar-title">Application Menu</div>
        <ul class="nav-list">
          <li class="nav-item active">
            <a href="/">
              <span>🛠️ Test Console</span>
              <span class="badge badge-live">Live</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="#chess" onclick="alert('The Chess App will be mounted here next!'); return false;">
              <span>♟️ Chess App</span>
              <span class="badge badge-soon">Next</span>
            </a>
          </li>
          <li class="nav-item">
            <a href="#settings" onclick="alert('Account settings.'); return false;">
              <span>⚙️ Settings</span>
            </a>
          </li>
        </ul>
      </div>
    </aside>

    <main>
      <%= yield %>
    </main>
  </div>
</body>
</html>
