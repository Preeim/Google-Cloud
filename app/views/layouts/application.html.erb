<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.3/app/assets/javascripts/actioncable.js"></script>
  <style>
    :root {
      /* Deep Dark Palette - Kifejezetten NEM tiszta fekete (#000000) */
      --bg-canvas: #0a0f1d;
      --bg-surface: #11192e;
      --bg-elevated: #1a243b;
      --border-subtle: #23304d;
      --border-hover: #3b4b73;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      
      /* Akcentusok és funkcionális színek */
      --accent: #38bdf8;
      --accent-hover: #0284c7;
      --accent-indigo: #6366f1;
      --admin-accent: #a855f7;
      --admin-accent-hover: #9333ea;
      --success: #10b981;
      --danger: #f43f5e;
      --warning: #f59e0b;
    }
    
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    body { background-color: var(--bg-canvas); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; width: 100%; }
    
    /* Felső Navigációs Sáv (Sticky Top Header) */
    header.platform-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
    }
    .brand { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 1.2rem; color: var(--text-main); text-decoration: none; }
    .brand span { color: var(--accent); }
    
    .nav-center { display: flex; align-items: center; gap: 18px; }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 0.15s; }
    .nav-link:hover, .nav-link.active { color: var(--accent); }
    
    .user-nav { display: flex; align-items: center; gap: 14px; font-size: 0.92rem; }
    
    /* Gombok */
    .btn { padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer; border: none; font-size: 0.88rem; transition: all 0.2s; }
    .btn-primary { background: var(--accent); color: #0a0f1d; font-weight: 700; }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-secondary { background: var(--bg-elevated); color: var(--text-main); border: 1px solid var(--border-subtle); }
    .btn-secondary:hover { border-color: var(--border-hover); background: #222f4c; }
    .btn-admin { background: rgba(168, 85, 247, 0.15); border: 1px solid var(--admin-accent); color: var(--admin-accent); }
    .btn-admin:hover { background: var(--admin-accent); color: white; }
    .btn-danger { background: rgba(244, 63, 94, 0.2); border: 1px solid var(--danger); color: #fb7185; }
    .btn-danger:hover { background: var(--danger); color: white; }

    /* Flash Értesítések */
    .flash-container { max-width: 1300px; margin: 16px auto 0; padding: 0 20px; width: 100%; }
    .flash-notice { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; }
    .flash-alert { background: rgba(244, 63, 94, 0.15); border: 1px solid var(--danger); color: #fb7185; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; }

    /* Fő Alkalmazás Keret (Sidebar + Stage) */
    .app-container { display: flex; flex: 1; max-width: 1300px; margin: 20px auto; width: 100%; padding: 0 20px; gap: 24px; }
    
    /* Oldalsáv (Sidebar) */
    aside { width: 240px; flex-shrink: 0; }
    .sidebar-card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 18px; }
    .sidebar-title { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 12px; font-weight: 700; }
    .nav-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .nav-item a { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; color: var(--text-main); text-decoration: none; font-weight: 500; font-size: 0.92rem; transition: all 0.15s; }
    .nav-item a:hover { background: var(--bg-elevated); color: var(--accent); }
    .nav-item.active a { background: var(--bg-elevated); color: var(--accent); border-left: 3px solid var(--accent); }
    .badge { font-size: 0.72rem; padding: 2px 7px; border-radius: 10px; font-weight: 600; margin-left: auto; }
    .badge-live { background: rgba(16, 185, 129, 0.15); color: var(--success); border: 1px solid var(--success); }
    .badge-soon { background: rgba(148, 163, 184, 0.15); color: var(--text-muted); }
    .badge-admin { background: rgba(168, 85, 247, 0.2); color: var(--admin-accent); border: 1px solid var(--admin-accent); }

    /* Központi Színpad & Kártyák */
    main { flex: 1; min-width: 0; }
    .card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 22px; margin-bottom: 20px; }

    /* Űrlap elemek */
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500; }
    .form-control { width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem; }
    .form-control:focus { outline: none; border-color: var(--accent); }

    /* Mobil Hamburger Gomb & Drawer */
    .mobile-nav-toggle {
      display: none;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 8px 10px;
      color: var(--text-main);
      cursor: pointer;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }
    .mobile-nav-toggle:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .drawer-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(10, 15, 29, 0.75);
      backdrop-filter: blur(4px);
      z-index: 999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    .drawer-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -340px;
      width: 85vw;
      max-width: 320px;
      height: 100%;
      background: var(--bg-surface);
      border-left: 1px solid var(--border-subtle);
      z-index: 1000;
      display: flex;
      flex-direction: column;
      box-shadow: -8px 0 24px rgba(0, 0, 0, 0.6);
      transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
    }
    .mobile-drawer.open {
      right: 0;
    }
    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-subtle);
    }
    .drawer-close-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: 6px;
      transition: all 0.15s;
    }
    .drawer-close-btn:hover {
      color: var(--text-main);
      background: var(--bg-elevated);
    }
    .drawer-content {
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      flex: 1;
    }
    .drawer-section-title {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
      margin-bottom: 10px;
      font-weight: 700;
    }
    .drawer-nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .drawer-nav-list a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      border-radius: 8px;
      color: var(--text-main);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.95rem;
      background: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      transition: all 0.15s;
    }
    .drawer-nav-list a:hover, .drawer-nav-list a.active {
      border-color: var(--accent);
      color: var(--accent);
      background: var(--bg-elevated);
    }
    .drawer-user-box {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* Mobil Reszponzív Töréspontok */
    @media (max-width: 768px) {
      header.platform-header {
        padding: 10px 16px;
      }
      .brand {
        font-size: 1.05rem;
      }
      .nav-center, .user-nav {
        display: none;
      }
      .mobile-nav-toggle {
        display: inline-flex;
      }
      .app-container {
        flex-direction: column;
        padding: 0 14px;
        margin: 14px auto;
        gap: 16px;
      }
      aside {
        display: none; /* A navigáció a mobil drawerbe költözik */
      }
      .flash-container {
        padding: 0 14px;
        margin: 12px auto 0;
      }
      .card {
        padding: 16px;
        border-radius: 10px;
      }
      .btn {
        padding: 10px 14px;
      }
    }
  </style>
</head>
<body>
  <!-- ======================================================================== -->
  <!-- 1. Felső Navigációs Sáv (Navbar)                                          -->
  <!-- ======================================================================== -->
  <header class="platform-header">
    <a href="/" class="brand">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/>
      </svg>
      Bánk's <span>Repository</span>
    </a>

    <!-- Középső menüpontok (Desktop) -->
    <% 
      nav_apps = (admin? rescue false) ? AppDefinition.order(:name) : AppDefinition.available_to_users.order(:name)
    %>
    <div class="nav-center">
      <a href="/" class="nav-link <%= 'active' if request.path == '/' %>">Műszerfal</a>
      <% nav_apps.each do |app| %>
        <a href="<%= app.mount_path %>" class="nav-link <%= 'active' if request.path.start_with?(app.mount_path) %>">
          <%= app.name %>
          <% if (admin? rescue false) && !app.state_active? %>
            <span style="font-size: 0.72rem; color: var(--warning);">(<%= app.state.upcase %>)</span>
          <% end %>
        </a>
      <% end %>
      <a href="/test" class="nav-link <%= 'active' if request.path == '/test' %>">Teszt Konzol</a>
    </div>

    <!-- Jobb oldali állapot-vezérelt menü (Desktop) -->
    <div class="user-nav">
      <% if logged_in? %>
        <!-- ADMINISZTRÁTOR ÁLLAPOT: Kiemelt Admin Pult elérés -->
        <% if admin? %>
          <%= link_to app_admin_root_path, class: "btn btn-admin" do %>
            <span>🛡️</span>
            <span>Adminisztráció</span>
          <% end %>
        <% end %>

        <!-- NORMÁL BEJELENTKEZETT TAG ÁLLAPOT -->
        <a href="<%= app_my_profile_path %>" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; padding: 4px 8px; border-radius: 6px; transition: background 0.15s;" onmouseover="this.style.background='var(--bg-elevated)'" onmouseout="this.style.background='transparent'">
          <span style="width: 28px; height: 28px; border-radius: 50%; background: <%= (current_user.custom_avatar_color rescue '#38bdf8') %>; color: #0a0f1d; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.78rem;">
            <%= current_user.avatar_initials rescue 'U' %>
          </span>
          <span style="color: var(--text-muted);">
            Tag: <strong style="color: var(--text-main);"><%= current_user.effective_name rescue current_user.username %></strong>
          </span>
        </a>
        <%= link_to "Kijelentkezés", app_logout_path, class: "btn btn-secondary", method: :delete %>
      <% else %>
        <!-- KIJELENTKEZETT VENDÉG ÁLLAPOT -->
        <%= link_to "Bejelentkezés", app_login_path, class: "btn btn-secondary" %>
        <%= link_to "Regisztráció", app_register_path, class: "btn btn-primary" %>
      <% end %>
    </div>

    <!-- Mobil Hamburger Menü Gomb -->
    <button type="button" class="mobile-nav-toggle" id="btn-open-drawer" aria-label="Menü megnyitása">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </header>

  <!-- Mobil Drawer és Backdrop -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <a href="/" class="brand" style="font-size: 1.1rem;">
        Bánk's <span>Repository</span>
      </a>
      <button type="button" class="drawer-close-btn" id="btn-close-drawer" aria-label="Menü bezárása">&times;</button>
    </div>
    
    <div class="drawer-content">
      <div>
        <div class="drawer-section-title">Navigáció & Modulok</div>
        <ul class="drawer-nav-list">
          <li>
            <a href="/" class="<%= 'active' if request.path == '/' %>">
              <span>🏠</span>
              <span>Műszerfal</span>
            </a>
          </li>
          <% nav_apps.each do |app| %>
            <% 
              app_icon = case app.slug
                         when "chess" then "♟️"
                         when "casino" then "🎰"
                         when "test" then "🛠️"
                         else "📦"
                         end
            %>
            <li>
              <a href="<%= app.mount_path %>" class="<%= 'active' if request.path.start_with?(app.mount_path) %>">
                <span><%= app_icon %></span>
                <span><%= app.name %></span>
                <% if app.state_active? %>
                  <span class="badge badge-live">Live</span>
                <% elsif (admin? rescue false) %>
                  <span class="badge badge-soon" style="color: var(--warning); border: 1px solid var(--warning);"><%= app.state.capitalize %></span>
                <% end %>
              </a>
            </li>
          <% end %>
          <li>
            <a href="/test" class="<%= 'active' if request.path == '/test' %>">
              <span>🛠️</span>
              <span>Teszt Konzol</span>
              <span class="badge badge-live">Socket</span>
            </a>
          </li>
          <% if admin? %>
            <li>
              <a href="/bank-admin" style="border-color: rgba(168, 85, 247, 0.4); color: var(--admin-accent);">
                <span>🛡️</span>
                <span>Admin Központ</span>
                <span class="badge badge-admin">Admin</span>
              </a>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Felhasználói Fiók és Műveletek a Drawer alján -->
      <div class="drawer-user-box">
        <div class="drawer-section-title">Fiók & Hitelesítés</div>
        <% if logged_in? %>
          <div style="font-size: 0.9rem; color: var(--text-muted); padding: 4px 0;">
            Bejelentkezve mint: <strong style="color: var(--accent);"><%= current_user.username %></strong>
          </div>
          <%= link_to app_my_profile_path, class: "btn btn-secondary", style: "width: 100%;" do %>
            <span>👤 Saját Profilom</span>
          <% end %>
          <% if admin? %>
            <%= link_to app_admin_root_path, class: "btn btn-admin", style: "width: 100%;" do %>
              <span>🛡️ Adminisztráció</span>
            <% end %>
          <% end %>
          <%= link_to "Kijelentkezés", app_logout_path, class: "btn btn-secondary", style: "width: 100%;", method: :delete %>
        <% else %>
          <%= link_to "Bejelentkezés", app_login_path, class: "btn btn-secondary", style: "width: 100%;" %>
          <%= link_to "Regisztráció", app_register_path, class: "btn btn-primary", style: "width: 100%;" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Flash Értesítések -->
  <div class="flash-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
  </div>

  <!-- Fő Elrendezés: Oldalsáv + Színpad -->
  <div class="app-container">
    <aside>
      <div class="sidebar-card">
        <div class="sidebar-title">Alkalmazások & Eszközök</div>
        <ul class="nav-list">
          <li class="nav-item <%= 'active' if request.path == '/' %>">
            <a href="/">
              <span>🏠 Irányítópult</span>
            </a>
          </li>
          <% if logged_in? %>
            <li class="nav-item <%= 'active' if request.path.start_with?('/profile') %>">
              <a href="<%= app_my_profile_path %>">
                <span>👤 Profilom</span>
              </a>
            </li>
          <% end %>
          <% nav_apps.each do |app| %>
            <% 
              app_icon = case app.slug
                         when "chess" then "♟️"
                         when "casino" then "🎰"
                         when "test" then "🛠️"
                         else "📦"
                         end
            %>
            <li class="nav-item <%= 'active' if request.path.start_with?(app.mount_path) %>">
              <a href="<%= app.mount_path %>">
                <span><%= app_icon %> <%= app.name %></span>
                <% if app.state_active? %>
                  <span class="badge badge-live">Live</span>
                <% elsif (admin? rescue false) %>
                  <span class="badge badge-soon" style="color: var(--warning); border: 1px solid var(--warning);"><%= app.state.capitalize %></span>
                <% end %>
              </a>
            </li>
          <% end %>
          <li class="nav-item <%= 'active' if request.path == '/test' %>">
            <a href="/test">
              <span>🛠️ Teszt Konzol</span>
              <span class="badge badge-live">Socket</span>
            </a>
          </li>
          <% if admin? %>
            <div style="border-top: 1px solid var(--border-subtle); margin: 8px 0;"></div>
            <div class="sidebar-title" style="color: var(--admin-accent);">Rendszergazda</div>
            <li class="nav-item">
              <a href="/bank-admin" style="color: var(--admin-accent);">
                <span>🛡️ Admin Központ</span>
                <span class="badge badge-admin">Admin</span>
              </a>
            </li>
          <% end %>
        </ul>
      </div>
    </aside>

    <main>
      <%= yield %>
    </main>
  </div>

  <!-- Mobile Drawer Script -->
  <script>
    (function() {
      const openBtn = document.getElementById('btn-open-drawer');
      const closeBtn = document.getElementById('btn-close-drawer');
      const drawer = document.getElementById('mobile-drawer');
      const backdrop = document.getElementById('drawer-backdrop');

      function openDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.add('open');
        backdrop.classList.add('open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        drawer.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      if (openBtn) openBtn.addEventListener('click', openDrawer);
      if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
      if (backdrop) backdrop.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && drawer && drawer.classList.contains('open')) {
          closeDrawer();
        }
      });
    })();
  </script>

  <!-- Globális Chat Lebegő Rendszer -->
  <%= render "shared/global_chat" %>
</body>
</html>
