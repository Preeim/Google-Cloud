<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Adminisztráció | Bánk's Repository</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    :root {
      --bg-canvas: #0a0f1d;
      --bg-surface: #11192e;
      --bg-elevated: #1a243b;
      --border-subtle: #23304d;
      --border-hover: #3b4b73;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent-blue: #38bdf8;
      --admin-accent: #a855f7;
      --admin-accent-hover: #9333ea;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #f43f5e;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif; }
    body { background-color: var(--bg-canvas); color: var(--text-main); min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; width: 100%; }
    
    header.admin-header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .admin-brand { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 1.15rem; color: var(--text-main); text-decoration: none; }
    .admin-badge { background: rgba(168, 85, 247, 0.2); border: 1px solid var(--admin-accent); color: var(--admin-accent); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.05em; }
    
    .admin-nav { display: flex; align-items: center; gap: 20px; }
    .admin-nav a { color: var(--text-muted); text-decoration: none; font-size: 0.95rem; font-weight: 500; transition: color 0.15s; }
    .admin-nav a:hover, .admin-nav a.active { color: var(--admin-accent); }
    .admin-nav .back-link { color: var(--accent-blue); padding: 6px 14px; border: 1px solid var(--border-subtle); border-radius: 6px; }
    .admin-nav .back-link:hover { border-color: var(--accent-blue); }

    .flash-container { max-width: 1300px; margin: 16px auto 0; padding: 0 20px; width: 100%; }
    .flash-notice { background: rgba(16, 185, 129, 0.15); border: 1px solid var(--success); color: #34d399; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; }
    .flash-alert { background: rgba(244, 63, 94, 0.15); border: 1px solid var(--danger); color: #fb7185; padding: 12px 18px; border-radius: 8px; margin-bottom: 12px; }

    .admin-container { max-width: 1300px; margin: 24px auto; width: 100%; padding: 0 20px; flex: 1; }
    .card { background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
    
    .btn { padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: inline-block; cursor: pointer; border: none; font-size: 0.88rem; transition: all 0.2s; }
    .btn-admin { background: var(--admin-accent); color: white; }
    .btn-admin:hover { background: var(--admin-accent-hover); }
    .btn-secondary { background: var(--bg-elevated); color: var(--text-main); border: 1px solid var(--border-subtle); }
    .btn-secondary:hover { border-color: var(--border-hover); }
    .btn-danger { background: rgba(244, 63, 94, 0.2); border: 1px solid var(--danger); color: #fb7185; }
    .btn-danger:hover { background: var(--danger); color: white; }
    .btn-success { background: rgba(16, 185, 129, 0.2); border: 1px solid var(--success); color: #34d399; }
    .btn-success:hover { background: var(--success); color: white; }

    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th { text-align: left; padding: 12px 16px; background: var(--bg-elevated); color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border-subtle); }
    td { padding: 14px 16px; border-bottom: 1px solid var(--border-subtle); font-size: 0.92rem; color: var(--text-main); vertical-align: middle; }
    tr:hover td { background: rgba(255, 255, 255, 0.02); }

    .tag { display: inline-block; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600; }
    .tag-admin { background: rgba(168, 85, 247, 0.2); color: var(--admin-accent); border: 1px solid var(--admin-accent); }
    .tag-active { background: rgba(16, 185, 129, 0.2); color: var(--success); border: 1px solid var(--success); }
    .tag-locked { background: rgba(244, 63, 94, 0.2); color: var(--danger); border: 1px solid var(--danger); }
    .tag-user { background: rgba(148, 163, 184, 0.2); color: var(--text-muted); border: 1px solid var(--border-subtle); }

    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 500; }
    .form-control { width: 100%; background: var(--bg-elevated); border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; color: var(--text-main); font-size: 0.95rem; }
    .form-control:focus { outline: none; border-color: var(--admin-accent); }

    /* Mobil Reszponzivitás & Kártyás Táblázatok */
    @media (max-width: 768px) {
      header.admin-header {
        padding: 10px 14px;
        flex-direction: column;
        align-items: stretch;
        gap: 10px;
      }
      .admin-nav {
        overflow-x: auto;
        white-space: nowrap;
        gap: 12px;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
      }
      .admin-nav a {
        font-size: 0.88rem;
        padding: 4px 8px;
        background: var(--bg-elevated);
        border-radius: 6px;
        border: 1px solid var(--border-subtle);
      }
      .admin-container {
        padding: 0 12px;
        margin: 14px auto;
      }
      .card {
        padding: 16px;
        border-radius: 10px;
        margin-bottom: 16px;
      }
      .btn {
        padding: 8px 12px;
      }

      /* Stacked Cards for Tables with Two-column auto-wrap */
      table.responsive-table, 
      table.responsive-table thead, 
      table.responsive-table tbody, 
      table.responsive-table th, 
      table.responsive-table td, 
      table.responsive-table tr {
        display: block;
      }
      table.responsive-table thead tr {
        position: absolute;
        top: -9999px;
        left: -9999px;
      }
      table.responsive-table tr {
        background: var(--bg-canvas);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        margin-bottom: 14px;
        padding: 8px 14px;
        overflow: hidden;
      }
      table.responsive-table td {
        border: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 9px 0;
        min-height: 38px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
      }
      table.responsive-table td:last-child {
        border-bottom: none;
        padding-top: 10px;
      }
      table.responsive-table td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.76rem;
        text-transform: uppercase;
        flex-shrink: 0;
        max-width: 40%;
        text-align: left;
        white-space: normal;
        word-break: break-word;
        letter-spacing: 0.03em;
      }
      table.responsive-table td > * {
        word-break: break-word;
        overflow-wrap: anywhere;
        min-width: 0;
        text-align: right;
      }
    }
  </style>
</head>
<body>
  <header class="admin-header">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
      <a href="/bank-admin" class="admin-brand">
        🛡️ Bánk's Repository
      </a>
      <span class="admin-badge">Admin</span>
    </div>
    <nav class="admin-nav">
      <a href="/bank-admin" class="<%= 'active' if request.path == '/bank-admin' %>">Irányítópult</a>
      <a href="/bank-admin/users" class="<%= 'active' if request.path.start_with?('/bank-admin/users') %>">Felhasználók</a>
      <a href="/bank-admin/apps" class="<%= 'active' if request.path.start_with?('/bank-admin/apps') %>">Modulok</a>
      <a href="/bank-admin/audit_logs" class="<%= 'active' if request.path.start_with?('/bank-admin/audit_logs') %>">Audit Napló</a>
      <a href="/" class="back-link">← Főoldal</a>
    </nav>
  </header>

  <div class="flash-container">
    <% if notice %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
  </div>

  <main class="admin-container">
    <%= yield %>
  </main>
</body>
</html>

