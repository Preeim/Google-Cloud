<style>
  .dashboard-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; }
  .card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 22px; }
  .card-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--card-border); padding-bottom: 10px; }
  .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.95rem; }
  .stat-label { color: var(--text-muted); }
  .stat-value { font-weight: 600; }
  
  .status-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
  .status-pill.online { background: rgba(16, 185, 129, 0.2); color: #34d399; }
  .status-pill.offline { background: rgba(239, 68, 68, 0.2); color: #f87171; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }

  /* WebSocket Chat & Ping Box */
  .event-feed { background: #0b1120; border: 1px solid var(--card-border); border-radius: 8px; height: 180px; overflow-y: auto; padding: 12px; font-family: monospace; font-size: 0.88rem; display: flex; flex-direction: column; gap: 6px; }
  .event-entry { color: #e2e8f0; }
  .event-entry .time { color: var(--text-muted); font-size: 0.78rem; }
  .event-entry .sender { color: var(--accent); font-weight: 600; }
  
  .control-group { display: flex; gap: 10px; margin-top: 14px; }
  .input-text { flex: 1; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 9px 12px; color: white; font-size: 0.9rem; outline: none; }
  .input-text:focus { border-color: var(--accent); }
  
  /* Users Table */
  table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9rem; }
  th { text-align: left; color: var(--text-muted); padding: 8px 6px; border-bottom: 1px solid var(--card-border); font-size: 0.8rem; text-transform: uppercase; }
  td { padding: 8px 6px; border-bottom: 1px solid rgba(255,255,255,0.05); }
</style>

<div style="margin-bottom: 24px;">
  <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 6px;">System Diagnostics & Testing Console</h1>
  <p style="color: var(--text-muted);">Real-time verification of MySQL Database, Action Cable WebSockets, and Server Environment.</p>
</div>

<div class="dashboard-grid">
  <!-- Card 1: MySQL Database Diagnostics -->
  <div class="card">
    <div class="card-title">
      <span>🗄️ MySQL Database</span>
      <% if @db_connected %>
        <span class="status-pill online"><span class="pulse-dot"></span> Online (<%= @db_latency_ms %> ms)</span>
      <% else %>
        <span class="status-pill offline"><span class="pulse-dot"></span> Offline</span>
      <% end %>
    </div>
    
    <% if @db_connected %>
      <div class="stat-row">
        <span class="stat-label">Database Name</span>
        <span class="stat-value"><%= @db_name %></span>
      </div>
      <div class="stat-row">
        <span class="stat-label">MySQL Version</span>
        <span class="stat-value"><%= @db_version %></span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Total Users in DB</span>
        <span class="stat-value"><%= @users_count %></span>
      </div>
      
      <div style="margin-top: 16px;">
        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">Recent Registered Users</div>
        <% if @recent_users.any? %>
          <table>
            <thead>
              <tr><th>Username</th><th>Email</th><th>Created</th></tr>
            </thead>
            <tbody>
              <% @recent_users.each do |u| %>
                <tr>
                  <td><strong><%= u.username %></strong></td>
                  <td><%= u.email %></td>
                  <td style="color: var(--text-muted);"><%= u.created_at.strftime("%b %d, %H:%M") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p style="color: var(--text-muted); font-size: 0.9rem; font-style: italic;">No users registered yet. Click "Register" to create one!</p>
        <% end %>
      </div>
    <% else %>
      <div style="background: rgba(239, 68, 68, 0.2); border: 1px solid var(--danger); padding: 12px; border-radius: 8px; color: #f87171; font-size: 0.9rem;">
        <strong>Error connecting to MySQL:</strong><br>
        <%= @db_error %>
      </div>
    <% end %>
  </div>

  <!-- Card 2: Action Cable WebSocket Live Test -->
  <div class="card">
    <div class="card-title">
      <span>⚡ WebSocket (Action Cable)</span>
      <span id="ws-status-badge" class="status-pill offline"><span class="pulse-dot"></span> Connecting...</span>
    </div>

    <div class="stat-row">
      <span class="stat-label">Connection Status</span>
      <span id="ws-status-text" class="stat-value" style="color: var(--warning);">Connecting...</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Round-trip Ping (Latency)</span>
      <span id="ws-ping-result" class="stat-value" style="color: var(--accent);">-- ms</span>
    </div>

    <div style="margin-top: 14px;">
      <button id="btn-ping" class="btn btn-secondary" style="width: 100%; margin-bottom: 14px;">
        🚀 Measure Real-Time Ping
      </button>

      <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px;">Live Broadcast Stream (Open 2 tabs to test!)</div>
      <div id="event-feed" class="event-feed">
        <div class="event-entry"><span class="time">[System]</span> Initializing Action Cable listener...</div>
      </div>

      <div class="control-group">
        <input type="text" id="ws-input-message" class="input-text" placeholder="Type a message to broadcast...">
        <button id="btn-send-message" class="btn btn-primary">Send</button>
      </div>
    </div>
  </div>

  <!-- Card 3: Server Environment Diagnostics -->
  <div class="card">
    <div class="card-title">
      <span>☁️ Server & Environment</span>
      <span class="status-pill online"><span class="pulse-dot"></span> Active</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Host Machine</span>
      <span class="stat-value"><%= @hostname %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Ruby Version</span>
      <span class="stat-value"><%= @ruby_version %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Rails Version</span>
      <span class="stat-value"><%= @rails_version %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Web Server</span>
      <span class="stat-value">Puma (Production Mode)</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Server Local Time</span>
      <span class="stat-value"><%= @server_time %></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">WebSocket Adapter</span>
      <span class="stat-value">Action Cable (Async)</span>
    </div>
  </div>
</div>

<!-- Simple Native WebSocket Client Script for Action Cable -->
<script>
  (function() {
    const wsProtocol = window.location.protocol === "https:" ? "wss://" : "ws://";
    const cableUrl = wsProtocol + window.location.host + "/cable";
    
    const statusBadge = document.getElementById("ws-status-badge");
    const statusText = document.getElementById("ws-status-text");
    const pingResult = document.getElementById("ws-ping-result");
    const eventFeed = document.getElementById("event-feed");
    const inputMessage = document.getElementById("ws-input-message");
    const btnSend = document.getElementById("btn-send-message");
    const btnPing = document.getElementById("btn-ping");

    let socket = null;
    let pingStartTime = null;

    function addLog(sender, text, isSystem = false) {
      const entry = document.createElement("div");
      entry.className = "event-entry";
      const now = new Date().toLocaleTimeString();
      if (isSystem) {
        entry.innerHTML = `<span class="time">[${now}]</span> <span style="color: #94a3b8;">${text}</span>`;
      } else {
        entry.innerHTML = `<span class="time">[${now}]</span> <span class="sender">${sender}:</span> ${text}`;
      }
      eventFeed.appendChild(entry);
      eventFeed.scrollTop = eventFeed.scrollHeight;
    }

    function connectCable() {
      try {
        socket = new WebSocket(cableUrl);

        socket.onopen = function() {
          // Subscribe to TestChannel
          const subscribeMsg = JSON.stringify({
            command: "subscribe",
            identifier: JSON.stringify({ channel: "TestChannel" })
          });
          socket.send(subscribeMsg);
        };

        socket.onmessage = function(event) {
          const data = JSON.parse(event.data);
          
          if (data.type === "welcome") {
            // Cable connected
          } else if (data.type === "confirm_subscription") {
            statusBadge.className = "status-pill online";
            statusBadge.innerHTML = '<span class="pulse-dot"></span> Connected';
            statusText.innerText = "Connected & Subscribed";
            statusText.style.color = "#34d399";
            addLog("System", "Connected to TestChannel via WebSocket.", true);
          } else if (data.type === "ping") {
            // Heartbeat
          } else if (data.message) {
            const msg = data.message;
            if (msg.action === "pong") {
              const latency = Math.round(performance.now() - pingStartTime);
              pingResult.innerText = latency + " ms (Round-Trip)";
              addLog("System", `Pong received! Latency: ${latency} ms`, true);
            } else if (msg.action === "new_message") {
              addLog(msg.sender, msg.message);
            }
          }
        };

        socket.onclose = function() {
          statusBadge.className = "status-pill offline";
          statusBadge.innerHTML = '<span class="pulse-dot"></span> Disconnected';
          statusText.innerText = "Disconnected";
          statusText.style.color = "#f87171";
          addLog("System", "WebSocket connection closed. Reconnecting in 3s...", true);
          setTimeout(connectCable, 3000);
        };

        socket.onerror = function() {
          statusBadge.className = "status-pill offline";
          statusBadge.innerHTML = '<span class="pulse-dot"></span> Error';
          statusText.innerText = "Connection Error";
          statusText.style.color = "#f87171";
        };
      } catch (err) {
        console.error(err);
      }
    }

    btnPing.addEventListener("click", function() {
      if (!socket || socket.readyState !== WebSocket.OPEN) return;
      pingStartTime = performance.now();
      const payload = JSON.stringify({
        command: "message",
        identifier: JSON.stringify({ channel: "TestChannel" }),
        data: JSON.stringify({ action: "ping", client_time: Date.now() })
      });
      socket.send(payload);
    });

    function sendMessage() {
      const text = inputMessage.value.trim();
      if (!text || !socket || socket.readyState !== WebSocket.OPEN) return;
      
      const payload = JSON.stringify({
        command: "message",
        identifier: JSON.stringify({ channel: "TestChannel" }),
        data: JSON.stringify({ action: "speak", message: text })
      });
      socket.send(payload);
      inputMessage.value = "";
    }

    btnSend.addEventListener("click", sendMessage);
    inputMessage.addEventListener("keypress", function(e) {
      if (e.key === "Enter") sendMessage();
    });

    connectCable();
  })();
</script>

