<div style="max-width: 440px; margin: 40px auto; background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 28px;">
  <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 8px;">Sign In to App Hub</h2>
  <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 24px;">Enter your credentials to access your account.</p>

  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div style="margin-bottom: 16px;">
      <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; color: var(--text-main);">Username or Email</label>
      <%= f.text_field :login, required: true, autofocus: true, placeholder: "e.g. h_gaborbank", style: "width: 100%; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 10px 14px; color: white; font-size: 0.95rem;" %>
    </div>

    <div style="margin-bottom: 22px;">
      <label style="display: block; font-size: 0.9rem; font-weight: 600; margin-bottom: 6px; color: var(--text-main);">Password</label>
      <%= f.password_field :password, required: true, placeholder: "••••••••", style: "width: 100%; background: #0b1120; border: 1px solid var(--card-border); border-radius: 6px; padding: 10px 14px; color: white; font-size: 0.95rem;" %>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1rem;">Sign In</button>
  <% end %>

  <div style="margin-top: 20px; text-align: center; font-size: 0.9rem; color: var(--text-muted);">
    Don't have an account yet? <%= link_to "Register here", register_path, style: "color: var(--accent); font-weight: 600; text-decoration: none;" %>
  </div>
</div>
