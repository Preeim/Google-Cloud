<div style="max-width: 420px; margin: 30px auto; width: 100%; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: clamp(20px, 5vw, 30px);">
  <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 6px; letter-spacing: -0.02em; color: var(--text-main);">Bejelentkezés</h2>
  <p style="color: var(--text-muted); font-size: 0.88rem; margin-bottom: 22px; line-height: 1.5;">Add meg az azonosító adataidat a fiókod eléréséhez.</p>

  <%= form_with url: login_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <label>Felhasználónév vagy E-mail</label>
      <%= f.text_field :login, required: true, autofocus: true, autocapitalize: "none", autocomplete: "username", placeholder: "pl. h_gaborbank vagy bank@bankrepo.hu", class: "form-control" %>
    </div>

    <div class="form-group" style="margin-bottom: 22px;">
      <label>Jelszó</label>
      <%= f.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", class: "form-control font-mono" %>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px; font-size: 0.92rem;">Bejelentkezés a Fiókba</button>
  <% end %>

  <div style="margin-top: 20px; text-align: center; font-size: 0.86rem; color: var(--text-muted);">
    Még nincs fiókod? <%= link_to "Regisztrálj itt", register_path, style: "color: var(--accent); font-weight: 600; text-decoration: none;" %>
  </div>
</div>
